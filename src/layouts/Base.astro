---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  // Describes ogImage for screen readers and crawlers.
  ogImageAlt?: string;
  // Pixel size of ogImage, when known — lets platforms lay out the card
  // before fetching the image.
  ogImageSize?: [number, number];
  // The page's one true URL (e.g. a subdomain that rewrites to this page).
  canonical?: string;
  themeColor?: string;
}

const { title, description, ogImage, ogImageAlt, ogImageSize, canonical, themeColor = '#000000' } = Astro.props;
// OG/Twitter image — must be an absolute URL per spec. Crawlers
// reject relative paths. We accept either a relative path
// ("/images/blog/foo.webp") or an already-absolute URL from the
// caller, then normalize. Falls back to the site-wide /unfurl.png
// when the page doesn't supply one.
const SITE_ORIGIN = 'https://vhsgarage.com';
const normalizeOgImage = (src) => {
  if (!src) return `${SITE_ORIGIN}/unfurl.png`;
  if (/^https?:\/\//i.test(src)) return src;
  return SITE_ORIGIN + (src.startsWith('/') ? src : '/' + src);
};
const ogImageUrl = normalizeOgImage(ogImage);
// Titles that already lead with the brand (e.g. "VHS Garage Originals")
// skip the " — VHS Garage" suffix.
const fullTitle = title === 'VHS Garage'
  ? 'VHS Garage — A Lo-Fi Love Letter to the Golden Age of Video'
  : title.startsWith('VHS Garage') ? title : `${title} — VHS Garage`;

// Per-page manifest so PWA installs open the page the user installed from.
// `id` is fixed so all installs resolve to the same app identity.
const manifest = {
  name: 'VHS Garage',
  short_name: 'VHS Garage',
  description: 'A lo-fi love letter to the golden age of video.',
  id: '/',
  scope: '/',
  start_url: Astro.url.pathname,
  display: 'standalone',
  background_color: '#000000',
  theme_color: '#000000',
  icons: [
    { src: 'https://vhsgarage.com/favicon.png', sizes: 'any', type: 'image/png' },
  ],
};
const manifestHref = `data:application/manifest+json;base64,${Buffer.from(JSON.stringify(manifest)).toString('base64')}`;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  <meta name="theme-color" content={themeColor}>
  {canonical && <link rel="canonical" href={canonical}>}

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="VHS Garage">
  <meta property="og:locale" content="en_US">
  <meta property="og:title" content={fullTitle}>
  <meta property="og:description" content={description}>
  {canonical && <meta property="og:url" content={canonical}>}
  <meta property="og:image" content={ogImageUrl}>
  {ogImageSize && <meta property="og:image:width" content={String(ogImageSize[0])}>}
  {ogImageSize && <meta property="og:image:height" content={String(ogImageSize[1])}>}
  {ogImageAlt && <meta property="og:image:alt" content={ogImageAlt}>}

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={fullTitle}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImageUrl}>
  {ogImageAlt && <meta name="twitter:image:alt" content={ogImageAlt}>}

  <link rel="icon" type="image/png" href="https://vhsgarage.com/favicon.png">
  <link rel="apple-touch-icon" href="https://vhsgarage.com/favicon.png">
  <link rel="manifest" href={manifestHref}>

  <slot name="head" />
</head>
<body class="bg-black text-white">
  <slot />
</body>
</html>
