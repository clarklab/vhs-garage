---
import Base from '../../layouts/Base.astro';
import { BUILD_ID } from '../../utils/build-id.js';

// Admin-only page for managing the YouTube upload bridge.
//
// HOW TO USE
//   1. Sign into /capture as the Brand Account Primary Owner. At the
//      Google "Choose an account" screen, pick VHS Garage as the
//      brand. Confirm in the publish panel that you see "Logged in as
//      @vhsgaragevideo" (or whatever the brand handle is).
//   2. Come to this page (/admin/connect-youtube). It reads the
//      refresh token from your browser's localStorage (where the
//      sign-in flow stashed it) and shows a button to save it as the
//      bridge token.
//   3. Click "Save as bridge token". Server stashes it in Netlify
//      Blobs. Whitelisted users can now upload to VHS Garage via the
//      bridge.
//
// WHO CAN SAVE
//   The save action requires the caller's verified Google email to
//   appear in the YOUTUBE_BRIDGE_ADMIN_EMAILS env var. Anyone signed
//   into the app can VISIT this page, but only listed admins can
//   actually persist the token.
//
// NOTES ON TOKEN LIFETIME
//   While the OAuth app is in testing mode, refresh tokens expire
//   after 7 days. Re-run this flow weekly until verification clears.
//   After verification, refresh tokens persist indefinitely.
---

<Base
  title="Admin · Connect YouTube"
  description="Save a YouTube refresh token to power the upload bridge."
>
  <main class="min-h-svh bg-black text-white antialiased px-6 py-12 max-w-2xl mx-auto" style="font-family: 'VCR', monospace;">
    <a href="/" class="text-white/30 text-xs hover:text-white/60 transition-colors">← vhsgarage.com</a>

    <h1 class="text-3xl mt-8 mb-2">Connect YouTube</h1>
    <p class="text-white/50 text-xs uppercase tracking-widest mb-8">Admin · Bridge token</p>

    <!-- Status panel — populated by JS once the page loads. Different
         visual treatments per state (no-token / valid / error / not-admin) -->
    <div id="bridge-status" class="border border-white/15 p-5 mb-6">
      <p class="text-white/40 text-xs">Checking…</p>
    </div>

    <!-- The "save the token in your localStorage as the bridge token" panel.
         Hidden by default; only revealed when (a) a refresh token is in
         localStorage AND (b) the caller is an admin. -->
    <div id="bridge-save-panel" class="hidden border border-white/15 p-5 mb-6">
      <h2 class="text-lg mb-2">Save your current token</h2>
      <p class="text-white/60 text-sm mb-4 leading-7">
        We detected a YouTube refresh token in your browser. Click below to save
        it as the bridge token. Make sure you're signed in as the VHS Garage
        brand owner — every bridged upload from any allowed user will go to
        whatever channel this token represents.
      </p>
      <p id="bridge-save-channel" class="text-white/40 text-xs uppercase tracking-widest mb-4"></p>
      <button id="bridge-save-btn" type="button"
              class="px-4 py-2 bg-[#dc2626] hover:bg-[#ef4444] text-white text-sm uppercase tracking-wider transition-colors">
        Save as bridge token
      </button>
    </div>

    <!-- Sign-in prompt — shown when no refresh token is in localStorage -->
    <div id="bridge-signin-prompt" class="hidden border border-white/15 p-5 mb-6">
      <h2 class="text-lg mb-2">Sign in first</h2>
      <p class="text-white/60 text-sm mb-4 leading-7">
        We don't see a YouTube refresh token in your browser yet. Go to
        <a href="/capture" class="text-[#dc2626] hover:underline">/capture</a>,
        sign into YouTube as the VHS Garage brand owner (you'll need to pick
        VHS Garage at the brand-account chooser), then come back here.
      </p>
      <a href="/capture" class="inline-block px-4 py-2 border border-white/30 text-white text-sm uppercase tracking-wider hover:border-white hover:bg-white/5 transition-colors">
        Open the recorder →
      </a>
    </div>

    <!-- Clear-token panel — admin can drop the bridge token if needed -->
    <div id="bridge-clear-panel" class="hidden border border-white/10 p-5">
      <h2 class="text-sm mb-2 text-white/60 uppercase tracking-widest">Danger zone</h2>
      <p class="text-white/40 text-xs mb-4 leading-6">
        Deletes the stored bridge token. Whitelisted users will fall back to
        uploading to their own channel until you reconnect.
      </p>
      <button id="bridge-clear-btn" type="button"
              class="px-3 py-1.5 border border-red-500/40 text-red-400 hover:bg-red-500/10 text-xs uppercase tracking-wider transition-colors">
        Clear bridge token
      </button>
    </div>
  </main>

  <script type="module" src={`/scripts/admin-connect-youtube.js?v=${BUILD_ID}`}></script>
</Base>
