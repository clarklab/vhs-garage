import Base from '../layouts/Base.astro';
import { BUILD_ID } from '../utils/build-id.js';
// The chart bookmarklets copy exactly as many rows as a Year Snapshot list
// holds, so the cap in the browser and the cap in the app can't disagree.
import { YEAR_LIST_SIZE } from '../../public/scripts/tik/project.js';

// Bookmarklet #2: on an IMDb ADVANCED SEARCH results page (the rating-sorted,
// vote-floored list the Year Snapshot pane links to), copies the ranked results
// as "1. Title (Year) | 9.3 | 3.1M votes" lines for pasting into that pane.
// IMDb has no free API and 403s server-side fetches, so reading the page the
// user is already looking at is the only way to get their real numbers.
// Selectors are tried newest-first with a text fallback, since a layout change
// on IMDb's side must degrade to "copy something useful", not "copy nothing".
const IMDB_LIST_BOOKMARKLET = 'javascript:' + encodeURIComponent(`(()=>{var rows=[].slice.call(document.querySelectorAll('li.ipc-metadata-list-summary-item, .lister-item, [data-testid="find-result-item"]'));if(!rows.length){alert('No results found - open an IMDb advanced search results page first.');return}var txt=function(e,s){var n=e.querySelector(s);return n?n.textContent.trim():''};var out=[];rows.forEach(function(r){var t=txt(r,'.ipc-title__text')||txt(r,'.lister-item-header a')||txt(r,'h3');t=t.replace(/^\\s*\\d+\\.\\s*/,'').trim();if(!t)return;var meta=[].slice.call(r.querySelectorAll('.dli-title-metadata-item, .lister-item-year, .title_metadata .certificate')).map(function(n){return n.textContent.trim()});var yr='';for(var j=0;j<meta.length;j++){var m=meta[j].match(/(19|20)\\d{2}/);if(m){yr=m[0];break}}var rt=txt(r,'.ipc-rating-star--rating')||txt(r,'.ratings-imdb-rating strong')||'';var vt=txt(r,'.ipc-rating-star--voteCount')||txt(r,'span[name=nv]')||'';if(!rt){var m2=r.innerText.match(/\\b(10(?:\\.0)?|[0-9]\\.[0-9])\\b/);if(m2)rt=m2[1]}vt=vt.replace(/[()\\s]/g,'');var line=(out.length+1)+'. '+t+(yr?' ('+yr+')':'');if(rt)line+=' | '+rt;if(vt)line+=' | '+vt+' votes';if(out.length>=${YEAR_LIST_SIZE})return;out.push(line)});if(!out.length){alert('Found rows but could not read titles - copy the page text by hand and paste it in, the parser handles that too.');return}navigator.clipboard.writeText(out.join('\\n')).then(function(){var b=document.createElement('div');b.textContent='Copied the top '+out.length+' titles - paste into VHS Studio';b.style.cssText='position:fixed;z-index:2147483647;left:50%;bottom:16px;transform:translateX(-50%);background:#111;color:#fff;padding:10px 16px;border-radius:999px;box-shadow:0 6px 24px rgba(0,0,0,.5);font:600 14px system-ui';document.body.appendChild(b);setTimeout(function(){b.remove()},2500)})})()`);

// Bookmarklet #3: on a Box Office Mojo yearly chart, copies the ranked releases
// as "1. Title | $968.5M worldwide" lines. Mojo's table is plain <table> markup,
// so this reads rows and picks the first money column (worldwide on the /world/
// chart, domestic on the plain year chart) — the label follows the URL.
const MOJO_BOOKMARKLET = 'javascript:' + encodeURIComponent(`(()=>{var rows=[].slice.call(document.querySelectorAll('table tr'));if(rows.length<2){alert('No chart found - open a Box Office Mojo yearly chart first.');return}var label=/\\/world\\//.test(location.pathname)?'worldwide':'domestic';var money=function(s){var m=String(s).replace(/,/g,'').match(/\\\$\\s*(\\d+(?:\\.\\d+)?)\\s*([KMB])?/i);if(!m)return null;var n=parseFloat(m[1]);if(!isFinite(n))return null;var u=m[2]?m[2].toLowerCase():'';return Math.round(n*(u==='b'?1e9:u==='m'?1e6:u==='k'?1e3:1))};var fmt=function(n){if(n>=1e9)return'$'+(n/1e9).toFixed(2).replace(/0$/,'')+'B';if(n>=1e8)return'$'+Math.round(n/1e6)+'M';if(n>=1e6)return'$'+(n/1e6).toFixed(1).replace(/\\.0$/,'')+'M';return'$'+n};var out=[];rows.forEach(function(r){var cells=[].slice.call(r.querySelectorAll('td'));if(cells.length<2)return;var link=r.querySelector('a');var t=(link?link.textContent:cells[1].textContent).trim();if(!t)return;var g=null;for(var i=0;i<cells.length;i++){var v=money(cells[i].textContent);if(v&&v>1000){g=v;break}}if(!g)return;if(out.length>=${YEAR_LIST_SIZE})return;out.push((out.length+1)+'. '+t+' | '+fmt(g)+' '+label)});if(!out.length){alert('Found a table but no releases with a gross - copy the page text by hand and paste it in, the parser handles that too.');return}navigator.clipboard.writeText(out.join('\\n')).then(function(){var b=document.createElement('div');b.textContent='Copied the top '+out.length+' releases - paste into VHS Studio';b.style.cssText='position:fixed;z-index:2147483647;left:50%;bottom:16px;transform:translateX(-50%);background:#111;color:#fff;padding:10px 16px;border-radius:999px;box-shadow:0 6px 24px rgba(0,0,0,.5);font:600 14px system-ui';document.body.appendChild(b);setTimeout(function(){b.remove()},2500)})})()`);

// Bookmarklet #1: on an IMDb trivia page, lets the user TAP the items they want,
// then copies just those to the clipboard for pasting into the starter box.
// Runs in the USER'S browser on a page they're viewing — no server-side scrape.
//
// Before the picker appears it does the two things that used to be manual work:
//   1. Expands the list. IMDb ships 5 items and hides the other few hundred
//      behind "50 more" / "See all" / "Spoilers", so it clicks every such button
//      until a round stops adding cards (which also no-ops on an already-expanded
//      page, and stops rather than looping on buttons that add nothing).
//   2. Sorts each list by NET helpful votes — thumbs up minus thumbs down, so an
//      item people argue about ranks below a quieter one everybody agrees on.
//      The best trivia ends up on top, which is the order worth reading down.
// The reorder swaps cards through placeholder comments instead of re-appending
// them, because IMDb interleaves a spacer div with every card; re-appending
// stacks all the spacers up top and leaves a gap where the list used to be.
// Sorting happens per parent list, so the spoiler sections stay separate blocks
// at the bottom instead of being mixed into the main trivia.
const IMDB_BOOKMARKLET = 'javascript:' + encodeURIComponent(`(()=>{var P=document.getElementById('tik-picker');if(P&&P._tik){P._tik();return}var CARD='[data-testid="item-id"]';var S='[data-testid="item-text"], .ipc-html-content-inner-div';var $$=function(s,r){return [].slice.call((r||document).querySelectorAll(s))};if(!$$(S).filter(function(e){return e.innerText.trim()}).length){alert('No trivia found - open a movie\\'s Trivia page on IMDb first.');return}var num=function(s){var m=String(s||'').replace(/,/g,'').match(/(\\d+(?:\\.\\d+)?)\\s*([KMB])?/i);if(!m)return 0;var n=parseFloat(m[1]);if(!isFinite(n))return 0;var u=m[2]?m[2].toLowerCase():'';return Math.round(n*(u==='b'?1e9:u==='m'?1e6:u==='k'?1e3:1))};var vote=function(c,s){var n=c.querySelector(s);return n?num(n.textContent):0};var score=function(c){return vote(c,'.ipc-voting__label__count--up')-vote(c,'.ipc-voting__label__count--down')};var root=function(){var c=document.querySelector(CARD);return (c&&(c.closest('.ipc-page-grid__item')||c.closest('main')))||document.body};var expand=function(done){var rounds=0,last=-1;var step=function(){var n=$$(CARD).length;var btns=$$('button.ipc-see-more__button',root()).filter(function(b){return b.offsetParent});if(!btns.length||n===last||rounds++>20){done();return}last=n;btns.forEach(function(b){try{b.click()}catch(e){}});setTimeout(step,400)};step()};var sortCards=function(){var groups=new Map(),total=0;$$(CARD).forEach(function(c){var p=c.parentNode;if(!p)return;if(!groups.has(p))groups.set(p,[]);groups.get(p).push(c)});groups.forEach(function(list){var slots=list.map(function(c){var p=c.parentNode,m=document.createComment('tik');p.insertBefore(m,c);p.removeChild(c);return m});list.sort(function(a,b){return score(b)-score(a)});slots.forEach(function(m,i){m.parentNode.replaceChild(list[i],m)});total+=list.length});return total};var picked=new Set(),seen=new Set(),items=[],idle='Tap the trivia you want';var mark=function(e,on){e.style.outline=on?'3px solid #22c55e':'';e.style.background=on?'rgba(34,197,94,.15)':'';e.style.cursor='pointer'};var bar=document.createElement('div');bar.id='tik-picker';bar.style.cssText='position:fixed;z-index:2147483647;left:50%;bottom:16px;transform:translateX(-50%);display:flex;gap:8px;align-items:center;background:#111;color:#fff;padding:10px 14px;border-radius:999px;box-shadow:0 6px 24px rgba(0,0,0,.5);font:600 14px system-ui';var cnt=document.createElement('span');cnt.textContent='Loading every trivia item...';var mk=function(t,bg,fg){var b=document.createElement('button');b.textContent=t;b.style.cssText='border:0;border-radius:999px;padding:6px 12px;font:600 13px system-ui;cursor:pointer;background:'+bg+';color:'+fg;return b};var all=mk('All','#333','#fff'),non=mk('None','#333','#fff'),cp=mk('Copy','#22c55e','#000');var upd=function(){cnt.textContent=picked.size?picked.size+' selected':idle};var tog=function(e){if(picked.has(e)){picked.delete(e);mark(e,false)}else{picked.add(e);mark(e,true)}upd()};var scan=function(){var n=sortCards();items=$$(S).filter(function(e){return e.innerText.trim()});items.forEach(function(e){if(seen.has(e))return;seen.add(e);mark(e,picked.has(e));e.addEventListener('click',function(ev){if(ev.target.closest('a,button,[role=button]'))return;ev.preventDefault();ev.stopPropagation();tog(e)},true)});idle=n?n+' trivia, most helpful first':'Tap the trivia you want';upd()};bar._tik=function(){expand(scan)};all.onclick=function(){items.forEach(function(e){picked.add(e);mark(e,true)});upd()};non.onclick=function(){items.forEach(function(e){picked.delete(e);mark(e,false)});upd()};cp.onclick=function(){if(!picked.size){alert('Tap the trivia items you want first.');return}var txt=items.filter(function(e){return picked.has(e)}).map(function(e){return e.innerText.trim()}).join('\\n\\n');navigator.clipboard.writeText(txt).then(function(){cp.textContent='Copied '+picked.size+'!';setTimeout(function(){cp.textContent='Copy'},1500)})};bar.append(cnt,all,non,cp);document.body.appendChild(bar);bar._tik()})()`);
---
<Base title="VHS Studio" description="VHS Garage's TikTok slideshow studio">
  <meta slot="head" name="robots" content="noindex" />
  <link slot="head" rel="preconnect" href="https://fonts.googleapis.com" />
  <link slot="head" rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link slot="head" rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" />
  <link slot="head" rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />

  <div id="studio" class="min-h-screen bg-neutral-950 text-neutral-100 antialiased">
    <!-- App bar -->
    <header class="sticky top-0 z-20 flex items-center gap-3 border-b border-neutral-800/80 bg-neutral-950/90 px-4 py-2.5 backdrop-blur">
      <img src="/images/vhs-garage-logo-square.png" alt="VHS Garage" class="h-6 w-6 rounded" />
      <h1 class="text-sm font-extrabold tracking-tight">VHS Studio</h1>
      <span class="hidden text-xs text-neutral-500 sm:inline">TikTok slideshow maker</span>
      <div class="ml-auto flex items-center gap-3">
        <span id="save-state" class="hidden items-center gap-1.5 text-xs text-neutral-400">
          <span id="save-dot" class="h-1.5 w-1.5 rounded-full bg-neutral-600"></span>
          <span id="save-label">Saved</span>
        </span>
        <span id="auth-status" class="text-xs text-neutral-500">not signed in</span>
        <button id="auth-btn" class="rounded-md border border-neutral-700 bg-neutral-900 px-3 py-1.5 text-xs font-semibold hover:bg-neutral-800">Sign in to TikTok</button>
      </div>
    </header>

    <!-- ============ HOME ============ -->
    <section id="screen-home" class="mx-auto w-full max-w-5xl px-4 py-8">
      <h2 class="text-xs font-semibold uppercase tracking-[0.2em] text-neutral-500">New TikTok</h2>
      <div class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        <button id="new-trivia" class="group relative overflow-hidden rounded-2xl border border-neutral-800 bg-neutral-900 p-5 text-left transition hover:border-amber-400/60">
          <div class="tape-lines pointer-events-none absolute inset-0 opacity-40"></div>
          <div class="relative">
            <span class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-amber-400/15 text-amber-300">
              <span class="material-symbols-outlined">movie</span>
            </span>
            <h3 class="mt-3 text-lg font-bold tracking-tight">Tape Trivia</h3>
            <p class="mt-1 text-sm text-neutral-400">Deep-cut trivia over frames grabbed straight from the movie file. The agent researches, you verify.</p>
            <p class="mt-3 text-xs font-semibold text-amber-300/90">Movie file + AI research <span aria-hidden="true">→</span></p>
          </div>
        </button>
        <button id="new-guys" class="group relative overflow-hidden rounded-2xl border border-neutral-800 bg-neutral-900 p-5 text-left transition hover:border-cyan-400/60">
          <div class="tape-lines pointer-events-none absolute inset-0 opacity-40"></div>
          <div class="relative">
            <span class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-cyan-400/15 text-cyan-300">
              <span class="material-symbols-outlined">theater_comedy</span>
            </span>
            <h3 class="mt-3 text-lg font-bold tracking-tight">Remembering Some Guys</h3>
            <p class="mt-1 text-sm text-neutral-400">One actor's most memorable cult roles. The agent lists and writes, you pick and bring the photos.</p>
            <p class="mt-3 text-xs font-semibold text-cyan-300/90">Actor + your images <span aria-hidden="true">→</span></p>
          </div>
        </button>
        <button id="new-year" class="group relative overflow-hidden rounded-2xl border border-neutral-800 bg-neutral-900 p-5 text-left transition hover:border-violet-400/60">
          <div class="tape-lines pointer-events-none absolute inset-0 opacity-40"></div>
          <div class="relative">
            <span class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-violet-400/15 text-violet-300">
              <span class="material-symbols-outlined">calendar_month</span>
            </span>
            <h3 class="mt-3 text-lg font-bold tracking-tight">Year Snapshot</h3>
            <p class="mt-1 text-sm text-neutral-400">How one year did: the top eight by IMDb rating and by box office. The agent researches, you bring the posters.</p>
            <p class="mt-3 text-xs font-semibold text-violet-300/90">A year + your images <span aria-hidden="true">→</span></p>
          </div>
        </button>
      </div>

      <!-- Batch mode is deliberately its own screen, not a change to the three
           formats above: those are shipping weekly and must keep working
           exactly as they do while this proves itself. -->
      <div class="mt-3">
        <button id="new-batch" class="group relative w-full overflow-hidden rounded-2xl border border-emerald-400/30 bg-neutral-900 p-5 text-left transition hover:border-emerald-400/70">
          <div class="tape-lines pointer-events-none absolute inset-0 opacity-40"></div>
          <div class="relative flex flex-wrap items-center gap-4">
            <span class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-emerald-400/15 text-emerald-300">
              <span class="material-symbols-outlined">bolt</span>
            </span>
            <div class="min-w-56 flex-1">
              <h3 class="text-lg font-bold tracking-tight">
                Batch mode
                <span class="ml-1.5 rounded bg-emerald-400/15 px-1.5 py-0.5 align-middle text-[10px] font-bold uppercase tracking-wider text-emerald-300">Beta</span>
              </h3>
              <p class="mt-1 text-sm text-neutral-400">Real IMDb trivia, ranked by helpful votes, ten movies at a time. Pick the films or let the agent pick them, throw out any fact you don't like, and it writes every draft.</p>
            </div>
            <p class="text-xs font-semibold text-emerald-300/90">Nothing to paste <span aria-hidden="true">→</span></p>
          </div>
        </button>
      </div>

      <!-- Followers chart: current count from TikTok, history snapshotted per
           visit (TikTok has no history API, so the line grows from day one). -->
      <div id="stats-card" class="mt-10 hidden rounded-2xl border border-neutral-800 bg-neutral-900 p-5">
        <div class="flex flex-wrap items-end gap-x-6 gap-y-1">
          <div>
            <h2 class="text-xs font-semibold uppercase tracking-[0.2em] text-neutral-500">Followers · @vhsgaragevideo</h2>
            <p class="mt-1 flex items-baseline gap-2.5">
              <span id="stats-count" class="text-3xl font-extrabold tabular-nums tracking-tight">—</span>
              <span id="stats-delta" class="text-xs font-semibold tabular-nums text-neutral-500"></span>
            </p>
          </div>
          <div class="ml-auto flex flex-col items-end gap-1.5">
            <!-- History vs forecast. Two views of the same series: what
                 happened, and where two straight lines say it goes. -->
            <div class="flex items-center gap-1.5">
              <!-- What data. -->
              <div id="stats-modes" class="inline-flex overflow-hidden rounded-lg border border-neutral-800">
                <button data-mode="history" class="px-2.5 py-1 text-[11px] font-semibold text-neutral-200">History</button>
                <button data-mode="forecast" class="border-l border-neutral-800 px-2.5 py-1 text-[11px] font-semibold text-neutral-500">Forecast</button>
              </div>
              <!-- How it looks. Three directions, live, so the choice can be
                   made against real numbers instead of a mockup. -->
              <div id="stats-styles" class="inline-flex overflow-hidden rounded-lg border border-neutral-800">
                <button data-style="area" title="Bold area" class="px-2.5 py-1 text-[11px] font-semibold text-neutral-500">Area</button>
                <button data-style="bars" title="Gains + cumulative" class="border-l border-neutral-800 px-2.5 py-1 text-[11px] font-semibold text-neutral-500">Bars</button>
                <button data-style="retro" title="Retro / editorial" class="border-l border-neutral-800 px-2.5 py-1 text-[11px] font-semibold text-neutral-500">Retro</button>
              </div>
            </div>
            <p id="stats-note" class="max-w-64 text-right text-[11px] leading-snug text-neutral-600">Logged each time you open the studio</p>
          </div>
        </div>
        <div id="stats-plot" class="relative mt-4 hidden">
          <!-- Legend lives in HTML, not on the canvas: selectable, screen-
               readable, and identity never rests on colour alone. -->
          <div id="stats-legend" class="mb-2 flex flex-wrap items-center gap-x-4 gap-y-1"></div>
          <canvas id="stats-chart" class="block h-64 w-full"></canvas>
          <div id="stats-tip" class="pointer-events-none absolute hidden rounded-md border border-neutral-700 bg-neutral-950 px-2 py-1 text-[11px] tabular-nums text-neutral-200 shadow-lg"></div>
        </div>

        <!-- Milestone dates, shown with the forecast view. -->
        <div id="stats-forecast" class="mt-4 hidden border-t border-neutral-800 pt-4"></div>

        <!-- Which hashtags earn their slot. Read off our own posts, because
             TikTok exposes no hashtag volume data to us at all. -->
        <div id="tag-report" class="mt-5 hidden border-t border-neutral-800 pt-4">
          <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
            <h3 class="text-xs font-semibold uppercase tracking-[0.2em] text-neutral-500">Hashtags &middot; what&rsquo;s working</h3>
            <p id="tag-report-note" class="text-[11px] text-neutral-600"></p>
          </div>
          <div id="tag-report-body" class="mt-3"></div>
        </div>

        <!-- Per-post reporting lives on its own screen: it is a dozen tables,
             and the home screen's job is to get you into making something.
             "Connect post history" is the video.list opt-in — a SEPARATE
             authorize trip, because TikTok rejects the whole request when an
             app asks for a scope it does not hold, which would take sign-in
             and publishing down with it. -->
        <div class="mt-5 flex flex-wrap items-center gap-2 border-t border-neutral-800 pt-4">
          <button id="open-reports" class="flex items-center gap-1.5 rounded-md border border-neutral-800 bg-neutral-950 px-3 py-1.5 text-xs font-semibold text-neutral-200 hover:bg-neutral-800">
            <span class="material-symbols-outlined text-[16px] leading-none">bar_chart</span> Post reports
          </button>
          <button id="connect-history" class="hidden items-center gap-1.5 rounded-md border border-amber-500/40 bg-amber-500/10 px-3 py-1.5 text-xs font-semibold text-amber-200 hover:bg-amber-500/20">
            <span class="material-symbols-outlined text-[16px] leading-none">link</span> Connect post history
          </button>
          <p id="reports-hint" class="text-[11px] leading-snug text-neutral-600"></p>
        </div>
      </div>

      <div class="mt-10 flex flex-wrap items-center justify-between gap-3">
        <h2 class="text-xs font-semibold uppercase tracking-[0.2em] text-neutral-500">Open</h2>
        <div class="flex items-center gap-3">
          <!-- Counts double as filters: the number is the useful part, and once
               it is on screen it may as well be clickable. -->
          <div id="library-filters" class="flex items-center gap-1"></div>
          <div id="library-views" class="inline-flex overflow-hidden rounded-lg border border-neutral-800">
            <button data-view="large" title="Large grid" class="px-2 py-1 leading-none text-neutral-500">
              <span class="material-symbols-outlined text-[16px] leading-none">grid_view</span>
            </button>
            <button data-view="grid" title="Compact grid" class="border-l border-neutral-800 px-2 py-1 leading-none text-neutral-500">
              <span class="material-symbols-outlined text-[16px] leading-none">apps</span>
            </button>
            <button data-view="list" title="List" class="border-l border-neutral-800 px-2 py-1 leading-none text-neutral-500">
              <span class="material-symbols-outlined text-[16px] leading-none">view_list</span>
            </button>
          </div>
        </div>
      </div>
      <div id="project-grid" class="mt-3"></div>
      <p id="library-empty" class="mt-3 hidden rounded-xl border border-dashed border-neutral-800 p-8 text-center text-sm text-neutral-500">
        Nothing saved yet — drafts and posted TikToks land here automatically as you work.
      </p>
    </section>

    <!-- ============ REPORTS ============
         Everything the Display API will tell us about our own posts. Like the
         batch screen, every id below is owned by reports.js and read by
         nothing else.

         The panels are ordered by what you can act on soonest: what moved this
         week, then what wins overall, then the levers (tags, length, timing).
         Each one renders from postreport.js, which is pure and unit-tested —
         no panel needs a live TikTok session to be eyeballed. -->
    <section id="screen-reports" class="mx-auto hidden w-full max-w-5xl px-4 py-4">
      <div class="flex flex-wrap items-center gap-2 pb-3">
        <button id="reports-back" title="Back to your library" class="flex items-center gap-1 rounded-md border border-neutral-800 bg-neutral-900 px-2.5 py-1.5 text-xs font-semibold text-neutral-300 hover:bg-neutral-800">
          <span class="material-symbols-outlined text-[16px] leading-none">arrow_back</span> Library
        </button>
        <h1 class="text-sm font-semibold text-neutral-200">Post reports</h1>
        <button id="reports-refresh" class="ml-auto flex items-center gap-1 rounded-md border border-neutral-800 bg-neutral-900 px-2.5 py-1.5 text-xs font-semibold text-neutral-300 hover:bg-neutral-800">
          <span class="material-symbols-outlined text-[16px] leading-none">refresh</span> Refresh
        </button>
      </div>

      <!-- Scope problems, fetch failures and "come back tomorrow" all land
           here rather than being mimed by an empty table. -->
      <p id="reports-status" class="hidden rounded-xl border border-neutral-800 bg-neutral-900 px-4 py-3 text-xs leading-relaxed text-neutral-400"></p>

      <div id="reports-panels" class="hidden">
        <div class="mt-3 rounded-2xl border border-neutral-800 bg-neutral-900 p-5">
          <h2 class="text-xs font-semibold uppercase tracking-[0.2em] text-neutral-500">The account</h2>
          <div id="rep-account" class="mt-3"></div>
        </div>

        <div class="mt-4 rounded-2xl border border-neutral-800 bg-neutral-900 p-5">
          <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
            <h2 class="text-xs font-semibold uppercase tracking-[0.2em] text-neutral-500">Still moving</h2>
            <p id="rep-momentum-note" class="text-[11px] text-neutral-600"></p>
          </div>
          <div id="rep-momentum" class="mt-3"></div>
        </div>

        <div class="mt-4 rounded-2xl border border-neutral-800 bg-neutral-900 p-5">
          <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
            <h2 class="text-xs font-semibold uppercase tracking-[0.2em] text-neutral-500">Top posts</h2>
            <p id="rep-leaders-note" class="text-[11px] text-neutral-600"></p>
          </div>
          <div id="rep-leaders" class="mt-3"></div>
        </div>

        <div class="mt-4 rounded-2xl border border-neutral-800 bg-neutral-900 p-5">
          <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
            <h2 class="text-xs font-semibold uppercase tracking-[0.2em] text-neutral-500">Hashtags</h2>
            <p id="rep-tags-note" class="text-[11px] text-neutral-600"></p>
          </div>
          <div id="rep-tags" class="mt-3"></div>
        </div>

        <div class="mt-4 grid gap-4 lg:grid-cols-2">
          <div class="rounded-2xl border border-neutral-800 bg-neutral-900 p-5">
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
              <h2 class="text-xs font-semibold uppercase tracking-[0.2em] text-neutral-500">Length</h2>
              <p id="rep-length-note" class="text-[11px] text-neutral-600"></p>
            </div>
            <div id="rep-length" class="mt-3"></div>
          </div>
          <div class="rounded-2xl border border-neutral-800 bg-neutral-900 p-5">
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
              <h2 class="text-xs font-semibold uppercase tracking-[0.2em] text-neutral-500">Day posted</h2>
              <p id="rep-weekday-note" class="text-[11px] text-neutral-600"></p>
            </div>
            <div id="rep-weekday" class="mt-3"></div>
          </div>
        </div>

        <div class="mt-4 rounded-2xl border border-neutral-800 bg-neutral-900 p-5">
          <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
            <h2 class="text-xs font-semibold uppercase tracking-[0.2em] text-neutral-500">Time of day</h2>
            <p id="rep-hour-note" class="text-[11px] text-neutral-600"></p>
          </div>
          <div id="rep-hour" class="mt-3"></div>
        </div>

        <p class="mt-4 text-[11px] leading-relaxed text-neutral-600">
          TikTok reports only a post&rsquo;s current totals &mdash; there is no per-post history endpoint &mdash; so the
          velocity columns are built from snapshots this studio takes when you open it. Density depends on how
          often that happens. Watch time, reach, traffic source and audience demographics are not available on
          this API at all.
        </p>
      </div>
    </section>

    <!-- ============ BATCH (beta) ============
         Self-contained: every id below is owned by batch.js and read by
         nothing else, so this screen can change without touching the three
         shipping formats. Two steps — WRITE turns movies into drafts with
         placeholder frames, SHOOT fills those frames in from the movie file
         with the AI frame check. -->
    <section id="screen-batch" class="mx-auto hidden w-full max-w-6xl px-4 py-4">
      <div class="flex flex-wrap items-center gap-2 pb-3">
        <button id="batch-back" title="Back to your library" class="flex items-center gap-1 rounded-md border border-neutral-800 bg-neutral-900 px-2.5 py-1.5 text-xs font-semibold text-neutral-300 hover:bg-neutral-800">
          <span class="material-symbols-outlined text-[16px] leading-none">arrow_back</span> Library
        </button>
        <span class="rounded bg-emerald-400/15 px-2 py-1 text-[11px] font-bold uppercase tracking-wider text-emerald-300">Batch mode</span>
        <div class="ml-auto flex items-center gap-1 rounded-lg border border-neutral-800 bg-neutral-900 p-1">
          <button id="batch-tab-write" class="rounded-md px-3 py-1.5 text-xs font-semibold">1 · Write</button>
          <button id="batch-tab-shoot" class="rounded-md px-3 py-1.5 text-xs font-semibold">2 · Shoot</button>
        </div>
      </div>

      <!-- ---- STEP 1: WRITE ---- -->
      <div id="batch-write" class="grid gap-4 lg:grid-cols-[minmax(0,21rem)_minmax(0,1fr)]">
        <aside class="flex flex-col gap-3">
          <div class="rounded-xl border border-neutral-800 bg-neutral-900 p-3">
            <h2 class="text-xs font-semibold uppercase tracking-[0.2em] text-neutral-500">Movies</h2>
            <button id="batch-suggest" class="mt-2 flex w-full items-center justify-center gap-2 rounded-lg bg-emerald-600 px-3 py-2 text-sm font-bold text-white hover:bg-emerald-500 disabled:opacity-40">
              <span class="material-symbols-outlined text-[18px] leading-none">auto_awesome</span>
              Pick 10 for me
            </button>
            <p id="batch-suggest-note" class="mt-1.5 text-[11px] leading-snug text-neutral-500">
              Picks from what you have already posted, skipping repeats.
            </p>
            <div class="relative mt-3">
              <input id="batch-search" type="search" autocomplete="off" placeholder="or add a movie by name"
                     class="w-full rounded-lg border border-neutral-800 bg-neutral-950 px-3 py-2 text-sm text-neutral-100 placeholder:text-neutral-600" />
              <div id="batch-search-results" class="absolute inset-x-0 top-full z-10 mt-1 hidden max-h-72 overflow-y-auto rounded-lg border border-neutral-700 bg-neutral-950 shadow-xl"></div>
            </div>

            <!-- Paste a whole list instead of searching one at a time. -->
            <details id="batch-paste-box" class="mt-3 border-t border-neutral-800 pt-3">
              <summary class="cursor-pointer select-none text-[11px] font-semibold uppercase tracking-wide text-neutral-500 hover:text-neutral-300">
                Paste a list of movies
              </summary>
              <textarea id="batch-paste" rows="6" placeholder="One per line. Years optional.&#10;&#10;The Thing (1982)&#10;Jaws&#10;3. Alien - 1979"
                        class="mt-2 w-full rounded-lg border border-neutral-800 bg-neutral-950 px-3 py-2 text-sm text-neutral-100 placeholder:text-neutral-600"></textarea>
              <div class="mt-2 flex items-center gap-2">
                <button id="batch-paste-match"
                        class="flex items-center gap-1.5 rounded-lg border border-neutral-700 bg-neutral-950 px-3 py-1.5 text-xs font-semibold text-neutral-200 hover:bg-neutral-800 disabled:opacity-40">
                  <span class="material-symbols-outlined text-[15px] leading-none">playlist_add</span>
                  Match &amp; add
                </button>
                <span id="batch-paste-note" class="text-[11px] leading-snug text-neutral-500"></span>
              </div>
              <ul id="batch-paste-report" class="mt-2 flex flex-col gap-0.5"></ul>
            </details>
          </div>

          <div class="rounded-xl border border-neutral-800 bg-neutral-900 p-3">
            <div class="flex items-baseline justify-between">
              <h2 class="text-xs font-semibold uppercase tracking-[0.2em] text-neutral-500">Queue</h2>
              <span id="batch-queue-count" class="text-xs tabular-nums text-neutral-500"></span>
            </div>
            <ol id="batch-queue" class="mt-2 flex flex-col gap-1.5"></ol>
            <p id="batch-queue-empty" class="mt-2 rounded-lg border border-dashed border-neutral-800 p-4 text-center text-xs text-neutral-500">
              No movies yet. Let the agent pick, or add one by name.
            </p>
          </div>

          <button id="batch-build" class="flex items-center justify-center gap-2 rounded-lg bg-emerald-600 px-4 py-2.5 text-sm font-bold text-white hover:bg-emerald-500 disabled:opacity-40" disabled>
            <span class="material-symbols-outlined text-[20px] leading-none">edit_note</span>
            <span id="batch-build-label">Write every draft</span>
          </button>
          <p id="batch-build-note" class="-mt-1 text-[11px] leading-snug text-neutral-500">
            Writes captions and timecodes for every movie and saves them as drafts. Frames come next, in Shoot.
          </p>
        </aside>

        <section class="rounded-xl border border-neutral-800 bg-neutral-900 p-3">
          <div class="flex flex-wrap items-center gap-2">
            <h2 id="batch-picker-title" class="text-sm font-bold tracking-tight">Trivia</h2>
            <span id="batch-picker-meta" class="text-xs tabular-nums text-neutral-500"></span>
            <div class="ml-auto flex items-center gap-1.5">
              <label class="flex items-center gap-1.5 text-xs text-neutral-400">
                Show
                <input id="batch-size" type="number" min="1" max="25" value="10"
                       class="w-14 rounded-md border border-neutral-800 bg-neutral-950 px-2 py-1 text-xs tabular-nums text-neutral-100" />
              </label>
              <label class="flex items-center gap-1 text-xs text-neutral-400" title="Spoiler trivia is flagged by IMDb">
                <input id="batch-spoilers" type="checkbox" class="accent-emerald-500" /> Spoilers
              </label>
              <label class="flex items-center gap-1 text-xs text-neutral-400"
                     title="Send the top 25 by votes to the agent and let it choose the best slides, instead of taking the top 10 by votes">
                <input id="batch-curate" type="checkbox" class="accent-emerald-500" checked /> AI picks
              </label>
              <button id="batch-replace-all" class="rounded-md bg-neutral-800 px-2.5 py-1.5 text-xs font-semibold hover:bg-neutral-700" title="Throw this whole set out and show the next ones">Next set</button>
              <button id="batch-reset" class="rounded-md bg-neutral-800 px-2.5 py-1.5 text-xs font-semibold hover:bg-neutral-700" title="Undo every removal">Reset</button>
            </div>
          </div>
          <p id="batch-picker-hint" class="mt-1 text-[11px] leading-snug text-neutral-500">
            Straight from IMDb, ranked by helpful votes minus unhelpful ones. Throw one out and the next best takes its place.
          </p>
          <p id="batch-curate-note" class="mt-1 hidden text-[11px] leading-snug text-emerald-300/80"></p>
          <ol id="batch-trivia" class="mt-3 flex flex-col gap-2"></ol>
          <p id="batch-trivia-empty" class="mt-3 rounded-lg border border-dashed border-neutral-800 p-8 text-center text-sm text-neutral-500">
            Pick a movie on the left to see its trivia.
          </p>
        </section>
      </div>

      <!-- ---- STEP 2: SHOOT ----
           Rebuilt so you can always tell WHICH movie it is on, WHAT it is
           doing, and that it is still alive. Three bands: the folder, the
           live run, then one row per draft. No dropdown — a dropdown hid
           three of four movies and made a batch look like a single job. -->
      <div id="batch-shoot" class="hidden flex-col gap-3">

        <!-- Band 1: the movies folder -->
        <div class="rounded-xl border border-neutral-800 bg-neutral-900 p-4">
          <div class="flex flex-wrap items-center gap-2">
            <h2 class="text-sm font-bold tracking-tight">Movies folder</h2>
            <span id="batch-folder-status" class="text-xs text-neutral-500"></span>
            <div class="ml-auto flex flex-wrap items-center gap-1.5">
              <button id="batch-folder-btn" class="flex items-center gap-1.5 rounded-lg border border-neutral-700 bg-neutral-950 px-3 py-1.5 text-xs font-semibold text-neutral-200 hover:bg-neutral-800">
                <span class="material-symbols-outlined text-[16px] leading-none">folder</span>Set folder
              </button>
              <button id="batch-scan" class="flex items-center gap-1.5 rounded-lg border border-neutral-700 bg-neutral-950 px-3 py-1.5 text-xs font-semibold text-neutral-200 hover:bg-neutral-800 disabled:opacity-40">
                <span class="material-symbols-outlined text-[16px] leading-none">search</span>Scan folder
              </button>
              <button id="batch-unlock" class="hidden items-center gap-1.5 rounded-lg bg-amber-500/90 px-3 py-1.5 text-xs font-bold text-black hover:bg-amber-400">
                <span class="material-symbols-outlined text-[16px] leading-none">lock_open</span><span id="batch-unlock-label">Unlock</span>
              </button>
            </div>
          </div>
          <p class="mt-1 text-[11px] leading-snug text-neutral-500">
            Scanned once and remembered, so future sessions start instantly. Rescan after adding movies.
          </p>
        </div>

        <!-- Band 2: the live run. Hidden until something is running. -->
        <div id="batch-run" class="hidden rounded-xl border border-emerald-500/30 bg-neutral-900 p-4">
          <div class="flex flex-wrap items-baseline gap-2">
            <span id="batch-run-phase" class="text-sm font-bold tracking-tight text-emerald-300"></span>
            <span id="batch-run-detail" class="min-w-0 flex-1 truncate text-xs text-neutral-400"></span>
            <button id="batch-cancel" class="rounded-md bg-neutral-800 px-2.5 py-1 text-xs font-semibold hover:bg-neutral-700">Stop</button>
          </div>
          <div class="mt-2 h-1.5 w-full overflow-hidden rounded-full bg-neutral-800">
            <div id="batch-run-bar" class="h-full w-0 rounded-full bg-emerald-500 transition-[width] duration-200"></div>
          </div>
          <!-- The heartbeat: proof of life you can watch from across the room.
               It ticks every second whether or not the work reports in, and
               turns amber when nothing has reported for a while. -->
          <p id="batch-heartbeat" class="mt-1.5 flex items-center gap-1.5 text-[11px] text-neutral-500">
            <span id="batch-pulse" class="inline-block h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
            <span id="batch-heartbeat-text"></span>
          </p>
        </div>

        <!-- Band 3: every draft, always visible -->
        <div class="rounded-xl border border-neutral-800 bg-neutral-900 p-4">
          <div class="flex flex-wrap items-center gap-2">
            <h2 class="text-sm font-bold tracking-tight">Drafts waiting for frames</h2>
            <span id="batch-draft-summary" class="text-xs tabular-nums text-neutral-500"></span>
            <div class="ml-auto flex flex-wrap items-center gap-1.5">
              <button id="batch-find" class="rounded-lg border border-neutral-700 bg-neutral-950 px-3 py-1.5 text-xs font-semibold text-neutral-200 hover:bg-neutral-800 disabled:opacity-40">Find files</button>
              <button id="batch-shoot-all" class="flex items-center gap-1.5 rounded-lg bg-emerald-600 px-3 py-1.5 text-xs font-bold text-white hover:bg-emerald-500 disabled:opacity-40">
                <span class="material-symbols-outlined text-[16px] leading-none">camera_roll</span>Shoot all
              </button>
            </div>
          </div>
          <ul id="batch-drafts" class="mt-2 flex flex-col gap-1.5"></ul>
          <p id="batch-drafts-empty" class="mt-2 rounded-lg border border-dashed border-neutral-800 p-6 text-center text-xs text-neutral-500">
            No drafts waiting. Write some in step 1.
          </p>
          <video id="batch-video" class="mt-3 hidden w-full max-w-xs rounded-lg bg-black" playsinline muted></video>
          <input id="batch-file" type="file" accept="video/*" class="hidden" />
        </div>

        <ol id="batch-shots" class="flex flex-col gap-2"></ol>
      </div>

      <p id="batch-status" class="mt-3 min-h-5 text-xs text-neutral-400" role="status" aria-live="polite"></p>
    </section>

    <!-- ============ EDITOR ============ -->
    <!-- Full-slide preview. Composed by the same code path as the upload, so a
         line break judged here is the one that ships. -->
    <div id="slide-preview" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/80 p-4 backdrop-blur-sm">
      <div class="flex max-h-full flex-col items-center gap-2">
        <div class="flex w-full items-center justify-between gap-4">
          <p id="slide-preview-meta" class="text-xs tabular-nums text-neutral-400"></p>
          <button id="slide-preview-close" title="Close (Esc)"
                  class="flex items-center gap-1 rounded-md border border-neutral-700 bg-neutral-900 px-2 py-1 text-xs font-semibold text-neutral-300 hover:bg-neutral-800">
            <span class="material-symbols-outlined text-[15px] leading-none">close</span> Close
          </button>
        </div>
        <canvas id="slide-preview-canvas" class="max-h-[80vh] w-auto rounded-lg bg-black shadow-2xl"></canvas>
      </div>
    </div>

    <section id="screen-editor" class="mx-auto hidden w-full max-w-6xl px-4 py-4">
      <div class="flex flex-wrap items-center gap-2 pb-2">
        <button id="back-btn" title="Back to your library" class="flex items-center gap-1 rounded-md border border-neutral-800 bg-neutral-900 px-2.5 py-1.5 text-xs font-semibold text-neutral-300 hover:bg-neutral-800">
          <span class="material-symbols-outlined text-[16px] leading-none">arrow_back</span> Library
        </button>
        <span id="format-chip" class="rounded-full px-2.5 py-1 text-[11px] font-bold uppercase tracking-wide"></span>
        <input id="project-name" class="min-w-0 flex-1 basis-40 bg-transparent text-base font-bold tracking-tight text-neutral-100 outline-none placeholder:text-neutral-600" placeholder="Untitled" maxlength="80" />
        <button id="download-btn" disabled
                class="flex items-center gap-1 rounded-lg border border-neutral-700 bg-neutral-900 px-3 py-2 text-sm font-semibold text-neutral-200 hover:bg-neutral-800 disabled:opacity-40"
                title="Download the finished slides as JPEGs — post them manually in the TikTok app, no API needed">
          <span class="material-symbols-outlined text-[18px] leading-none">download</span> Download
        </button>
        <button id="post-btn" disabled class="flex items-center gap-1 rounded-lg bg-red-600 px-4 py-2 text-sm font-bold text-white hover:bg-red-500 disabled:opacity-40">
          <span class="material-symbols-outlined text-[18px] leading-none">upload</span> Post to TikTok
        </button>
      </div>
      <p id="post-status" class="min-h-5 pb-2 text-xs text-neutral-400"></p>

      <!-- The source pane sticks while the slide list scrolls past it: on a long
           set you scroll the slides without losing the frame picker, the
           scrubber, or your place in the video. `self-start` is load-bearing —
           a stretched grid item is as tall as the row and sticky does nothing. -->
      <main class="grid items-start gap-6 lg:grid-cols-[minmax(0,1.45fr)_minmax(0,1fr)]">
        <!-- Source pane -->
        <section class="flex flex-col gap-4 lg:sticky lg:top-4 lg:max-h-[calc(100vh-2rem)] lg:self-start lg:overflow-y-auto lg:pr-1">
          <!-- Tape Trivia -->
          <div id="pane-trivia" class="flex flex-col gap-3">
            <label class="block">
              <span class="text-xs uppercase tracking-wide text-neutral-500">Movie file</span>
              <input id="file-input" type="file" accept="video/*"
                     class="mt-1 block w-full text-sm file:mr-3 file:rounded-lg file:border-0 file:bg-red-600 file:px-3 file:py-2 file:font-semibold file:text-white hover:file:bg-red-500" />
            </label>
            <p id="video-note" class="hidden text-[11px] leading-snug text-amber-300/80">
              Slides intact. Re-pick the file to grab new frames.
            </p>
            <!-- One-click reload when batch mode remembers where this movie's
                 file lives (folder grant / past pick). Hidden until a
                 remembered source resolves; wired additively in app.js. -->
            <button id="video-reload" class="hidden items-center gap-1.5 self-start rounded-lg border border-emerald-500/50 bg-neutral-950 px-3 py-2 text-xs font-semibold text-emerald-300 hover:bg-neutral-800">
              <span class="material-symbols-outlined text-[16px] leading-none">history</span>
              <span id="video-reload-label">Load the movie file again</span>
            </button>

            <div id="trivia-seed" class="flex flex-col gap-3">
            <textarea id="autopilot-prompt" rows="2"
                      class="w-full rounded-lg border border-neutral-800 bg-neutral-900 px-3 py-2 text-sm text-neutral-100 placeholder:text-neutral-600"
                      placeholder="Optional starter prompt — paste trivia you found (IMDb, Reddit, anywhere) or give a direction; autopilot verifies and riffs on it"></textarea>
            <p class="-mt-1 text-[11px] leading-snug text-neutral-500">
              A pasted list of trivia becomes autopilot's source — it rewrites each into a slide. Drag
              <a href={IMDB_BOOKMARKLET}
                 class="inline-flex items-center gap-0.5 rounded bg-neutral-800 px-1.5 py-0.5 text-neutral-300"
                 title="Drag me to your bookmarks bar, then click it while on a movie's IMDb Trivia page — it loads every item and sorts by helpful votes"
                 onclick="return false;">
                <span class="material-symbols-outlined text-[13px] leading-none">bookmark</span>Pick IMDb trivia
              </a>
              to your bookmarks bar and click it on a movie's IMDb Trivia page. It loads every item — no
              clicking "See all" — and sorts them most-helpful first, so the good stuff is at the top.
              Tap the ones you want, hit Copy, then paste here.
            </p>

            <button id="autopilot-btn"
                    class="flex items-center justify-center gap-2 rounded-lg bg-red-600 px-4 py-2.5 text-sm font-bold text-white hover:bg-red-500 disabled:opacity-40"
                    disabled title="Load a video first">
              <span class="material-symbols-outlined text-[20px] leading-none">auto_awesome</span>
              Autopilot — title slide + trivia scenes
            </button>
            </div>

            <!-- Shown in place of the seeding controls once slides exist, so the
                 pane is a frame picker rather than a wall of setup copy. -->
            <button id="trivia-seed-show" class="hidden items-center gap-1.5 self-start text-[11px] font-semibold text-neutral-500 hover:text-neutral-300">
              <span class="material-symbols-outlined text-[14px] leading-none">tune</span>
              <span id="trivia-seed-show-label">Show autopilot &amp; paste box</span>
            </button>

            <video id="video" class="w-full rounded-xl bg-black" playsinline muted></video>

            <!-- Chunky scrubber -->
            <div id="scrubber" class="select-none">
              <input id="scrub-range" type="range" min="0" max="1000" value="0"
                     class="h-7 w-full cursor-pointer accent-red-600" />
              <div class="mt-2 flex flex-wrap items-center gap-2 text-sm">
                <span id="timecode" class="tabular-nums text-neutral-300">00:00.000</span>
                <button data-seconds="-5" class="rounded-md bg-neutral-800 px-2 py-1 text-xs tabular-nums hover:bg-neutral-700">−5s</button>
                <button data-seconds="-1" class="rounded-md bg-neutral-800 px-2 py-1 text-xs tabular-nums hover:bg-neutral-700">−1s</button>
                <button data-frames="-5" class="rounded-md bg-neutral-800 px-2 py-1 text-xs tabular-nums hover:bg-neutral-700">−5fr</button>
                <button data-frames="-1" class="rounded-md bg-neutral-800 px-2 py-1 text-xs tabular-nums hover:bg-neutral-700">−1fr</button>
                <button data-frames="1" class="rounded-md bg-neutral-800 px-2 py-1 text-xs tabular-nums hover:bg-neutral-700">+1fr</button>
                <button data-frames="5" class="rounded-md bg-neutral-800 px-2 py-1 text-xs tabular-nums hover:bg-neutral-700">+5fr</button>
                <button data-seconds="1" class="rounded-md bg-neutral-800 px-2 py-1 text-xs tabular-nums hover:bg-neutral-700">+1s</button>
                <button data-seconds="5" class="rounded-md bg-neutral-800 px-2 py-1 text-xs tabular-nums hover:bg-neutral-700">+5s</button>
                <button id="grab-btn" class="ml-auto flex items-center gap-1 rounded-lg bg-red-600 px-4 py-2 font-bold text-white hover:bg-red-500 disabled:opacity-40">
                  <span id="grab-icon" class="material-symbols-outlined text-[20px] leading-none">photo_camera</span>
                  <span id="grab-label">Grab frame</span>
                </button>
                <button id="cancel-edit" class="hidden rounded-lg bg-neutral-800 px-3 py-2 text-sm hover:bg-neutral-700">
                  <span class="material-symbols-outlined align-middle text-[18px] leading-none">close</span> Cancel
                </button>
              </div>
            </div>

            <label class="flex items-center gap-2 text-sm text-neutral-400">
              <input id="title-toggle" type="checkbox" class="accent-red-600" />
              Prefix every slide with a title
              <input id="movie-title" type="text" placeholder="e.g. Jaws (1975)"
                     class="ml-1 flex-1 rounded-md border border-neutral-800 bg-neutral-900 px-2 py-1 text-neutral-100" disabled />
            </label>
          </div>

          <!-- Remembering Some Guys -->
          <div id="pane-guys" class="hidden flex-col gap-3">
            <label class="block">
              <span class="text-xs uppercase tracking-wide text-neutral-500">Actor</span>
              <div class="mt-1 flex gap-2">
                <input id="actor-input" placeholder="e.g. Keith David"
                       class="min-w-0 flex-1 rounded-lg border border-neutral-800 bg-neutral-900 px-3 py-2 text-sm text-neutral-100 placeholder:text-neutral-600" maxlength="80" />
                <button id="find-roles-btn"
                        class="flex items-center gap-1.5 rounded-lg bg-cyan-500 px-4 py-2 text-sm font-bold text-neutral-950 hover:bg-cyan-400 disabled:opacity-40">
                  <span class="material-symbols-outlined text-[18px] leading-none">person_search</span> Find roles
                </button>
              </div>
            </label>
            <p class="text-[11px] leading-snug text-neutral-500">
              The agent lists ~20 memorable, cult-leaning roles. Pick your favorites (up to 12), and it writes a blurb for each.
              You bring the photos: click a slide, then paste, drop, or pick an image.
            </p>

            <div id="roles-box" class="hidden rounded-xl border border-neutral-800 bg-neutral-900 p-3">
              <div class="flex items-center gap-2 pb-2">
                <span class="text-xs font-semibold uppercase tracking-wide text-neutral-400">Roles</span>
                <span id="picked-count" class="text-xs font-semibold text-cyan-300">0 picked</span>
                <div class="ml-auto flex gap-1">
                  <button id="roles-all" class="rounded-md bg-neutral-800 px-2 py-1 text-[11px] font-semibold hover:bg-neutral-700">All</button>
                  <button id="roles-none" class="rounded-md bg-neutral-800 px-2 py-1 text-[11px] font-semibold hover:bg-neutral-700">None</button>
                </div>
              </div>
              <div id="roles-list" class="flex max-h-80 flex-col gap-1 overflow-y-auto pr-1"></div>
              <button id="write-blurbs-btn" disabled
                      class="mt-3 flex w-full items-center justify-center gap-2 rounded-lg bg-cyan-500 px-4 py-2 text-sm font-bold text-neutral-950 hover:bg-cyan-400 disabled:opacity-40">
                <span class="material-symbols-outlined text-[18px] leading-none">auto_awesome</span>
                <span id="write-blurbs-label">Write the slides</span>
              </button>
            </div>
          </div>

          <!-- Year Snapshot -->
          <div id="pane-year" class="hidden flex-col gap-3">
            <label class="block">
              <span class="text-xs uppercase tracking-wide text-neutral-500">Year</span>
              <div class="mt-1 flex gap-2">
                <input id="year-input" type="number" inputmode="numeric" min="1930" max="2035" step="1" placeholder="e.g. 1994"
                       class="min-w-0 flex-1 rounded-lg border border-neutral-800 bg-neutral-900 px-3 py-2 text-sm tabular-nums text-neutral-100 placeholder:text-neutral-600" />
                <button id="year-lookup-btn"
                        class="flex items-center gap-1.5 rounded-lg bg-violet-500 px-4 py-2 text-sm font-bold text-neutral-950 hover:bg-violet-400 disabled:opacity-40">
                  <span class="material-symbols-outlined text-[18px] leading-none">travel_explore</span>
                  <span id="year-lookup-label">Look up the year</span>
                </button>
              </div>
            </label>
            <p class="text-[11px] leading-snug text-neutral-500">
              The agent pulls two top-eight lists for that year: highest IMDb-rated and biggest box office. Each gets its own lead-in slide.
              You bring the artwork: click a slide, hit <b>Find images</b>, then paste, drop, or pick.
            </p>

            <!-- The rated list is the one worth grounding in real data: IMDb has
                 no free API and blocks server-side fetches, so the user runs the
                 rating-sorted, vote-floored search themselves and pastes it in. -->
            <details id="imdb-details" class="rounded-xl border border-neutral-800 bg-neutral-900 p-3">
              <summary class="cursor-pointer select-none text-xs font-semibold uppercase tracking-wide text-neutral-400">
                Rated list source — IMDb vote floor &amp; paste
              </summary>
              <label class="mt-3 flex items-center gap-2 text-xs text-neutral-500">
                Minimum votes
                <input id="min-votes-input" type="number" inputmode="numeric" min="0" step="1000" value="100000"
                       class="w-32 rounded-md border border-neutral-800 bg-neutral-950 px-2 py-1.5 text-sm tabular-nums text-neutral-100" />
                <span class="text-[11px] text-neutral-600">keeps obscure titles off the list</span>
              </label>
              <p class="mt-2 text-[11px] leading-snug text-neutral-500">
                <a id="imdb-search-link" href="https://www.imdb.com/search/title/" target="_blank" rel="noopener noreferrer"
                   class="inline-flex items-center gap-0.5 rounded bg-neutral-800 px-1.5 py-0.5 font-semibold text-violet-300">
                  <span class="material-symbols-outlined text-[13px] leading-none">open_in_new</span>Open this year on IMDb
                </a>
                opens the rating-sorted search with that vote floor. Drag
                <a href={IMDB_LIST_BOOKMARKLET}
                   class="inline-flex items-center gap-0.5 rounded bg-neutral-800 px-1.5 py-0.5 text-neutral-300"
                   title="Drag me to your bookmarks bar, then click it on an IMDb search results page"
                   onclick="return false;">
                  <span class="material-symbols-outlined text-[13px] leading-none">bookmark</span>Copy IMDb results
                </a>
                to your bookmarks bar, click it on that page, then paste below. Copying the page text by hand works too.
              </p>
              <textarea id="imdb-paste" rows="4"
                        class="mt-2 w-full rounded-md border border-neutral-800 bg-neutral-950 px-2 py-1.5 text-sm text-neutral-100 placeholder:text-neutral-600"
                        placeholder="1. The Shawshank Redemption (1994) | 9.3 | 3.1M votes&#10;2. Pulp Fiction (1994) | 8.9 | 2.3M votes"></textarea>
              <p id="imdb-paste-note" class="mt-1 text-[11px] leading-snug text-neutral-500">
                Leave this empty and the agent picks the rated list from memory, applying the vote floor itself.
              </p>
            </details>

            <!-- Same trick for the grosses: Box Office Mojo's yearly chart is
                 the canonical ranking, and it also blocks server-side fetches. -->
            <details id="mojo-details" class="rounded-xl border border-neutral-800 bg-neutral-900 p-3">
              <summary class="cursor-pointer select-none text-xs font-semibold uppercase tracking-wide text-neutral-400">
                Box office source — Mojo chart &amp; paste
              </summary>
              <p class="mt-3 text-[11px] leading-snug text-neutral-500">
                <a id="mojo-link" href="https://www.boxofficemojo.com/" target="_blank" rel="noopener noreferrer"
                   class="inline-flex items-center gap-0.5 rounded bg-neutral-800 px-1.5 py-0.5 font-semibold text-violet-300">
                  <span class="material-symbols-outlined text-[13px] leading-none">open_in_new</span>Open this year on Box Office Mojo
                </a>
                opens the worldwide chart for that year. Drag
                <a href={MOJO_BOOKMARKLET}
                   class="inline-flex items-center gap-0.5 rounded bg-neutral-800 px-1.5 py-0.5 text-neutral-300"
                   title="Drag me to your bookmarks bar, then click it on a Box Office Mojo yearly chart"
                   onclick="return false;">
                  <span class="material-symbols-outlined text-[13px] leading-none">bookmark</span>Copy Mojo chart
                </a>
                to your bookmarks bar, click it on that page, then paste below.
              </p>
              <textarea id="mojo-paste" rows="4"
                        class="mt-2 w-full rounded-md border border-neutral-800 bg-neutral-950 px-2 py-1.5 text-sm text-neutral-100 placeholder:text-neutral-600"
                        placeholder="1. The Lion King | $968.5M worldwide&#10;2. Forrest Gump | $678.2M worldwide"></textarea>
              <p id="mojo-paste-note" class="mt-1 text-[11px] leading-snug text-neutral-500">
                Leave this empty and the agent recalls the box office list itself.
              </p>
            </details>

            <div id="year-summary" class="hidden rounded-xl border border-neutral-800 bg-neutral-900 p-3">
              <div class="flex items-center gap-2 pb-2">
                <span class="text-xs font-semibold uppercase tracking-wide text-neutral-400">Snapshot</span>
                <span id="year-summary-year" class="text-xs font-semibold tabular-nums text-violet-300"></span>
              </div>
              <div id="year-summary-lists" class="flex flex-col gap-1"></div>
              <button id="year-rebuild-btn"
                      class="mt-3 flex w-full items-center justify-center gap-2 rounded-lg bg-violet-500 px-4 py-2 text-sm font-bold text-neutral-950 hover:bg-violet-400 disabled:opacity-40">
                <span class="material-symbols-outlined text-[18px] leading-none">auto_awesome</span>
                Rebuild the slides from this snapshot
              </button>
            </div>
          </div>

          <!-- Post details (shared) -->
          <details id="post-details" class="rounded-xl border border-neutral-800 bg-neutral-900 p-3">
            <summary class="cursor-pointer select-none text-xs font-semibold uppercase tracking-wide text-neutral-400">Post details — title, description &amp; hashtags<span
                id="post-details-badge"
                class="ml-2 hidden rounded-full bg-amber-400/15 px-1.5 py-0.5 text-[10px] font-bold normal-case tracking-normal text-amber-300"
              ></span></summary>
            <label class="mt-3 block text-xs text-neutral-500">Title
              <input id="post-title-input" maxlength="90"
                     class="mt-1 w-full rounded-md border border-neutral-800 bg-neutral-950 px-2 py-1.5 text-sm text-neutral-100" />
            </label>
            <label class="mt-2 block text-xs text-neutral-500">Description
              <textarea id="post-desc-input" rows="6" maxlength="4000"
                        class="mt-1 w-full rounded-md border border-neutral-800 bg-neutral-950 px-2 py-1.5 text-sm text-neutral-100"></textarea>
            </label>
            <div class="mt-2 flex items-center justify-between gap-3">
              <span class="text-[11px] text-neutral-600">5 tags: the film&rsquo;s own, then a rotating house pair</span>
              <button id="post-reset" class="shrink-0 text-[11px] font-semibold text-neutral-400 hover:text-neutral-200">Reset to suggested</button>
            </div>

            <!-- Soundtrack picks. No TikTok API mode can attach a specific
                 song, so these exist to be searched by hand in the app. -->
            <div id="song-picks" class="mt-3 hidden border-t border-neutral-800 pt-3">
              <p class="flex items-center gap-1.5 text-[11px] font-semibold uppercase tracking-wide text-neutral-500">
                <span class="material-symbols-outlined text-[14px] leading-none">music_note</span>
                Sound picks
              </p>
              <p class="mt-0.5 text-[11px] leading-snug text-neutral-600">
                Search one of these in the TikTok app when you finish the draft &mdash; the API can&rsquo;t set a song.
              </p>
              <ul id="song-list" class="mt-2 flex flex-col gap-1"></ul>
            </div>
          </details>
        </section>

        <!-- Slides pane -->
        <section class="flex flex-col gap-3">
          <div class="flex items-center justify-between gap-2">
            <h2 class="text-xs font-semibold uppercase tracking-[0.2em] text-neutral-500">
              Slides <span class="text-neutral-600">(<span id="slide-count">0</span>/35)</span>
            </h2>
            <button id="add-scene" disabled title="Load a video first"
                    class="flex items-center gap-1 rounded-lg border border-neutral-700 bg-neutral-900 px-3 py-1.5 text-sm font-semibold text-neutral-200 hover:bg-neutral-800 disabled:opacity-40">
              <span class="material-symbols-outlined text-[18px] leading-none">add</span> Add AI scene
            </button>
          </div>
          <p id="slides-hint" class="text-[11px] leading-snug text-neutral-500"></p>
          <ol id="slide-list" class="flex flex-col gap-2"></ol>
        </section>
      </main>

      <input id="img-file-input" type="file" accept="image/*" multiple class="hidden" />
    </section>
  </div>

  <style is:global>
    #studio {
      font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
      font-feature-settings: 'cv11';
    }
    .tape-lines {
      background-image: repeating-linear-gradient(0deg, rgba(255, 255, 255, 0.05) 0 1px, transparent 1px 7px);
    }
    @keyframes save-pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.35; } }
    .save-pulse { animation: save-pulse 1.2s ease-in-out infinite; }
    #post-details > summary::-webkit-details-marker { display: none; }

    /* Batch mode hands off from Write to Shoot on its own; this makes the
       jump legible instead of the screen just changing under you. */
    @keyframes step-in {
      from { opacity: 0; transform: translateY(10px); }
      to   { opacity: 1; transform: none; }
    }
    .step-in { animation: step-in 0.32s cubic-bezier(0.2, 0.7, 0.3, 1) both; }
    @keyframes tab-ping {
      0%   { box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.6); }
      100% { box-shadow: 0 0 0 12px rgba(16, 185, 129, 0); }
    }
    .tab-ping { animation: tab-ping 0.9s ease-out 2; }
    @media (prefers-reduced-motion: reduce) {
      .step-in, .tab-ping { animation: none; }
    }
  </style>

  <script type="module" src={`/scripts/tik/app.js?v=${BUILD_ID}`}></script>
</Base>
