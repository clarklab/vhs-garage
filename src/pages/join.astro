---
import Base from '../layouts/Base.astro';
import SignupForm from '../components/SignupForm.astro';
---

<Base title="Join" description="Sign up for VHS Garage. Free mystery VHS at our next event.">

  <div id="join-layout" class="min-h-screen flex flex-col items-center justify-center px-6 py-12">
    <img src="/unfurl.png" alt="VHS Garage" class="w-64 mb-10" />

    <h1 class="text-3xl mb-3 text-center">Join us in the Garage</h1>
    <p class="text-gray-400 text-center max-w-md mb-8">Drop your email or phone and we'll give you a <strong class="text-white">free mystery VHS</strong>. No spam. Just tapes.</p>

    <SignupForm
      id="join-form"
      showCount={true}
      countId="join-count"
      layoutId="join-layout"
      successTargetId="join-confirm"
    />

    <a href="/" class="text-white/30 text-xs mt-12 hover:text-white/50 transition-colors">← vhsgarage.com</a>
  </div>

  <div id="join-confirm" class="hidden fixed inset-0 z-50 bg-black overflow-y-auto">
    <div aria-hidden="true" class="fixed inset-0 pointer-events-none scanlines"></div>
    <div class="relative min-h-full flex flex-col items-center justify-center px-6 py-10 text-center">
      <p class="text-white/60 text-[11px] tracking-[0.3em] mb-6">░░░  CONFIRMED  ░░░</p>
      <div class="w-full max-w-md">
        <p aria-hidden="true" class="text-white/30 text-xl tracking-widest mb-2">▓▓▓▓▓▓▓▓▓▓▓▓▓</p>
        <h2 class="text-7xl sm:text-9xl font-black tracking-tight leading-none text-white free-tape py-6">
          FREE<br/>TAPE
        </h2>
        <p aria-hidden="true" class="text-white/30 text-xl tracking-widest mt-2">▓▓▓▓▓▓▓▓▓▓▓▓▓</p>
      </div>
      <p class="text-white/80 text-base mt-8 px-4 max-w-md">
        Show this screen to <strong class="text-white">Matt</strong> or <strong class="text-white">Clark</strong> for your free VHS tape. Good luck.
      </p>

      <div class="w-full max-w-md flex flex-col gap-3 mt-10">
        <a href="/watch" class="w-full h-14 flex items-center justify-center border border-white/30 text-white text-base hover:border-white hover:bg-white/5 transition-colors">
          ▶ Watch VHS in the Garage
        </a>
        <a href="https://game.vhsgarage.com" class="w-full h-14 flex items-center justify-center border border-white/30 text-white text-base hover:border-white hover:bg-white/5 transition-colors">
          ▶ Play our VHS Game
        </a>
      </div>

      <p class="text-white/30 text-[10px] mt-12 italic max-w-md">Within reason, don't be weird. We're cool.</p>
    </div>
  </div>

  <style>
    .scanlines {
      background: repeating-linear-gradient(
        to bottom,
        transparent 0,
        transparent 2px,
        rgba(255, 255, 255, 0.04) 2px,
        rgba(255, 255, 255, 0.04) 3px
      );
    }
    .free-tape {
      text-shadow:
        2px 0 rgba(255, 0, 80, 0.7),
        -2px 0 rgba(0, 200, 255, 0.7),
        0 0 30px rgba(255, 255, 255, 0.25);
      animation: vhs-wobble 5s ease-in-out infinite;
    }
    @keyframes vhs-wobble {
      0%, 100% { transform: translateX(0); }
      25% { transform: translateX(-1px); }
      75% { transform: translateX(1px); }
    }
  </style>

</Base>
