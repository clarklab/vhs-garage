---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import BlogHeader from '../../../components/BlogHeader.astro';

// One static page per category. Categories are an enum on the blog
// schema (Tapes / Hardware / Guides / Collections); we slugify to
// lowercase for URLs and look back up to title-case for the heading.
const CATEGORIES = ['Tapes', 'Hardware', 'Guides', 'Collections'] as const;

export async function getStaticPaths() {
  const cats = ['Tapes', 'Hardware', 'Guides', 'Collections'] as const;
  return cats.map((c) => ({ params: { category: c.toLowerCase() }, props: { canonical: c } }));
}

const { canonical } = Astro.props as { canonical: typeof CATEGORIES[number] };

const allPosts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const posts = allPosts.filter((p) => (p.data.categories || []).includes(canonical));

const formatter = new Intl.DateTimeFormat('en', {
  month: 'long', day: 'numeric', year: 'numeric',
});
const getSlug = (id: string) => id.replace(/\.(md|mdx)$/, '');
---

<Base
  title={`${canonical} — VHS Garage Blog`}
  description={`Posts in the ${canonical} category on VHS Garage.`}
>
  <BlogHeader />

  <main class="min-h-svh bg-black text-white antialiased isolate">
    <section class="max-w-5xl mx-auto px-6 py-16 sm:py-24">
      <div class="max-w-3xl">
        <p class="text-white/40 text-xs uppercase tracking-widest mb-4">Category</p>
        <h1 class="text-4xl sm:text-6xl text-pretty mb-5">{canonical}</h1>
        <p class="text-gray-300 text-base sm:text-lg leading-8 max-w-2xl">
          Every post tagged <strong class="text-white">{canonical}</strong>, newest first.
        </p>
      </div>

      {posts.length === 0 && (
        <p class="mt-14 text-white/40 text-sm">No posts in this category yet.</p>
      )}

      <div class="mt-14 grid gap-5">
        {posts.map((post) => {
          const cardImage = post.data.indexImage || post.data.image;
          return (
          <a href={`/blog/${getSlug(post.id)}`} class="group flex flex-col sm:flex-row gap-5 border border-white/15 p-5 hover:border-white/35 transition-colors">
            <div class="shrink-0 sm:w-56 aspect-video bg-[#141214] border border-white/10 overflow-hidden">
              {cardImage ? (
                <img src={cardImage} alt="" loading="lazy"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
              ) : (
                <div class="w-full h-full flex items-center justify-center text-white/15 text-xl tracking-widest">░ ▓ ░</div>
              )}
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-white/35 text-xs uppercase tracking-widest mb-2">{formatter.format(post.data.pubDate)}</p>
              <h2 class="text-2xl sm:text-3xl mb-3 group-hover:text-[#dc2626] transition-colors">{post.data.title}</h2>
              <p class="text-gray-400 text-base leading-7">{post.data.description}</p>
            </div>
          </a>
          );
        })}
      </div>
    </section>
  </main>
</Base>
