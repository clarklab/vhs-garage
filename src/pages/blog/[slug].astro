---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import BlogHeader from '../../components/BlogHeader.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter((post) => !post.data.draft);
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.(md|mdx)$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formatter = new Intl.DateTimeFormat('en', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});
---

<Base title={post.data.title} description={post.data.description}>
  <style>
    /* Post title — pixelated motion-blur drop trail.
       Stacked single-pixel offset shadows with progressively-decreasing
       opacity create a "pixel ghost" trail extending down + right from
       the letter, like the text was dragged diagonally across the page
       and left a fading pixel afterimage behind it. Each shadow is at
       an integer pixel step (1px, 2px, 3px…) with no blur, so the
       falloff reads as discrete pixels rather than a smooth gradient.
       letter-spacing kept at 1px so the trail also gets per-character
       gaps. */
    .post-title-vhs {
      letter-spacing: 1px;
      /* Three-stage trail tuned to look like a shooting-star streak:
           HEAD  (1–5px)  — every pixel, bright. The dense leading edge
                            close to the letter gives the trail
                            something solid to read against.
           MID   (7–12px) — every other pixel, dimming. Gaps start
                            appearing between offset positions; the
                            "halftone" feeling kicks in here.
           TAIL  (16+px)  — increasingly large gaps + sharp opacity
                            falloff. By 38px the shadow is at 2% alpha
                            and barely there. The big spacing toward
                            the end is what makes it read as scattered
                            pixels rather than a continuous fade.
         All at integer pixel offsets with no blur so each step
         remains a sharp single-pixel duplicate. Trail stays on the
         down-right diagonal so the "drag direction" reads cleanly. */
      text-shadow:
        /* HEAD — dense, every pixel */
        1px 1px 0 rgba(220, 38, 38, 1.00),
        2px 2px 0 rgba(220, 38, 38, 0.92),
        3px 3px 0 rgba(220, 38, 38, 0.82),
        4px 4px 0 rgba(220, 38, 38, 0.70),
        5px 5px 0 rgba(220, 38, 38, 0.58),
        /* MID — every-other-pixel spacing, dimming */
        7px 7px 0 rgba(220, 38, 38, 0.46),
        9px 9px 0 rgba(220, 38, 38, 0.36),
        11px 11px 0 rgba(220, 38, 38, 0.27),
        /* TAIL — gaps widen 3 → 4 → 5 → 6px, opacity falls hard */
        14px 14px 0 rgba(220, 38, 38, 0.20),
        17px 17px 0 rgba(220, 38, 38, 0.15),
        20px 20px 0 rgba(220, 38, 38, 0.11),
        24px 24px 0 rgba(220, 38, 38, 0.07),
        28px 28px 0 rgba(220, 38, 38, 0.05),
        33px 33px 0 rgba(220, 38, 38, 0.03),
        38px 38px 0 rgba(220, 38, 38, 0.02);
    }
  </style>

  <BlogHeader />

  <main class="min-h-svh bg-black text-white antialiased isolate">
    <article class="max-w-5xl mx-auto px-6 py-12 sm:py-20">
      <header class:list={[
        'max-w-3xl pb-10 border-b border-white/10',
        post.data.template === 'guide' ? 'border-[#dc2626]/30' : '',
      ]}>
        <p class="text-white/40 text-xs uppercase tracking-widest mb-4">{formatter.format(post.data.pubDate)}</p>
        <h1 class="post-title-vhs text-4xl sm:text-6xl text-pretty mb-5">{post.data.title}</h1>
        <p class="text-gray-300 text-base sm:text-lg leading-8">{post.data.description}</p>
      </header>

      {post.data.image && (
        <!-- Hero image — sits between the header and the body content.
             max-w matches the prose column width so it doesn't blow the
             reading rhythm. Lazy-loaded since it's below the LCP fold. -->
        <figure class="max-w-3xl mt-10">
          <img src={post.data.image} alt="" loading="lazy"
            class="w-full aspect-video object-cover bg-[#141214] border border-white/10" />
        </figure>
      )}

      <div class="prose vhs-prose max-w-[72ch] mt-10">
        <Content />
      </div>
    </article>
  </main>
</Base>
