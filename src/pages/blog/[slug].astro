---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import BlogHeader from '../../components/BlogHeader.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter((post) => !post.data.draft);
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.(md|mdx)$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formatter = new Intl.DateTimeFormat('en', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});
---

<Base title={post.data.title} description={post.data.description}>
  <style>
    /* Post title — VHS halftone drop-shadow.
       Three layers, front-to-back:
         1. Letter (white, on top)
         2. Gap (the 6px offset between letter and shadow shows the
            page background through — the "nothing in between" the
            user asked for)
         3. Halftone red drop-shadow (the ::before pseudo-element)
       The pseudo duplicates the text via `content: attr(data-title)`
       and uses background-clip: text to clip a radial-gradient dot
       pattern (#dc2626 dots on a transparent grid) to the text shape.
       Result reads as a chunky halftone-print red shadow rather than
       a flat color shadow. letter-spacing keeps the per-character gaps
       from the previous version. */
    .post-title-vhs {
      position: relative;
      letter-spacing: 1px;
      isolation: isolate;            /* own stacking context so z-index works locally */
    }
    .post-title-vhs::before {
      content: attr(data-title);
      position: absolute;
      top: 6px;                      /* offset puts visible "gap" between letter and shadow */
      left: 6px;
      width: 100%;
      letter-spacing: inherit;
      font: inherit;
      /* Radial-gradient halftone: 1.4px red dots on a 4px grid. The
         gap-to-dot ratio + size determines how "dotty" it reads — bump
         dot size for more saturated, shrink for more sparse. */
      background-image: radial-gradient(circle, #dc2626 1.4px, transparent 1.8px);
      background-size: 4px 4px;
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      color: transparent;
      z-index: -1;                   /* behind the actual H1 text */
      pointer-events: none;
    }
  </style>

  <BlogHeader />

  <main class="min-h-svh bg-black text-white antialiased isolate">
    <article class="max-w-5xl mx-auto px-6 py-12 sm:py-20">
      <header class:list={[
        'max-w-3xl pb-10 border-b border-white/10',
        post.data.template === 'guide' ? 'border-[#dc2626]/30' : '',
      ]}>
        <p class="text-white/40 text-xs uppercase tracking-widest mb-4">{formatter.format(post.data.pubDate)}</p>
        <h1 class="post-title-vhs text-4xl sm:text-6xl text-pretty mb-5" data-title={post.data.title}>{post.data.title}</h1>
        <p class="text-gray-300 text-base sm:text-lg leading-8">{post.data.description}</p>
      </header>

      {post.data.image && (
        <!-- Hero image — sits between the header and the body content.
             max-w matches the prose column width so it doesn't blow the
             reading rhythm. Lazy-loaded since it's below the LCP fold. -->
        <figure class="max-w-3xl mt-10">
          <img src={post.data.image} alt="" loading="lazy"
            class="w-full aspect-video object-cover bg-[#141214] border border-white/10" />
        </figure>
      )}

      <div class="prose vhs-prose max-w-[72ch] mt-10">
        <Content />
      </div>
    </article>
  </main>
</Base>
