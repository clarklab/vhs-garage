---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import BlogHeader from '../../components/BlogHeader.astro';

// Lists all blog posts that opted in via `hasVideo: true` in their
// frontmatter. Same card layout as the category archive pages.
const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft && p.data.hasVideo)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const formatter = new Intl.DateTimeFormat('en', {
  month: 'long', day: 'numeric', year: 'numeric',
});
const getSlug = (id: string) => id.replace(/\.(md|mdx)$/, '');
---

<Base
  title="Videos — VHS Garage Blog"
  description="Blog posts that include video — captures, screenshares, and embedded clips."
>
  <BlogHeader />

  <main class="min-h-svh bg-black text-white antialiased isolate">
    <section class="max-w-5xl mx-auto px-6 py-16 sm:py-24">
      <div class="max-w-3xl">
        <p class="text-white/40 text-xs uppercase tracking-widest mb-4">Filter</p>
        <h1 class="text-4xl sm:text-6xl text-pretty mb-5">Videos</h1>
        <p class="text-gray-300 text-base sm:text-lg leading-8 max-w-2xl">
          Every blog post that includes a video — captured tape, screencast, or embedded clip.
        </p>
      </div>

      {posts.length === 0 && (
        <p class="mt-14 text-white/40 text-sm">No video posts yet.</p>
      )}

      <div class="mt-14 grid gap-5">
        {posts.map((post) => (
          <a href={`/blog/${getSlug(post.id)}`} class="group flex flex-col sm:flex-row gap-5 border border-white/15 p-5 hover:border-white/35 transition-colors">
            <div class="shrink-0 sm:w-56 aspect-video bg-[#141214] border border-white/10 overflow-hidden">
              {post.data.image ? (
                <img src={post.data.image} alt="" loading="lazy"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
              ) : (
                <div class="w-full h-full flex items-center justify-center text-white/15 text-xl tracking-widest">░ ▓ ░</div>
              )}
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-white/35 text-xs uppercase tracking-widest mb-2">{formatter.format(post.data.pubDate)}</p>
              <h2 class="text-2xl sm:text-3xl mb-3 group-hover:text-[#dc2626] transition-colors">{post.data.title}</h2>
              <p class="text-gray-400 text-base leading-7">{post.data.description}</p>
            </div>
          </a>
        ))}
      </div>
    </section>
  </main>
</Base>
