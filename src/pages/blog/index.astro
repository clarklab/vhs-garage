---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import BlogHeader from '../../components/BlogHeader.astro';
import Footer from '../../components/Footer.astro';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const formatter = new Intl.DateTimeFormat('en', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});

const getSlug = (id: string) => id.replace(/\.(md|mdx)$/, '');
---

<Base
  title="Blog"
  description="Dispatches from VHS Garage: analog video, real-life events, capture guides, and garage updates."
>
  <BlogHeader />

  <main class="min-h-svh bg-black text-white antialiased isolate">
    <section class="max-w-5xl mx-auto px-6 py-16 sm:py-24">
      <div class="max-w-3xl">
        <p class="text-white/40 text-xs uppercase tracking-widest mb-4">Garage Dispatches</p>
        <h1 class="text-4xl sm:text-6xl text-pretty mb-5">The VHS Garage Blog</h1>
        <p class="text-gray-300 text-base sm:text-lg leading-8 max-w-2xl">
          Notes from the workbench: VHS events, capture workflows, YouTube posting tips, merch drops, and whatever else crawls out of the tape stack.
        </p>
      </div>

      <!-- Index list — each post is a horizontal row: 16:9 thumbnail on
           the left, title/description on the right. Posts without an
           image render a hatched placeholder so rows stay aligned. The
           whole row is a single link target so click-anywhere works. -->
      <div class="mt-14 grid gap-5">
        {posts.map((post) => (
          <a href={`/blog/${getSlug(post.id)}`} class="group flex flex-col sm:flex-row gap-5 border border-white/15 p-5 hover:border-white/35 transition-colors">
            <div class="shrink-0 sm:w-56 aspect-video bg-[#141214] border border-white/10 overflow-hidden">
              {post.data.image ? (
                <img src={post.data.image} alt="" loading="lazy"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
              ) : (
                <div class="w-full h-full flex items-center justify-center text-white/15 text-xl tracking-widest">░ ▓ ░</div>
              )}
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-white/35 text-xs uppercase tracking-widest mb-2">{formatter.format(post.data.pubDate)}</p>
              <h2 class="text-2xl sm:text-3xl mb-3 group-hover:text-[#dc2626] transition-colors">{post.data.title}</h2>
              <p class="text-gray-400 text-base leading-7">{post.data.description}</p>
            </div>
          </a>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</Base>
