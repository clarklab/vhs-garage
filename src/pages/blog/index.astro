---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const formatter = new Intl.DateTimeFormat('en', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});

const getSlug = (id: string) => id.replace(/\.(md|mdx)$/, '');
---

<Base
  title="Blog"
  description="Dispatches from VHS Garage: analog video, real-life events, capture guides, and garage updates."
>
  <main class="min-h-svh bg-black text-white antialiased isolate">
    <section class="max-w-5xl mx-auto px-6 py-16 sm:py-24">
      <a href="/" class="text-[#39ff14] text-xs hover:underline">← VHS Garage</a>
      <div class="mt-8 max-w-3xl">
        <p class="text-white/40 text-xs uppercase tracking-widest mb-4">Garage Dispatches</p>
        <h1 class="text-4xl sm:text-6xl text-pretty mb-5">The VHS Garage Blog</h1>
        <p class="text-gray-300 text-base sm:text-lg leading-8 max-w-2xl">
          Notes from the workbench: VHS events, capture workflows, YouTube posting tips, merch drops, and whatever else crawls out of the tape stack.
        </p>
      </div>

      <div class="mt-14 grid gap-5">
        {posts.map((post) => (
          <article class="border border-white/15 p-5 hover:border-white/35 transition-colors">
            <p class="text-white/35 text-xs uppercase tracking-widest mb-3">{formatter.format(post.data.pubDate)}</p>
            <h2 class="text-2xl sm:text-3xl mb-3">
              <a href={`/blog/${getSlug(post.id)}`} class="hover:text-[#39ff14] transition-colors">{post.data.title}</a>
            </h2>
            <p class="text-gray-400 text-base leading-7 max-w-3xl">{post.data.description}</p>
            <a href={`/blog/${getSlug(post.id)}`} class="inline-flex mt-5 text-[#39ff14] text-xs hover:underline">Read the post →</a>
          </article>
        ))}
      </div>
    </section>
  </main>
</Base>
