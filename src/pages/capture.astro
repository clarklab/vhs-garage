---
import Base from '../layouts/Base.astro';
import { BUILD_ID } from '../utils/build-id.js';
---

<Base title="Capture" description="A browser-based VHS digitization station.">

  <!-- OverlayScrollbars CSS — base styles for the DOM-rendered scrollbars
       that replace native ones inside scrollable columns. The custom theme
       (.os-theme-vhs) is defined in the <style> block below; the JS that
       attaches it lives in /scripts/capture/app.js. -->
  <link slot="head" rel="stylesheet" href="/vendor/overlayscrollbars/overlayscrollbars.min.css">

  <style>
    .rec-btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 8px 18px;
      border: 2px solid #e53935;
      background: transparent;
      cursor: pointer;
      transition: background 0.2s;
    }
    .rec-btn:hover { background: rgba(229, 57, 53, 0.1); }

    /* Library button mirrors .rec-btn geometry (same padding, border weight,
       font size, letter-spacing) but in neutral white — gives the two primary
       deck buttons a matched pair. */
    .lib-btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 8px 18px;
      border: 2px solid rgba(255, 255, 255, 0.3);
      background: transparent;
      cursor: pointer;
      transition: background 0.2s, border-color 0.2s, color 0.2s;
      color: rgba(255, 255, 255, 0.6);
      font-family: 'VCR', monospace;
      font-size: 14px;
      font-weight: bold;
      letter-spacing: 0.08em;
    }
    .lib-btn:hover {
      color: rgba(255, 255, 255, 0.9);
      border-color: rgba(255, 255, 255, 0.6);
      background: rgba(255, 255, 255, 0.05);
    }
    /* Tailwind's .hidden utility (display: none) is loaded BEFORE this page's
       <style> block, so .lib-btn { display: inline-flex } was winning the
       cascade and the Delete button stayed visible even with `hidden` in its
       class list. Add an explicit override at this layer so `.hidden` wins
       again — fixes the delete button leaking into the live-preview state. */
    .lib-btn.hidden { display: none; }
    .lib-btn svg {
      width: 24px;
      height: 24px;
      fill: currentColor;
    }

    /* Chunky pixel-corner treatment shared by outlined control buttons.
       A 2px step is clipped out of each corner so the outline reads as
       a slightly stair-stepped, VCR-ish silhouette rather than a sharp
       rectangle — the corner radius looks "pixelated" rather than smooth. */
    .pixel-btn {
      --p: 2px;
      clip-path: polygon(
        0 var(--p),
        var(--p) var(--p),
        var(--p) 0,
        calc(100% - var(--p)) 0,
        calc(100% - var(--p)) var(--p),
        100% var(--p),
        100% calc(100% - var(--p)),
        calc(100% - var(--p)) calc(100% - var(--p)),
        calc(100% - var(--p)) 100%,
        var(--p) 100%,
        var(--p) calc(100% - var(--p)),
        0 calc(100% - var(--p))
      );
    }
    .rec-btn .rec-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: #e53935;
    }
    .rec-btn .rec-label {
      font-family: 'VCR', monospace;
      font-size: 14px;
      font-weight: bold;
      color: #e53935;
      letter-spacing: 0.08em;
    }
    .rec-btn.recording .rec-dot {
      animation: rec-blink 0.8s steps(1) infinite;
    }
    @keyframes rec-blink {
      0%, 100% { opacity: 1; }
      50% { opacity: 0; }
    }
    .ai-loader::after {
      content: '░░░░░▒▓█░';
      animation: ai-scan 1.2s steps(1) infinite;
    }
    @keyframes ai-scan {
      0%   { content: '░░░░░▒▓█░'; }
      12%  { content: '█░░░░░▒▓█'; }
      25%  { content: '▓█░░░░░▒▓'; }
      37%  { content: '▒▓█░░░░░▒'; }
      50%  { content: '░▒▓█░░░░░'; }
      62%  { content: '░░▒▓█░░░░'; }
      75%  { content: '░░░▒▓█░░░'; }
      87%  { content: '░░░░▒▓█░░'; }
    }
    #preview-container.recording-active {
      border: 3px solid #e53935;
      box-shadow: inset 0 0 30px rgba(229, 57, 53, 0.15);
    }
    #rec-overlay-timer {
      font-size: 2rem;
      letter-spacing: 0.05em;
    }
    @keyframes scan-trace {
      0% { background-position: 0% 0%; }
      100% { background-position: 300% 0%; }
    }
    #sleeve-target .scan-border {
      transition: border-color 0.3s, box-shadow 0.3s;
    }
    #sleeve-target .scan-border.scanning {
      box-shadow: 0 0 12px rgba(34,197,94,0.3), inset 0 0 12px rgba(34,197,94,0.1);
      animation: scan-pulse 1.5s ease-in-out infinite;
    }
    @keyframes scan-pulse {
      0%, 100% { box-shadow: 0 0 8px rgba(34,197,94,0.2), inset 0 0 8px rgba(34,197,94,0.05); }
      50% { box-shadow: 0 0 18px rgba(34,197,94,0.5), inset 0 0 18px rgba(34,197,94,0.15); }
    }
    /* Library window "shoop" — opens from below + grows in scale + fades in,
       like a real OS window animating into place. Animation is applied to
       the inner chrome (the bordered box) rather than the outer position
       wrapper so it doesn't fight the centering / drag transforms. */
    @keyframes lib-shoop {
      from {
        opacity: 0;
        transform: translateY(28px) scale(0.92);
      }
      to {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }
    .library-shoop-in {
      animation: lib-shoop 240ms cubic-bezier(0.2, 0.9, 0.3, 1.1);
      transform-origin: center bottom;
    }

    /* Old-school chunky scrollbar — full VHS Garage theme for
       OverlayScrollbars. Earlier CSS-only approaches (::-webkit-scrollbar +
       scrollbar-width) can't beat macOS's "Show scroll bars: Always"
       system setting — the OS draws native bars on top regardless. We
       switched to the OverlayScrollbars JS library, which removes native
       bars from the layout and renders DOM-based bars instead.

       NOTE: OverlayScrollbars v2.x ships ONLY the core CSS — the bundled
       themes (os-theme-dark / os-theme-light) of the v1 series are gone, so
       a custom theme has to provide real dimensions and background colors.
       Just declaring CSS variables like --os-handle-bg does nothing in v2;
       the core CSS doesn't reference them. We target the scrollbar elements
       directly. The `theme: 'os-theme-vhs'` option in app.js stamps the
       class on each .os-scrollbar element. */

    /* (OverlayScrollbars theme rules moved to the <style is:global> block
       below — they target elements created by the OverlayScrollbars JS,
       which never carry the Astro scope class.) */

    /* Make the trigger look "pressed" when its menu is open. The static
       toolbar buttons live in markup so a scoped rule reaches them. */
    .toolbar-trigger.is-active {
      background: rgba(255, 255, 255, 0.06);
      color: rgba(255, 255, 255, 0.95);
    }
  </style>

  <!-- Global block for CSS that targets dynamically-created elements.
       Astro's default <style> blocks are scoped via :where(.astro-XXXX),
       which only matches elements that have the scope class attached at
       compile time. Anything created in JS (toolbar menu items, the
       OverlayScrollbars-rendered scrollbar / track / handle elements) is
       missing that class, so scoped rules silently fail to apply. Keep
       these rules global so they reach those runtime-built nodes. -->
  <style is:global>
    /* OverlayScrollbars VHS theme. Driven entirely by the library's own CSS
       variables (defined in overlayscrollbars.css around the .os-scrollbar
       selector ~line 516). The library consumes them like:
         .os-scrollbar-vertical   { width: var(--os-size); }
         .os-scrollbar-horizontal { height: var(--os-size); }
         .os-scrollbar-vertical .os-scrollbar-handle   { width:  var(--os-handle-perpendicular-size); min-height: var(--os-handle-min-size); }
         .os-scrollbar-horizontal .os-scrollbar-handle { height: var(--os-handle-perpendicular-size); min-width:  var(--os-handle-min-size); }
       Setting them in the theme is the correct way to size and color the
       bars; previous attempts that overrode width / min-width directly
       were fighting these variable rules and inflating the handle to a
       solid red strip. */
    .os-scrollbar.os-theme-vhs {
      /* 6px channel for both orientations. */
      --os-size: 6px;
      /* No padding around the handle — it fills the channel edge-to-edge. */
      --os-padding-perpendicular: 0;
      --os-padding-axis: 0;
      /* Dark gutter / channel. */
      --os-track-bg: #141214;
      --os-track-bg-hover: #141214;
      --os-track-bg-active: #141214;
      --os-track-border-radius: 0;
      /* Red handle ("scrubber") with hover/active brighter red. */
      --os-handle-bg: #dc2626;
      --os-handle-bg-hover: #ef4444;
      --os-handle-bg-active: #ef4444;
      --os-handle-border-radius: 0;
      /* Floor for the handle's scroll-axis size so it never collapses
         to nothing on very short tracks. */
      --os-handle-min-size: 40px;
      /* Handle fills the full 6px perpendicular to the scroll axis. */
      --os-handle-perpendicular-size: 100%;
      --os-handle-perpendicular-size-hover: 100%;
      --os-handle-perpendicular-size-active: 100%;
    }
    /* Override the library's dynamic handle sizing. By default
       OverlayScrollbars sets the handle's scroll-axis dimension to
       `calc(var(--os-viewport-percent) * 100%)` — a viewport/content
       ratio it updates live (it's declared @property). When content
       barely overflows that ratio approaches 1.0 and the handle inflates
       to fill the entire track. We don't want a "you've scrolled X%"
       indicator, just a chunky pill — pin it to a fixed 10% of the
       track. The min-size variable above still applies as a floor. */
    .os-scrollbar.os-theme-vhs.os-scrollbar-vertical .os-scrollbar-handle {
      height: 10%;
    }
    .os-scrollbar.os-theme-vhs.os-scrollbar-horizontal .os-scrollbar-handle {
      width: 10%;
    }

    /* Classic 80s/90s desktop drop-down menu (System 7 / Win 3.1 vibe) for
       the top toolbar segments. Single shared host element (#toolbar-menu)
       gets populated on each open by openToolbarMenu in app.js — opening a
       different segment swaps the items in place. The chiseled bevel is
       1px white-alpha highlight on top+left and 1px black on bottom+right,
       which reads as a "raised" panel; the chunky drop shadow under it is
       the same trick we use on the library context menu. */
    .toolbar-menu {
      position: fixed;
      z-index: 60;
      min-width: 220px;
      max-width: 360px;
      background: #1a181a;
      color: rgba(255, 255, 255, 0.85);
      font-family: 'VCR', monospace;
      font-size: 11px;
      line-height: 1.2;
      padding: 4px 0;
      user-select: none;
      /* Chiseled bevel: white highlight on top+left, black shadow on bot+right.
         Box-shadow stack: inset highlights/shadows + a chunky 2px outer drop
         shadow to mimic the dropped-paper feel of vintage menus. */
      box-shadow:
        inset 1px 1px 0 0 rgba(255, 255, 255, 0.18),
        inset -1px -1px 0 0 rgba(0, 0, 0, 0.85),
        2px 2px 0 0 rgba(0, 0, 0, 0.6);
      border: 1px solid #000;
      box-sizing: border-box;
    }
    .toolbar-menu-item {
      display: flex;
      align-items: center;
      width: 100%;
      box-sizing: border-box;
      padding: 7px 14px 7px 26px;
      background: transparent;
      border: 0;
      color: inherit;
      font: inherit;
      text-align: left;
      cursor: pointer;
      position: relative;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    /* Hover = inverse video, the System 7 hallmark. Red instead of the
       Mac OS blue to keep us in the VHS Garage palette. */
    .toolbar-menu-item:hover {
      background: #dc2626;
      color: #fff;
    }
    .toolbar-menu-item.is-checked::before {
      content: '✓';
      position: absolute;
      left: 9px;
      top: 50%;
      transform: translateY(-50%);
      color: rgba(255, 255, 255, 0.75);
      font-size: 10px;
    }
    .toolbar-menu-item.is-checked:hover::before {
      color: #fff;
    }
    .toolbar-menu-item.is-disabled {
      color: rgba(255, 255, 255, 0.3);
      cursor: default;
      pointer-events: none;
    }
    .toolbar-menu-divider {
      height: 1px;
      margin: 4px 6px;
      background: rgba(0, 0, 0, 0.7);
      box-shadow: 0 1px 0 0 rgba(255, 255, 255, 0.08);
    }
    /* Section header (non-clickable label, e.g. the current folder name at
       the top of the DIR menu). */
    .toolbar-menu-header {
      padding: 5px 14px 4px 14px;
      font-size: 9px;
      letter-spacing: 0.08em;
      color: rgba(255, 255, 255, 0.35);
      text-transform: uppercase;
    }

    /* Upload toast cards — bottom-right stacked notification system. Plain
       1px border (no bevel/inset shadows), dark background, monospace
       VCR font (inherited from the stack container). Each toast is a
       320px card; multiple stack vertically with gap-2 between them.
       Border color flips for success (green) and error (red) states. */
    .toast-card {
      width: 320px;
      background: #1a181a;
      border: 1px solid #333;
      color: rgba(255, 255, 255, 0.85);
      padding: 10px 12px;
      font-size: 11px;
      pointer-events: auto;
      display: flex;
      flex-direction: column;
      gap: 6px;
      transform: translateX(8px);
      opacity: 0;
      transition: transform 0.18s ease-out, opacity 0.18s ease-out;
    }
    .toast-card.is-visible {
      transform: translateX(0);
      opacity: 1;
    }
    .toast-card.is-success { border-color: #16a34a; }
    .toast-card.is-error   { border-color: #dc2626; }

    .toast-title-row {
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .toast-title {
      flex: 1;
      color: #fff;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      font-size: 11px;
    }
    .toast-state-label {
      font-size: 9px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: rgba(255, 255, 255, 0.5);
      white-space: nowrap;
    }
    .toast-card.is-success .toast-state-label { color: #4ade80; }
    .toast-card.is-error   .toast-state-label { color: #f87171; }

    .toast-close-btn,
    .toast-retry-btn {
      width: 18px;
      height: 18px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: transparent;
      border: 0;
      color: rgba(255, 255, 255, 0.4);
      cursor: pointer;
      transition: color 0.15s;
      padding: 0;
      font-size: 12px;
      line-height: 1;
    }
    .toast-close-btn:hover,
    .toast-retry-btn:hover { color: #fff; }

    .toast-progress-track {
      height: 3px;
      background: rgba(255, 255, 255, 0.08);
      overflow: hidden;
    }
    .toast-progress-bar {
      height: 100%;
      width: 0%;
      background: #dc2626;
      transition: width 0.2s linear;
    }

    .toast-meta-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      font-size: 10px;
      color: rgba(255, 255, 255, 0.55);
    }
    .toast-link {
      color: #f87171;
      text-decoration: none;
      font-size: 11px;
    }
    .toast-link:hover { color: #fca5a5; }
    .toast-secondary-link {
      color: rgba(255, 255, 255, 0.4);
      text-decoration: underline;
      text-underline-offset: 2px;
      font-size: 10px;
      background: transparent;
      border: 0;
      cursor: pointer;
      padding: 0;
      font-family: inherit;
    }
    .toast-secondary-link:hover { color: rgba(255, 255, 255, 0.85); }

    .toast-error-msg {
      color: #fca5a5;
      font-size: 10px;
      line-height: 1.35;
      white-space: pre-line;
    }

    /* Library batch-selection mode. Tiles created by renderLibrary() in
       library.js add a small checkbox indicator at the top-left of the
       thumbnail when selectionMode is on. Style is the same chunky pixel
       aesthetic as the rest of the UI. */
    .library-checkbox {
      position: absolute;
      top: 4px;
      left: 4px;
      width: 16px;
      height: 16px;
      background: rgba(0, 0, 0, 0.7);
      border: 1px solid rgba(255, 255, 255, 0.6);
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      font-size: 12px;
      line-height: 1;
      pointer-events: none;
      z-index: 4;
    }
    .library-checkbox.is-checked {
      background: #dc2626;
      border-color: #dc2626;
    }
    .library-card.is-selected {
      outline: 2px solid #dc2626;
      outline-offset: -2px;
    }
    /* Uploaded tiles in selection mode get dimmed since they can't be
       added to a batch (they're already up). */
    .library-card.is-uploaded-in-selection {
      opacity: 0.4;
      cursor: default;
    }
    /* Counter button in the library titlebar — gets red and glowy once
       at least one clip is selected. */
    #library-upload-many-btn.is-active {
      background: #dc2626;
      border-color: #dc2626;
      color: #fff;
    }
    #library-upload-many-btn.is-active:hover {
      background: #ef4444;
      border-color: #ef4444;
    }

    /* Char counter under YouTube-bound text fields. Subtle by default,
       turns yellow at 90% of the limit, red at 100%. wireCharCounters()
       in app.js manages the count text + at-limit class. */
    .char-counter {
      font-size: 9px;
      color: rgba(255, 255, 255, 0.3);
      text-align: right;
      margin-top: 2px;
      letter-spacing: 0.04em;
      tabular-nums: true;
      font-variant-numeric: tabular-nums;
      pointer-events: none;
    }
    .char-counter.is-warn { color: #fbbf24; }
    .char-counter.is-max  { color: #f87171; }
  </style>

  <!-- Browser check -->
  <div id="browser-check" class="hidden fixed inset-0 z-50 bg-black flex items-center justify-center p-8">
    <div class="max-w-md text-center">
      <p class="text-2xl mb-4">VHS Capture requires Chrome</p>
      <p class="text-gray-400 text-sm">This app uses the File System Access API to write recordings directly to disk. This API is only available in Chrome.</p>
    </div>
  </div>

  <!-- Three-column grid + status bar. Status bar runs edge-to-edge along
       the TOP of the viewport (retro-OS title strip vibe — the natural place
       for app-level status + future settings) and is a sibling of the
       padded content wrapper below. -->
  <div id="capture-app" class="h-screen flex flex-col">
    <!-- Top status bar — full viewport width, locked to the top, styled
         like a classic desktop-software title strip: thin bottom border,
         segment dividers, bold logo on the left, clickable device segments
         in the middle, help on the right. -->
    <div id="status-bar" class="flex items-stretch text-[10px] text-white/60 border-b border-white/20 bg-[#141214] shrink-0 select-none py-[5px]" style="box-shadow: inset 0 -1px 0 rgba(255,255,255,0.04);">
      <!-- Logo (decorative) -->
      <div class="flex items-center gap-2 px-3 py-2 border-r border-white/15 shrink-0">
        <span class="inline-block w-1.5 h-1.5 bg-red-500" style="box-shadow: 0 0 6px rgba(229,57,53,0.6);"></span>
        <span class="text-white/80 font-bold tracking-[0.15em] uppercase">VHS Garage Recorder</span>
      </div>

      <!-- Status segments — each is its own click target that opens an
           anchored drop-down menu in the classic Mac System 7 / Win 3.1
           style (via openToolbarMenu in app.js). The dropdowns let you
           pick a device or folder right from the bar without diving into
           the full Device Settings modal — that modal is still available
           as the last item in each menu for the bigger view. -->
      <button id="status-vid-trigger" class="toolbar-trigger flex items-center gap-1.5 px-3 py-2 border-r border-white/10 min-w-0 hover:text-white/80 transition-colors text-left" title="Capture video source">
        <span class="text-white/40 uppercase tracking-wider shrink-0">VID</span>
        <span id="status-video-label" class="truncate text-white/70" style="max-width:140px;">—</span>
        <span id="status-video-dot" class="shrink-0" style="color:#f44336;">░</span>
        <span class="text-white/30 text-[8px] shrink-0" aria-hidden="true">▾</span>
      </button>
      <button id="status-aud-trigger" class="toolbar-trigger flex items-center gap-1.5 px-3 py-2 border-r border-white/10 min-w-0 hover:text-white/80 transition-colors text-left" title="Capture audio source">
        <span class="text-white/40 uppercase tracking-wider shrink-0">AUD</span>
        <span id="status-audio-label" class="truncate text-white/70" style="max-width:120px;">—</span>
        <span id="status-audio-dot" class="shrink-0" style="color:#f44336;">░</span>
        <span class="text-white/30 text-[8px] shrink-0" aria-hidden="true">▾</span>
      </button>
      <button id="status-cam-trigger" class="toolbar-trigger flex items-center gap-1.5 px-3 py-2 border-r border-white/10 min-w-0 hover:text-white/80 transition-colors text-left" title="Webcam (sleeve photos)">
        <span class="text-white/40 uppercase tracking-wider shrink-0">CAM</span>
        <span id="status-webcam-label" class="truncate text-white/70" style="max-width:100px;">—</span>
        <span id="status-webcam-dot" class="shrink-0" style="color:#f44336;">░</span>
        <span class="text-white/30 text-[8px] shrink-0" aria-hidden="true">▾</span>
      </button>
      <button id="status-dir-trigger" class="toolbar-trigger flex-1 flex items-center gap-1.5 px-3 py-2 min-w-0 hover:text-white/80 transition-colors text-left" title="Save folder">
        <span class="text-white/40 uppercase tracking-wider shrink-0">DIR</span>
        <span id="status-dir-label" class="truncate text-white/70">No save folder</span>
        <span class="text-white/30 text-[8px] shrink-0 ml-auto pl-2" aria-hidden="true">▾</span>
      </button>

      <!-- Help -->
      <button id="help-btn" class="flex items-center justify-center px-3 py-2 border-l border-white/15 text-white/50 hover:text-white/80 transition-colors shrink-0" title="Help &amp; shortcuts">
        <span class="inline-flex items-center justify-center w-4 h-4 border border-white/40 text-[9px] leading-none" style="border-radius:50%;">?</span>
      </button>

      <!-- Demo: scripted "player piano" run-through of a full capture
           session using files in /public/puppet/. Used for new-user
           orientation and social/marketing capture. Sits before Legal so
           it reads as a normal app menu, not an admin/legal item. -->
      <button id="status-demo-trigger" class="toolbar-trigger flex items-center gap-1.5 px-3 py-2 border-l border-white/15 shrink-0 text-white/50 hover:text-white/80 transition-colors" title="Run a sample demo">
        <span class="uppercase tracking-wider">Demo</span>
        <span class="text-white/30 text-[8px]" aria-hidden="true">▾</span>
      </button>

      <!-- Legal: opens a small menu with links to the terms + privacy
           pages on vhsgarage.com. Sits last so it reads like the "About"
           position in classic desktop apps. -->
      <button id="status-legal-trigger" class="toolbar-trigger flex items-center gap-1.5 px-3 py-2 border-l border-white/15 shrink-0 text-white/50 hover:text-white/80 transition-colors" title="Terms &amp; privacy">
        <span class="uppercase tracking-wider">Legal</span>
        <span class="text-white/30 text-[8px]" aria-hidden="true">▾</span>
      </button>
    </div>

    <!-- Content area: full-width, no max-width / centering — columns own the
         page edge-to-edge so each gets all the horizontal room. -->
    <div class="flex-1 min-h-0 flex flex-col">
    <div class="flex-1 grid md:grid-cols-[1fr_320px] lg:grid-cols-[1fr_300px_320px] min-h-0">

      <!-- Column 1: Live preview + recording controls. Plain div, no outer
           border — the column dividers (border-l on cols 2 and 3) are the
           only verticals between sections. -->
      <div class="flex flex-col min-h-0 p-4">
        <!-- Source toggle. Both Live and Last Recording render; playback
             stays hidden until a recording exists. Sits at the column top
             as a plain header strip (was a fieldset legend before). -->
        <div id="preview-legend" class="text-[11px] tracking-wider leading-none flex items-center gap-3 mb-3">
          <button id="tab-live" type="button" class="text-white/70 transition-colors leading-none">░ Live Feed ░</button>
          <button id="tab-playback" type="button" class="hidden text-white/30 hover:text-white/70 transition-colors leading-none">░ Last Recording ░</button>
        </div>
          <!-- Preview -->
          <div id="preview-container" class="relative flex-1 bg-[#141214] border border-white/10 overflow-hidden cursor-pointer">
            <video id="preview" autoplay playsinline muted class="w-full h-full object-contain bg-black"></video>
            <video id="playback" controls class="hidden w-full h-full object-contain bg-black"></video>
            <div id="rec-overlay-timer" class="hidden absolute top-3 right-4 text-red-500 tabular-nums z-10" style="text-shadow: 0 0 10px rgba(229,57,53,0.7), 0 0 20px rgba(229,57,53,0.4);">
              00:00:00
            </div>
            <!-- Shown when no capture device is selected. The pixel icon
                 is video-camera-solid from @hackernoon/pixel-icon-library
                 (icons/SVG/solid/video-camera-solid.svg) inlined so it
                 picks up the dimmed white tint from the parent. -->
            <div id="no-signal" class="absolute inset-0 flex items-center justify-center">
              <div class="text-center text-white/15">
                <svg class="mx-auto mb-3 fill-current" width="56" height="56" viewBox="0 0 24 24" aria-hidden="true">
                  <polygon points="15 7 16 7 16 17 15 17 15 19 3 19 3 18 2 18 2 17 1 17 1 7 2 7 2 6 3 6 3 5 15 5 15 7"/>
                  <polygon points="23 7 23 17 22 17 22 18 21 18 21 17 20 17 20 16 19 16 19 15 18 15 18 9 19 9 19 8 20 8 20 7 21 7 21 6 22 6 22 7 23 7"/>
                </svg>
                <p class="text-white/50 text-sm mb-1">No capture device</p>
                <p class="text-white/30 text-[10px] uppercase tracking-wider">Click to select</p>
              </div>
            </div>
            <!-- Inline device selector (hidden by default) -->
            <div id="device-selector" class="hidden absolute inset-0 bg-black/90 flex items-center justify-center">
              <div class="w-64">
                <p class="text-sm mb-3">Select capture device</p>
                <select id="select-video" class="w-full bg-black border border-white/30 text-white text-xs p-2 mb-2"></select>
                <select id="select-audio" class="w-full bg-black border border-white/30 text-white text-xs p-2 mb-3"></select>
                <button id="select-video-ok" class="w-full py-2 border border-white/30 text-white/60 hover:text-white text-xs">Connect</button>
              </div>
            </div>
          </div>

          <!-- Audio spectrum meter -->
          <canvas id="audio-meter" class="w-full h-6 mt-0" style="image-rendering: pixelated;"></canvas>

          <!-- Controls below preview -->
          <div class="flex items-center gap-3 py-2">
            <button id="rec-btn" class="rec-btn pixel-btn shrink-0" title="Record">
              <span class="rec-dot"></span><span class="rec-label">REC</span>
            </button>
            <button id="mute-btn" class="shrink-0 text-white/40 hover:text-white/70 transition-colors" title="Toggle audio">
              <svg id="mute-icon-on" class="w-5 h-5 hidden" viewBox="0 0 24 24" fill="currentColor"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/></svg>
              <svg id="mute-icon-off" class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z"/></svg>
            </button>
            <span id="rec-timer" class="text-lg tabular-nums">00:00:00</span>
            <span id="rec-size" class="text-xs text-white/40">0.0 MB</span>
            <div class="flex-1"></div>
            <!-- Save Data + Publish to YouTube were here; both retired since
                 sidebar auto-saves Clip Info on every keystroke and the
                 Publish flow lives inline in column 3 now. -->
            <button id="delete-recording-btn" class="lib-btn pixel-btn shrink-0 hidden" title="Delete this recording">
              <!-- Trash icon from @hackernoon/pixel-icon-library
                   (icons/SVG/regular/trash.svg) -->
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="m4,6v8h1v8h1v1h12v-1h1v-8h1V6H4Zm14,7h-1v8H7v-8h-1v-5h12v5Z"/>
                <polygon points="21 3 21 5 3 5 3 3 4 3 4 2 9 2 9 1 15 1 15 2 20 2 20 3 21 3"/>
              </svg>
              Delete
            </button>
            <!-- Trim button — same hidden-until-playback pattern as Delete.
                 Icon is page-break.svg from @hackernoon/pixel-icon-library
                 (icons/SVG/regular/page-break.svg) rotated 90deg so the
                 horizontal page-break lines become vertical "cut here / cut
                 here" brackets — visually reads as trim handles. -->
            <button id="trim-recording-btn" class="lib-btn pixel-btn shrink-0 hidden" title="Trim this recording">
              <svg viewBox="0 0 24 24" aria-hidden="true" style="transform: rotate(90deg);">
                <polygon points="3 8 3 1 5 1 5 6 19 6 19 1 21 1 21 8 3 8"/>
                <rect x="1" y="11" width="5" height="2"/>
                <rect x="10" y="11" width="4" height="2"/>
                <polygon points="21 16 21 23 19 23 19 18 5 18 5 23 3 23 3 16 21 16"/>
                <rect x="18" y="11" width="5" height="2"/>
              </svg>
              Trim
            </button>
            <button id="to-library-btn" class="lib-btn pixel-btn shrink-0" title="Library">
              <!-- Folder Open icon from @hackernoon/pixel-icon-library
                   (icons/SVG/regular/folder-open.svg) -->
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="m6,10v2h-1v2h-1v2h-1v2h-1v3h1v1h15v-1h1v-3h1v-2h1v-2h1v-2h1v-2H6Zm14,4h-1v2h-1v2h-1v2H4v-2h1v-2h1v-2h1v-2h13v2Z"/>
                <polygon points="20 5 20 9 18 9 18 6 9 6 9 5 8 5 8 4 3 4 3 14 2 14 2 16 1 16 1 3 2 3 2 2 9 2 9 3 10 3 10 4 19 4 19 5 20 5"/>
              </svg>
              Library
            </button>
          </div>

          <!-- Trim mode panel — hidden by default, revealed by the Trim
               button. Native `controls` on #playback are removed while
               this panel is open; the timeline + handles + play button
               here take over. ESC exits, Cancel reverts. The IN/OUT
               handles drive the time inputs (and vice versa); playback
               clamps to [in, out]. Save opens a modal where the user
               picks "Create new clip" (default) or "Trim original
               permanently"; the actual encode is real-time MediaRecorder
               (5-min clip = ~5-min encode) with a progress toast. -->
          <div id="trim-panel" class="hidden mt-2 px-2 py-2 border border-white/15 bg-[#0a090a]" style="font-family: 'VCR', monospace;">
            <!-- Custom timeline track. Position is %-based so it scales
                 with whatever width the column renders at. The dimmed
                 cross-hatched bands on either side show what's getting
                 cut — visual confirmation that beats the time numbers
                 alone. -->
            <div class="relative h-10 select-none mb-2" id="trim-timeline">
              <!-- Background track -->
              <div class="absolute inset-x-0 top-1/2 -translate-y-1/2 h-2 bg-white/10"></div>

              <!-- Trimmed-OUT region: left of IN handle (left dim band) -->
              <div id="trim-band-left"
                   class="absolute top-0 bottom-0 left-0 bg-black/50 pointer-events-none"
                   style="background-image: repeating-linear-gradient(45deg, transparent, transparent 4px, rgba(220,38,38,0.15) 4px, rgba(220,38,38,0.15) 8px); width: 0%;"></div>

              <!-- Trimmed-OUT region: right of OUT handle -->
              <div id="trim-band-right"
                   class="absolute top-0 bottom-0 right-0 bg-black/50 pointer-events-none"
                   style="background-image: repeating-linear-gradient(45deg, transparent, transparent 4px, rgba(220,38,38,0.15) 4px, rgba(220,38,38,0.15) 8px); width: 0%;"></div>

              <!-- KEPT region (between IN and OUT) — subtle red highlight
                   on the track so the kept range reads as the "active" band -->
              <div id="trim-band-kept"
                   class="absolute top-1/2 -translate-y-1/2 h-2 bg-[#dc2626]/40 pointer-events-none"
                   style="left: 0%; right: 0%;"></div>

              <!-- IN handle. The chunky vertical bar with a top/bottom
                   anchor block reads as a "grab handle" without needing
                   a label. cursor-ew-resize signals draggability. -->
              <div id="trim-handle-in"
                   class="absolute top-0 bottom-0 w-3 -translate-x-1/2 bg-[#dc2626] cursor-ew-resize hover:bg-[#ef4444] transition-colors"
                   style="left: 0%;"
                   role="slider" aria-label="Trim start" tabindex="0"></div>

              <!-- OUT handle -->
              <div id="trim-handle-out"
                   class="absolute top-0 bottom-0 w-3 -translate-x-1/2 bg-[#dc2626] cursor-ew-resize hover:bg-[#ef4444] transition-colors"
                   style="left: 100%;"
                   role="slider" aria-label="Trim end" tabindex="0"></div>

              <!-- Playhead — slim white line, no pointer events so the
                   handles + timeline scrub clicks can fire underneath. -->
              <div id="trim-playhead"
                   class="absolute top-0 bottom-0 w-px bg-white pointer-events-none"
                   style="left: 0%; box-shadow: 0 0 4px rgba(255,255,255,0.6);"></div>
            </div>

            <!-- Time inputs row. IN on the left, OUT on the right, the
                 current playhead position centered. Inputs accept loose
                 syntax: "90", "1:30", "0:01:30", "0:01:30.5" all parse. -->
            <div class="flex items-center justify-between gap-3 text-[11px] mb-2">
              <div class="flex items-center gap-2">
                <span class="text-white/40 uppercase tracking-wider text-[9px]">In</span>
                <input id="trim-in-input"
                       type="text"
                       value="0:00:00.0"
                       autocomplete="off"
                       spellcheck="false"
                       class="w-20 bg-transparent border border-white/20 px-2 py-1 text-white tabular-nums text-center focus:outline-none focus:border-[#dc2626]" />
              </div>

              <div class="flex items-center gap-2">
                <button id="trim-play-btn"
                        type="button"
                        class="inline-flex items-center gap-1.5 px-2.5 py-1 border border-white/30 text-white/80 hover:text-white hover:border-white/60 transition-colors">
                  <svg id="trim-play-icon" class="w-3 h-3 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                    <polygon points="5 3 5 21 7 21 7 19 9 19 9 17 11 17 11 15 13 15 13 13 15 13 15 11 17 11 17 9 15 9 15 7 13 7 13 5 11 5 11 3 9 3 9 1 7 1 7 3 5 3"/>
                  </svg>
                  <svg id="trim-pause-icon" class="hidden w-3 h-3 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                    <rect x="6" y="4" width="4" height="16"/>
                    <rect x="14" y="4" width="4" height="16"/>
                  </svg>
                  <span id="trim-play-label">Play</span>
                </button>
                <span id="trim-position" class="text-white/40 tabular-nums">0:00:00.0 / 0:00:00.0</span>
              </div>

              <div class="flex items-center gap-2">
                <span class="text-white/40 uppercase tracking-wider text-[9px]">Out</span>
                <input id="trim-out-input"
                       type="text"
                       value="0:00:00.0"
                       autocomplete="off"
                       spellcheck="false"
                       class="w-20 bg-transparent border border-white/20 px-2 py-1 text-white tabular-nums text-center focus:outline-none focus:border-[#dc2626]" />
              </div>
            </div>

            <!-- Action row -->
            <div class="flex items-center justify-between gap-3 pt-2 border-t border-white/10">
              <p class="text-white/40 text-[10px] uppercase tracking-wider">
                <kbd class="border border-white/15 px-1.5 py-0.5 text-white/60">Esc</kbd>
                <span class="ml-1">to cancel</span>
              </p>
              <div class="flex items-center gap-2">
                <button id="trim-cancel-btn"
                        type="button"
                        class="px-3 py-1.5 border border-white/30 text-white/70 hover:text-white text-[11px] uppercase tracking-wider transition-colors">
                  Cancel
                </button>
                <button id="trim-save-btn"
                        type="button"
                        class="px-3 py-1.5 bg-[#dc2626] hover:bg-[#ef4444] text-white text-[11px] uppercase tracking-wider transition-colors">
                  Save Trim
                </button>
              </div>
            </div>
          </div>
      </div>

      <!-- Columns 2+3: stacked at md, side-by-side at lg -->
      <div class="md:flex md:flex-col md:gap-3 md:min-h-0 md:overflow-y-auto lg:contents">

        <!-- Column 2: VHS Sleeve (top) + Thumbnail picker (below, when a clip
             is loaded). border-l draws the only vertical between col 1 and
             col 2. The whole column scrolls as one unit (no nested overflow)
             so the Capture Front/Back button can never be hidden below an
             inner-scroll fold — a recurring footgun for non-technical users.
             Custom always-visible JS scrollbar attaches to #col2-content. -->
        <div class="relative flex flex-col min-h-0 border-l border-white/20">
        <div id="col2-content" class="flex-1 flex flex-col min-h-0 p-4 gap-3 overflow-y-auto vhs-scroll">
          <div class="flex flex-col">
            <p class="shrink-0 text-white/70 text-[11px] tracking-wider mb-3">░ VHS Sleeve ░</p>
            <div>

            <!-- Front capture/preview -->
            <div id="sleeve-front-section">
              <p class="text-white/40 text-[10px] uppercase tracking-widest mb-1">Front</p>
              <div id="sleeve-front-preview" class="hidden aspect-[4/3] bg-[#141214] border border-white/10 mb-2 overflow-hidden">
                <span class="flex items-center justify-center w-full h-full text-white/10 text-[10px]">--</span>
              </div>
            </div>

            <!-- Webcam + capture view -->
            <div id="sleeve-capture-view">
              <div id="webcam-container" class="relative bg-[#141214] border border-white/10 aspect-[4/3] overflow-hidden cursor-pointer mb-2">
                <video id="sleeve-webcam" autoplay playsinline muted class="w-full h-full object-contain bg-black"></video>
                <!-- Detection status. Hidden until the webcam is initialized
                     (initWebcam in sleeve.js / app.js reveals it) so it
                     doesn't overlap the "No webcam" empty-state placeholder. -->
                <div id="detect-hud" class="hidden absolute top-2 left-2 right-2 flex items-center gap-2 pointer-events-none z-10">
                  <span id="detect-dot" style="width:8px;height:8px;border-radius:50%;background:#555;flex-shrink:0;transition:background 0.2s;"></span>
                  <span id="detect-label" style="font-size:10px;color:rgba(255,255,255,0.3);transition:color 0.2s;">Waiting...</span>
                  <span style="flex:1;"></span>
                  <span id="detect-countdown" style="font-size:10px;color:rgba(255,255,255,0.2);font-variant-numeric:tabular-nums;"></span>
                </div>
                <!-- Snap progress bar — same hidden-until-webcam rule. -->
                <div id="detect-snap-bar" class="hidden" style="position:absolute;bottom:0;left:0;right:0;height:3px;background:rgba(255,255,255,0.05);z-index:10;pointer-events:none;">
                  <div id="detect-progress" style="height:100%;width:0%;background:#4caf50;transition:width 0.12s;"></div>
                </div>
                <!-- Translucent VHS case target overlay. Already hidden via
                     `hidden` below, then revealed on initWebcam. -->
                <div id="sleeve-target" class="hidden absolute inset-0 flex items-center justify-center pointer-events-none">
                  <div class="scan-border aspect-[17/30] h-[70%] border-2 border-white/25 rounded-lg flex flex-col items-center justify-end pb-2 gap-1">
                    <span id="scan-status" class="text-white/30 text-[10px]">Scanning</span>
                    <span class="text-white/15 text-[10px]">Position sleeve here</span>
                  </div>
                </div>
                <!-- No webcam placeholder. Pixel icon is retro-camera-solid
                     from @hackernoon/pixel-icon-library — fits the "this
                     camera takes the sleeve photos" framing. -->
                <div id="no-webcam" class="absolute inset-0 flex items-center justify-center">
                  <div class="text-center text-white/15">
                    <svg class="mx-auto mb-2 fill-current" width="40" height="40" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="m22,3v-1H2v1h-1v18h1v1h20v-1h1V3h-1ZM3,4h6v1H3v-1Zm14,13h-1v2h-2v1h-4v-1h-2v-2h-1v-4h1v-2h2v-1h4v1h2v2h1v4Zm4-9H3v-1h6v-1h1v-1h1v-1h10v4Z"/>
                      <polygon points="15 13 15 17 14 17 14 18 10 18 10 17 9 17 9 13 10 13 10 16 11 16 11 14 13 14 13 13 10 13 10 12 14 12 14 13 15 13"/>
                    </svg>
                    <p class="text-white/50 text-xs mb-1">No webcam</p>
                    <p class="text-white/30 text-[9px] uppercase tracking-wider">Click to select</p>
                  </div>
                </div>
                <!-- Inline webcam selector -->
                <div id="webcam-selector" class="hidden absolute inset-0 bg-black/90 flex items-center justify-center">
                  <div class="w-48">
                    <p class="text-xs mb-2">Select webcam</p>
                    <select id="select-webcam" class="w-full bg-black border border-white/30 text-white text-xs p-2 mb-2"></select>
                    <button id="select-webcam-ok" class="w-full py-1 border border-white/30 text-white/60 hover:text-white text-xs">Connect</button>
                  </div>
                </div>
              </div>
              <button id="sleeve-capture-btn" class="w-full py-2 border border-white/30 text-white/60 hover:text-white hover:border-white/60 transition-colors text-xs">
                <span id="sleeve-capture-label">Capture Front</span>
              </button>
            </div>

            <!-- Back section: always visible. Shows a dim skeleton while waiting
                 for the front to be captured, the live webcam during back
                 capture (moved in by JS), then the captured back preview. -->
            <div id="sleeve-back-section" style="margin-top:0.5rem;">
              <p class="text-white/40 text-[10px] uppercase tracking-widest mb-1">Back</p>
              <div id="sleeve-back-preview" class="hidden aspect-[4/3] bg-[#141214] border border-white/10 mb-2 overflow-hidden">
                <span class="flex items-center justify-center w-full h-full text-white/10 text-[10px]">--</span>
              </div>
              <div id="sleeve-back-skeleton" class="aspect-[4/3] bg-[#0a0a0a] border border-dashed border-white/10 flex items-center justify-center mb-2">
                <span class="text-white/15 text-[10px] uppercase tracking-widest">Waits for front</span>
              </div>
            </div>

            <!-- Retake (shown when both captured) -->
            <div id="sleeve-review-view" class="hidden">
              <button id="sleeve-retake-btn" class="w-full py-2 border border-white/30 text-white/60 hover:text-white hover:border-white/60 transition-colors text-xs">Retake</button>
            </div>
            </div><!-- /sleeve content wrapper -->
            <button id="reset-sleeve-btn" class="self-start flex items-center gap-1.5 mt-3 pt-2 border-t border-white/10 text-white/30 hover:text-white/70 text-[10px] text-left transition-colors">
              <span class="inline-flex items-center justify-center w-3 h-3 border border-current leading-none text-[9px]">×</span>
              Reset covers
            </button>
          </div>

          <!-- Thumbnail picker — only relevant once a clip is loaded into the
               editor. Hidden until lastClipId is set. Subsection inside col 2,
               separated by a top border instead of a full fieldset frame. -->
          <div id="cap-thumb-fieldset" class="hidden pt-3 border-t border-white/15">
            <p class="text-white/70 text-[11px] tracking-wider mb-3">░ Thumbnail ░</p>
            <!-- Placeholder grid: a 6-cell skeleton that's visible until real
                 frames arrive, so the layout doesn't pop. -->
            <div id="player-thumb-empty" class="grid grid-cols-3 gap-2">
              <div class="aspect-video bg-white/5 border border-white/10"></div>
              <div class="aspect-video bg-white/5 border border-white/10"></div>
              <div class="aspect-video bg-white/5 border border-white/10"></div>
              <div class="aspect-video bg-white/5 border border-white/10"></div>
              <div class="aspect-video bg-white/5 border border-white/10"></div>
              <div class="aspect-video bg-white/5 border border-white/10"></div>
            </div>
            <div id="player-thumb-loading" class="hidden text-white/40 text-xs py-4 text-center">Generating thumbnails…</div>
            <div id="player-thumb-grid-wrap" class="hidden">
              <div id="player-thumb-grid" class="grid grid-cols-3 gap-2"></div>
              <div class="flex items-center justify-end mt-2">
                <button id="player-thumb-refresh" class="text-white/40 hover:text-white/70 text-xs flex items-center gap-1 transition-colors" title="Get 6 different frames">↻ Refresh</button>
              </div>
            </div>
          </div>
        </div>
        </div><!-- /col 2 outer wrapper -->

        <!-- Column 3: Clip Info (top) + Publish to YouTube (below, when a
             clip is loaded). border-l makes the column edge the only vertical
             between col 2 and col 3 — no outer fieldset chrome. Outer wrapper
             holds the divider + relative position; inner scrolls. The custom
             always-visible JS scrollbar attaches to #col3-content. -->
        <div class="relative flex flex-col min-h-0 border-l border-white/20">
        <div id="col3-content" class="flex-1 flex flex-col min-h-0 p-4 space-y-3 overflow-y-auto vhs-scroll">
          <div class="shrink-0">
            <!-- Clip Info header row — section title on the left, AI button
                 anchored top-right. Moved here from the publish form so the
                 AI rewrite is the most prominent action in this column
                 (you AI first, then you upload). Outlined-red treatment so
                 it doesn't fight the solid-red Upload button below. -->
            <div class="flex items-center mb-3">
              <p class="text-white/70 text-[11px] tracking-wider flex-1">░ Clip Info ░</p>
              <button id="yt-pub-ai-all" type="button"
                      class="pixel-btn inline-flex items-center gap-1.5 px-2.5 py-1 text-[11px] text-red-500 border border-red-500 hover:text-red-400 hover:border-red-400 hover:bg-red-500/10 transition-colors uppercase tracking-wider"
                      title="Rewrite title, description, and tags with AI">
                <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 100 100" aria-hidden="true">
