                </div>
                <p id="counter-clip-description" class="char-counter">0 / 5000</p>
              </div>
              <div id="ai-fields" class="space-y-2">
                <!-- Year + Distributor share a row to save vertical space in
                     this column. Year is short (4 chars), so the half-width
                     input is plenty; Distributor truncates with ellipsis if
                     it overflows the half-width slot. -->
                <div class="grid grid-cols-2 gap-2">
                  <div>
                    <label class="text-white/40 text-[10px] uppercase tracking-widest block mb-1">Year</label>
                    <input id="clip-year" type="text" placeholder="1994"
                      class="w-full px-2 py-1.5 bg-black border border-white/20 text-white text-xs placeholder-white/25 focus:outline-none focus:border-white/40" />
                  </div>
                  <div>
                    <label class="text-white/40 text-[10px] uppercase tracking-widest block mb-1">Distributor</label>
                    <input id="clip-distributor" type="text" placeholder="Warner, Paramount..."
                      class="w-full px-2 py-1.5 bg-black border border-white/20 text-white text-xs placeholder-white/25 focus:outline-none focus:border-white/40" />
                  </div>
                </div>
                <div>
                  <label class="text-white/40 text-[10px] uppercase tracking-widest block mb-1">Tags</label>
                  <input id="clip-tags" type="text" placeholder="home video, 90s, family" maxlength="500"
                    data-char-counter="counter-clip-tags" data-char-max="500"
                    class="w-full px-2 py-1.5 bg-black border border-white/20 text-white text-xs placeholder-white/25 focus:outline-none focus:border-white/40" />
                  <p id="counter-clip-tags" class="char-counter">0 / 500</p>
                </div>
                <div>
                  <label class="text-white/40 text-[10px] uppercase tracking-widest block mb-1">VHS Tape</label>
                  <input id="clip-tape" type="text" placeholder="Which tape is this from?"
                    class="w-full px-2 py-1.5 bg-black border border-white/20 text-white text-xs placeholder-white/25 focus:outline-none focus:border-white/40" />
                </div>
                <div class="grid grid-cols-3 gap-2">
                  <div>
                    <label class="text-white/40 text-[10px] uppercase tracking-widest block mb-1">Tape</label>
                    <input id="clip-tape-length" type="text" placeholder="T-120"
                      class="w-full px-2 py-1.5 bg-black border border-white/20 text-white text-xs placeholder-white/25 focus:outline-none focus:border-white/40" />
                  </div>
                  <div>
                    <label class="text-white/40 text-[10px] uppercase tracking-widest block mb-1">Speed</label>
                    <input id="clip-speed" type="text" placeholder="SP"
                      class="w-full px-2 py-1.5 bg-black border border-white/20 text-white text-xs placeholder-white/25 focus:outline-none focus:border-white/40" />
                  </div>
                  <div>
                    <label class="text-white/40 text-[10px] uppercase tracking-widest block mb-1">Condition</label>
                    <input id="clip-condition" type="text" placeholder="Good"
                      class="w-full px-2 py-1.5 bg-black border border-white/20 text-white text-xs placeholder-white/25 focus:outline-none focus:border-white/40" />
                  </div>
                </div>
                <div>
                  <label class="text-white/40 text-[10px] uppercase tracking-widest block mb-1">Cassette Notes</label>
                  <textarea id="clip-notes" rows="2" placeholder="Special edition, director's cut, other details..."
                    class="w-full px-2 py-1.5 bg-black border border-white/20 text-white text-xs placeholder-white/25 focus:outline-none focus:border-white/40 resize-none"></textarea>
                </div>
              </div>
            </div>
            <button id="reset-info-btn" class="shrink-0 flex items-center gap-1.5 mt-3 pt-2 border-t border-white/10 text-white/30 hover:text-white/70 text-[10px] text-left transition-colors">
              <span class="inline-flex items-center justify-center w-3 h-3 border border-current leading-none text-[9px]">×</span>
              Reset info
            </button>
          </div>

          <!-- (Thumbnail picker moved to column 2 — see above — so this
               column has more vertical room for Clip Info + Publish.) -->

          <!-- Publish to YouTube — only relevant once a clip is loaded.
               Subsection inside col 3, separated by a top border instead
               of a full fieldset frame. -->
          <div id="cap-pub-fieldset" class="hidden shrink-0 pt-3 border-t border-white/15">
            <p class="text-white/70 text-[11px] tracking-wider mb-3">░ Publish to YouTube ░</p>

            <!-- Upload progress bar — pinned to the TOP of the publish
                 section so it stays visible even when the panel has
                 scrolled past the Upload button (which used to live below
                 the bar). Shown only while a real upload is in flight;
                 hidden in every other state. -->
            <div id="yt-pub-progress" class="hidden mb-3">
              <div style="height:4px;background:rgba(255,255,255,0.1);overflow:hidden;">
                <div id="yt-pub-progress-bar" style="height:100%;width:0%;background:#e53935;transition:width 0.2s;"></div>
              </div>
              <p id="yt-pub-status" class="text-white/40 text-[10px] mt-1"></p>
            </div>

            <!-- Upload destination banner. Single source of truth for
                 "you're signed in AND uploads land on this channel" —
                 used to be split across two rows ("Logged in as @X" +
                 "Uploading to @X") which read as duplicated info since
                 in 99% of cases they're the same handle. The bridge
                 architecture means even allowlisted users see one
                 channel here (VHS Garage) regardless of which Google
                 account they OAuth'd with, so the "logged in as"
                 framing was misleading anyway. Sign out lives here
                 now as a small inline action. -->
            <div id="yt-pub-destination" class="hidden flex items-center gap-2 mb-3 px-2 py-1.5 border border-white/15 text-[11px]">
              <img id="yt-pub-destination-thumb" src="" alt="" class="w-5 h-5 object-cover bg-white/10" />
              <div class="min-w-0 flex-1">
                <p class="text-white/40 text-[9px] uppercase tracking-widest leading-tight">Uploading to</p>
                <p class="text-white text-[12px] leading-tight truncate">
                  <span id="yt-pub-destination-name"></span>
                  <span id="yt-pub-destination-handle" class="text-white/50"></span>
                </p>
              </div>
              <span id="yt-pub-destination-badge" class="hidden text-[8px] uppercase tracking-widest px-1.5 py-0.5 bg-[#dc2626] text-white font-bold">Bridge</span>
              <button id="yt-pub-signout" class="text-white/30 hover:text-white/70 text-[10px] underline-offset-2 hover:underline transition-colors">Sign out</button>
            </div>

            <!-- Manual upload counter. Hidden when count is 0 (fresh
                 install / just-reset state). Bumps on every successful
                 upload from this browser. Reset by the "Reset count"
                 action that appears in the failure toast specifically
                 when YouTube returns uploadLimitExceeded — gives the
                 user a calibration point against the per-channel 50/day
                 cap that YouTube refuses to expose via API. The wrapper
                 carries [data-upload-count]; updateUploadCountUI()
                 shows/hides + writes the number. -->
            <div data-upload-count class="hidden mb-3 px-2 py-1 text-[10px] text-white/40 flex items-center gap-1.5">
              <span class="uppercase tracking-widest text-white/30 text-[9px]">Uploaded today</span>
              <span class="text-white/70 tabular-nums" data-upload-count-value>0</span>
              <span class="text-white/25 text-[9px]">· counted from last reset</span>
            </div>

            <!-- Sign-in panel (visible when not signed in) -->
            <div id="yt-pub-signin" class="hidden text-center py-4">
              <p class="text-white/70 text-sm mb-1">Sign in to publish</p>
              <p class="text-white/40 text-xs mb-4">Uploads go to your own YouTube channel.</p>
              <button id="yt-pub-signin-btn" class="inline-flex items-center gap-2 px-4 py-2 bg-white text-black text-xs font-medium hover:bg-white/90 transition-colors">
                <svg class="w-4 h-4" viewBox="0 0 24 24"><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.46 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84C6.71 7.31 9.14 5.38 12 5.38z"/><path fill="#4285F4" d="M23 12.27c0-.79-.07-1.54-.19-2.27H12v4.51h6.18c-.27 1.4-1.07 2.59-2.28 3.39l3.54 2.74C21.61 18.58 23 15.68 23 12.27z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.37-.35-2.09s.13-1.43.35-2.09L2.18 7.07C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l3.66-2.84z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.54-2.74c-.98.66-2.23 1.05-3.74 1.05-2.86 0-5.29-1.93-6.16-4.53l-3.66 2.84C3.99 20.53 7.7 23 12 23z"/></svg>
                Sign in with Google
              </button>
            </div>

            <!-- Default state: visibility + Upload + progress.
                 (Main AI rewrite button moved up to the Clip Info header
                 — it's the first action you take on a new clip, so it
                 belongs at the top of the column, not buried in the
                 publish row.) -->
            <div id="yt-pub-form" class="hidden">
              <div class="flex items-center gap-2 mb-3">
                <label class="text-white/40 text-[10px] uppercase tracking-widest">Visibility</label>
                <select id="yt-pub-privacy" class="bg-black border border-white/20 text-white text-xs p-1.5 ml-auto">
                  <option value="public" selected>Public</option>
                  <option value="unlisted">Unlisted</option>
                  <option value="private">Private</option>
                </select>
              </div>
              <button id="yt-pub-upload" class="w-full py-2 bg-red-600 hover:bg-red-500 text-white text-xs transition-colors">Upload to YouTube</button>
              <!-- (The #yt-pub-progress bar lives at the top of
                   #cap-pub-fieldset above, NOT here — keeps it visible
                   when the panel scrolls past the upload button.) -->
            </div>

            <!-- AI generating loader -->
            <div id="yt-pub-loading" class="hidden text-white/40 text-sm py-4 text-center">Generating AI copy...</div>

            <!-- AI suggestion preview -->
            <div id="yt-pub-suggestion" class="hidden">
              <p class="text-white/60 text-[11px] tracking-wider mb-3">░ AI Suggestion ░</p>
              <p id="yt-pub-suggestion-meta" class="text-white/30 text-[10px] mb-3"></p>
              <p id="yt-pub-suggestion-fallback" class="hidden text-yellow-400/80 text-[10px] mb-3"></p>

              <!-- Suggestion fields are real <input>/<textarea> so the user
                   can tweak the AI's output BEFORE clicking "Use this".
                   applySuggestion (in app.js) reads from these elements'
                   .value, NOT from the stored AI response, so any edits
                   here flow through to the main sidebar fields. -->
              <div id="yt-pub-suggestion-title-group" class="hidden mb-3">
                <label class="text-white/40 text-[10px] uppercase tracking-widest block mb-1">Title</label>
                <input id="yt-pub-suggestion-title" type="text" maxlength="100"
                  data-char-counter="counter-yt-pub-suggestion-title" data-char-max="100"
                  class="w-full text-white/90 text-xs bg-black/50 border border-white/10 p-2 focus:outline-none focus:border-white/40" />
                <p id="counter-yt-pub-suggestion-title" class="char-counter">0 / 100</p>
              </div>

              <div id="yt-pub-suggestion-desc-group" class="hidden mb-3">
                <label class="text-white/40 text-[10px] uppercase tracking-widest block mb-1">Description</label>
                <textarea id="yt-pub-suggestion-desc" rows="6" maxlength="5000"
                  data-char-counter="counter-yt-pub-suggestion-desc" data-char-max="5000"
                  class="w-full text-white/90 text-xs bg-black/50 border border-white/10 p-2 max-h-40 overflow-y-auto resize-none focus:outline-none focus:border-white/40"></textarea>
                <p id="counter-yt-pub-suggestion-desc" class="char-counter">0 / 5000</p>
              </div>

              <div id="yt-pub-suggestion-tags-group" class="hidden mb-4">
                <label class="text-white/40 text-[10px] uppercase tracking-widest block mb-1">Tags</label>
                <input id="yt-pub-suggestion-tags" type="text" maxlength="500"
                  data-char-counter="counter-yt-pub-suggestion-tags" data-char-max="500"
                  class="w-full text-white/90 text-xs bg-black/50 border border-white/10 p-2 focus:outline-none focus:border-white/40" />
                <p id="counter-yt-pub-suggestion-tags" class="char-counter">0 / 500</p>
              </div>

              <div class="flex gap-2 flex-wrap">
                <button id="yt-pub-suggestion-use" class="flex-1 py-2 bg-red-600 hover:bg-red-500 text-white text-xs transition-colors">Use this</button>
                <button id="yt-pub-suggestion-retry" class="px-3 py-2 border border-white/30 text-white/70 hover:text-white hover:border-white/60 text-xs transition-colors">Try again</button>
                <button id="yt-pub-suggestion-cancel" class="px-3 py-2 border border-white/20 text-white/50 hover:text-white text-xs transition-colors">Cancel</button>
              </div>
            </div>

            <!-- Upload error -->
            <div id="yt-pub-error" class="hidden py-3">
              <p id="yt-pub-error-msg" class="text-red-400 text-sm mb-3 whitespace-pre-line"></p>
              <div class="flex gap-2">
                <button id="yt-pub-retry" class="flex-1 py-2 bg-red-600 hover:bg-red-500 text-white text-xs transition-colors">Retry</button>
                <button id="yt-pub-error-close" class="px-3 py-2 border border-white/20 text-white/50 hover:text-white text-xs transition-colors">Close</button>
              </div>
            </div>

            <!-- Done — slim single-row success state. Vertical space in this
                 column is at a premium, so no big "Uploaded!" headline; just
                 a green check + label + link on one line. Thumbnail warning
                 only appears underneath if thumbnails.set fails. -->
            <div id="yt-pub-done" class="hidden flex items-center justify-between gap-2 py-1.5 px-2 bg-green-900/30 border border-green-500/40">
              <span class="inline-flex items-center gap-1.5 text-green-300 text-xs font-medium">
                <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24" aria-hidden="true"><path d="m22,9v-2h-1v-2h-1v-1h-1v-1h-2v-1h-2v-1h-6v1h-2v1h-2v1h-1v1h-1v2h-1v2h-1v6h1v2h1v2h1v1h1v1h2v1h2v1h6v-1h2v-1h2v-1h1v-1h1v-2h1v-2h1v-6h-1Zm-4,3h-1v1h-1v1h-1v1h-1v1h-1v1h-1v1h-2v-1h-1v-1h-1v-1h-1v-1h-1v-2h1v-1h2v1h1v1h2v-1h1v-1h1v-1h1v-1h1v-1h2v1h1v2h-1v1Z"/></svg>
                Uploaded
              </span>
              <a id="yt-pub-link" href="" target="_blank" class="text-red-400 hover:text-red-300 text-[11px] truncate">View →</a>
            </div>
            <p id="yt-pub-thumb-warn" class="hidden text-yellow-400/70 text-[10px] mt-1"></p>
          </div>
        </div>
        </div><!-- /col 3 outer wrapper -->

      </div>
    </div>

    </div><!-- /content area -->

    <!-- Device settings modal (triggered by clicking status bar). Backdrop
         is the outer div; clicking it dismisses. Content card is centered on
         the viewport and sized ~2x the old inline popover. -->
    <div id="device-popover" class="hidden fixed inset-0 z-30 flex items-center justify-center bg-black/50 p-4">
      <div class="w-full max-w-3xl bg-black/95 border border-white/20 p-6 text-sm">
        <div class="flex items-center justify-between mb-5">
          <span class="text-white/80 text-base tracking-wider">░ Device Settings ░</span>
          <button id="device-popover-close" class="text-white/50 hover:text-white/80 transition-colors text-sm">Close</button>
        </div>
        <div class="grid md:grid-cols-2 gap-5">
          <div>
            <label class="text-gray-400 block mb-2 text-sm">Video Source</label>
            <select id="dp-video" class="w-full bg-black border border-white/20 text-white text-sm p-2.5"></select>
          </div>
          <div>
            <label class="text-gray-400 block mb-2 text-sm">Audio Source</label>
            <select id="dp-audio" class="w-full bg-black border border-white/20 text-white text-sm p-2.5"></select>
          </div>
          <div>
            <label class="text-gray-400 block mb-2 text-sm">Webcam</label>
            <select id="dp-webcam" class="w-full bg-black border border-white/20 text-white text-sm p-2.5"></select>
          </div>
          <div>
            <label class="text-gray-400 block mb-2 text-sm">Save Location</label>
            <button id="dp-pick-dir" class="w-full py-2.5 border border-white/20 text-white/60 hover:text-white text-left px-3 text-sm">
              <span id="dp-dir-name">Choose folder...</span>
            </button>
          </div>
        </div>
        <div class="mt-6 flex justify-end">
          <button id="dp-apply" class="px-6 py-2.5 border border-white/30 text-white/60 hover:text-white hover:border-white/60 transition-colors text-sm">Apply</button>
        </div>
      </div>
    </div>

  </div>

  <!-- Translucent black backdrop behind the library window. Click to dismiss. -->
  <div id="library-backdrop" class="hidden fixed inset-0 z-20" style="background: rgba(0, 0, 0, 0.7);"></div>

  <!-- Native-style right-click context menu for library tiles. Hidden by
       default; positioned at the click point on contextmenu and dismissed
       on outside-click or Escape. Single shared element, repositioned per
       right-click so we're not generating one menu per tile. -->
  <div id="library-context-menu" class="hidden fixed z-40 bg-black border border-white/30 text-xs select-none py-1" style="min-width:160px; box-shadow: 2px 2px 0 0 rgba(0,0,0,0.7), inset 1px 1px 0 0 rgba(255,255,255,0.06); font-family: 'VCR', monospace;">
    <button id="lib-ctx-open" class="block w-full text-left px-3 py-1.5 text-white/80 hover:bg-white/10 transition-colors">Open Clip</button>
    <!-- Duplicate copies the source video file on disk + creates a new
         catalog entry with all the metadata cloned over (title, tags,
         sleeve refs, description) but the youtube* fields cleared. Use
         case: "I want to make 3 trailers from this raw recording" —
         duplicate it 3 times, then trim each copy to a different range.
         No re-encode, no quality loss, fast (just a file copy). -->
    <button id="lib-ctx-duplicate" class="block w-full text-left px-3 py-1.5 text-white/80 hover:bg-white/10 transition-colors">Duplicate</button>
    <!-- Only enabled for clips that already have a youtubeUrl. Clears the
         catalog's youtubeUrl + youtubeId so the YouTube pill disappears
         and the clip becomes re-queueable for upload. Useful when an
         upload landed on the wrong channel and the user wants to redo it. -->
    <button id="lib-ctx-mark-unuploaded" class="block w-full text-left px-3 py-1.5 text-white/80 hover:bg-white/10 transition-colors">Mark not uploaded</button>
    <div class="border-t border-white/10 my-1"></div>
    <button id="lib-ctx-delete" class="block w-full text-left px-3 py-1.5 text-red-400/80 hover:bg-white/5 hover:text-red-400 transition-colors">Delete</button>
  </div>

  <!-- Toolbar drop-down menu — single shared host populated on each open by
       openToolbarMenu(triggerEl, items) in app.js. Anchored absolutely to
       the click point in viewport coords (clamped to the viewport edges).
       Style is the chiseled-bevel "raised" look from System 7 / Win 3.1
       (defined as .toolbar-menu in the <style> block above). -->
  <div id="toolbar-menu" class="toolbar-menu hidden"></div>

  <!-- Trim "Save Trim" confirmation modal — opens from the Save Trim
       button inside the trim panel. Two radio choices:
         · Create new clip (DEFAULT, recommended) — encodes a separate
           file, original untouched, new entry in library
         · Trim original permanently — overwrites the source file on
           disk; if the clip is already on YouTube, a note explains
           that won't change the YouTube version
       Confirm kicks off the MediaRecorder pipeline; progress is shown
       via a toast (see #trim-progress-toast below). -->
  <div id="trim-save-modal"
       class="hidden fixed inset-0 z-50 bg-black/80 flex items-center justify-center p-4"
       style="font-family: 'VCR', monospace;">
    <div class="bg-[#0a090a] border border-white/30 max-w-md w-full p-5"
         style="box-shadow: 4px 4px 0 0 rgba(0,0,0,0.8);">
      <h3 class="text-white text-base uppercase tracking-wider mb-3">Save Trim</h3>
      <p class="text-white/50 text-[11px] mb-5 tabular-nums">
        From <span id="trim-modal-in" class="text-white/80">0:00:00.0</span>
        to <span id="trim-modal-out" class="text-white/80">0:00:00.0</span>
        · <span id="trim-modal-kept" class="text-white/80">0:00:00.0</span> kept
      </p>

      <!-- Already-uploaded note. Hidden unless the active clip has a
           youtubeUrl — in that case "Trim original permanently" is still
           ALLOWED (per spec) but the user gets this warning so they know
           the YouTube video won't auto-update. -->
      <p id="trim-modal-uploaded-note"
         class="hidden mb-4 px-3 py-2 border border-yellow-500/40 bg-yellow-500/5 text-yellow-200/80 text-[11px] leading-relaxed">
        ⚠ This clip is already on YouTube. Trimming the original here won't
        change the video that's already up — you'd need to delete it on
        YouTube + right-click → Mark not uploaded in the library + re-upload.
      </p>

      <div class="space-y-2 mb-5">
        <label class="trim-modal-choice block border border-white/20 hover:border-white/50 transition-colors cursor-pointer p-3"
               data-trim-mode="new">
          <div class="flex items-start gap-2">
            <input type="radio" name="trim-mode" value="new" checked class="mt-1" />
            <div class="flex-1 min-w-0">
              <p class="text-white text-sm flex items-center gap-2">
                Create new clip
                <span class="text-[8px] uppercase tracking-widest bg-[#dc2626] text-white px-1.5 py-0.5">Recommended</span>
              </p>
              <p class="text-white/40 text-[11px] mt-1">Saves the trim as a separate clip. Original file stays untouched.</p>
            </div>
          </div>
        </label>

        <label class="trim-modal-choice block border border-white/20 hover:border-white/50 transition-colors cursor-pointer p-3"
               data-trim-mode="replace">
          <div class="flex items-start gap-2">
            <input type="radio" name="trim-mode" value="replace" class="mt-1" />
            <div class="flex-1 min-w-0">
              <p class="text-white text-sm">Trim original permanently</p>
              <p class="text-white/40 text-[11px] mt-1">Replaces the original file on disk. Cannot be undone.</p>
            </div>
          </div>
        </label>
      </div>

      <div class="flex items-center justify-end gap-2">
        <button id="trim-modal-cancel"
                type="button"
                class="px-3 py-2 text-white/60 hover:text-white text-[11px] uppercase tracking-wider transition-colors">
          Cancel
        </button>
        <button id="trim-modal-confirm"
                type="button"
                class="px-4 py-2 bg-[#dc2626] hover:bg-[#ef4444] text-white text-[11px] uppercase tracking-wider transition-colors">
          Confirm
        </button>
      </div>
    </div>
  </div>

  <!-- Trim progress toast — fixed bottom-right, shown during the
       MediaRecorder encode (which is real-time, so a 5-min trim takes
       ~5 min). Position values + size are wired by trim code in app.js. -->
  <div id="trim-progress-toast"
       class="hidden fixed bottom-4 right-4 z-50 bg-[#0a090a] border border-white/30 px-4 py-3 min-w-[280px]"
       style="font-family: 'VCR', monospace; box-shadow: 4px 4px 0 0 rgba(0,0,0,0.8);">
    <p class="text-white text-[11px] uppercase tracking-wider mb-2">Trimming…</p>
    <p id="trim-progress-position" class="text-white/60 text-[10px] tabular-nums mb-2">0:00:00 of 0:00:00</p>
    <div class="h-1 bg-white/10 overflow-hidden">
      <div id="trim-progress-bar" class="h-full bg-[#dc2626] transition-all duration-150" style="width: 0%;"></div>
    </div>
    <p id="trim-progress-detail" class="text-white/30 text-[9px] mt-2">Real-time encode — leave this tab open.</p>
  </div>

  <!-- Upload toast stack — bottom-right, vertical column, newest on top.
       Cards are dynamically appended by enqueueUpload() in app.js. The
       stack lives outside the column grid so it floats above everything
       and isn't constrained by the publish panel's scroll. flex-col-reverse
       so a normal append puts the new toast at the visual TOP. -->
  <div id="toast-stack" class="fixed bottom-4 right-4 z-[55] flex flex-col-reverse gap-2 pointer-events-none" style="font-family: 'VCR', monospace;"></div>

  <!-- Batch upload review modal — shown after the user clicks the
       "Upload (N of 6)" counter in the library titlebar. Body is a
       vertical list of selected clips with editable title/description
       per row (renderBatchReview in app.js builds the rows). Confirm
       enqueues all of them into the existing toast queue. Same 1px-
       border + VCR styling as the toast cards. -->
  <div id="batch-review-modal" class="hidden fixed inset-0 z-[58] bg-black/70 flex items-center justify-center p-4" style="font-family: 'VCR', monospace;">
    <div class="bg-[#1a181a] text-white border border-[#333] flex flex-col" style="width: 560px; max-width: 100%; max-height: 80vh;">
      <div class="flex items-center gap-2 px-4 py-3 border-b border-white/15 shrink-0">
        <span class="text-white/85 font-bold text-[11px] tracking-[0.15em] uppercase flex-1">Confirm batch upload</span>
        <span id="batch-review-count" class="text-white/40 text-[10px] uppercase tracking-wider"></span>
      </div>
      <p class="px-4 pt-3 text-white/40 text-[10px] uppercase tracking-wider shrink-0">Edit title or description for any clip before uploading.</p>
      <div id="batch-review-list" class="flex-1 min-h-0 overflow-y-auto px-4 py-3 space-y-3"></div>
      <div class="flex items-center gap-2 px-4 py-3 border-t border-white/15 shrink-0">
        <button id="batch-review-cancel" class="px-3 py-1.5 border border-white/25 text-white/70 hover:text-white hover:border-white/60 text-[11px] tracking-wider uppercase transition-colors">Cancel</button>
        <span class="flex-1"></span>
        <button id="batch-review-confirm" class="px-4 py-1.5 bg-red-600 hover:bg-red-500 text-white text-[11px] tracking-wider uppercase transition-colors">Upload</button>
      </div>
    </div>
  </div>

  <!-- Demo countdown modal — shown for ~3s before the puppet sequence
       starts. Same chiseled-bevel look as the toolbar dropdowns + library
       context menu so it reads as part of the same UI family. Font is
       inherited from body (VCR + monospace fallback, see global.css). -->
  <div id="demo-countdown" class="hidden fixed inset-0 z-[70] bg-black/70 flex items-center justify-center">
    <div class="bg-[#1a181a] text-white border border-black p-8 text-center" style="
         min-width: 320px;
         box-shadow:
           inset 1px 1px 0 0 rgba(255,255,255,0.18),
           inset -1px -1px 0 0 rgba(0,0,0,0.85),
           4px 4px 0 0 rgba(0,0,0,0.6);">
      <p class="text-white/60 text-[10px] uppercase tracking-[0.18em] mb-3">Demo Mode</p>
      <p class="text-white text-sm mb-4">Sample footage starting in</p>
      <p id="demo-countdown-num" class="text-red-500 text-7xl font-bold tabular-nums leading-none mb-4">3</p>
      <p class="text-white/40 text-[10px] uppercase tracking-wider">Hit ESC key to stop demo</p>
    </div>
  </div>

  <!-- Demo complete modal — shown ~6s after the demo finishes (or when ESC
       is pressed mid-flow). Two actions: re-run the demo or exit back to
       a fresh capture screen. Both use a session-storage flag + reload to
       guarantee a clean reset. -->
  <div id="demo-complete" class="hidden fixed inset-0 z-[70] bg-black/70 flex items-center justify-center">
    <div class="bg-[#1a181a] text-white border border-black p-8 text-center" style="
         min-width: 360px;
         box-shadow:
           inset 1px 1px 0 0 rgba(255,255,255,0.18),
           inset -1px -1px 0 0 rgba(0,0,0,0.85),
           4px 4px 0 0 rgba(0,0,0,0.6);">
      <p class="text-white/60 text-[10px] uppercase tracking-[0.18em] mb-3">Demo Mode</p>
      <p class="text-white text-lg mb-2">Demo Complete</p>
      <p id="demo-complete-tagline" class="text-white/40 text-xs mb-6">That's the full capture flow — record, snap sleeves, let AI write the metadata, pick a thumbnail, publish.</p>
      <div class="flex gap-3 justify-center">
        <button id="demo-again-btn" class="pixel-btn px-4 py-2 bg-red-600 hover:bg-red-500 text-white text-xs uppercase tracking-wider transition-colors">Show me again</button>
        <button id="demo-exit-btn" class="pixel-btn px-4 py-2 border border-white/30 text-white/70 hover:text-white hover:border-white/60 text-xs uppercase tracking-wider transition-colors">Exit</button>
      </div>
    </div>
  </div>

  <!-- Library: draggable + resizable "computer window" overlay. Click and
       drag the title bar to move; drag the bottom-right corner to resize
       (native CSS resize handle). Red [×] in the title bar closes it.
       Body scrolls internally when too many tiles to fit. When no save
       folder is picked, body shows ONLY the folder picker so it's obvious
       we don't know where the user's clips live until they tell us. -->
  <div id="view-library" class="hidden fixed z-30 overflow-hidden" style="top:50%; left:50%; transform:translate(-50%, -50%); width:680px; max-width:calc(100vw - 32px); height:520px; max-height:calc(100vh - 80px); min-width:360px; min-height:260px; resize: both; box-shadow: 6px 6px 0 0 rgba(0,0,0,0.75);">
    <div class="pixel-btn bg-black flex flex-col h-full" style="border: 3px solid #dc2626; box-shadow: inset 1px 1px 0 0 rgba(255,255,255,0.06);">
      <!-- Title bar — drag handle. Window chrome borrows old-software cues:
           inset highlight, monospace, tracking, single accent dot. -->
      <div id="library-titlebar" class="flex items-center gap-2 px-2 py-1.5 bg-white/10 border-b border-white/25 select-none" style="cursor: grab; font-family: 'VCR', monospace; box-shadow: inset 0 1px 0 0 rgba(255,255,255,0.08);">
        <span class="inline-block w-1.5 h-1.5 bg-red-500 ml-1" style="box-shadow: 0 0 6px rgba(229,57,53,0.6);"></span>
        <span class="text-white/85 font-bold text-[11px] tracking-[0.15em] uppercase">VHS Garage — Library</span>
        <span class="flex-1"></span>
        <!-- Filter toggle — flips between showing all clips vs. only
             un-uploaded ones. Persists across sessions in localStorage.
             Useful once the library has 30+ clips and the un-uploaded
             ones get lost in a sea of YouTube pills. -->
        <button id="library-filter-btn" type="button"
                class="px-2 h-5 flex items-center justify-center text-white/80 hover:text-white border border-white/25 hover:border-white/50 text-[10px] tracking-wider uppercase transition-colors"
                title="Toggle showing all vs. un-uploaded clips">
          Show: All
        </button>

        <!-- Upload Many — toggles batch-selection mode. Becomes the
             "Upload (N of 6)" counter while selecting; click again with
             0 selected (or hit Esc) to exit selection mode. Once N > 0
             clicking advances to the review modal. -->
        <button id="library-upload-many-btn" type="button"
                class="px-2 h-5 flex items-center justify-center text-white/80 hover:text-white border border-white/25 hover:border-white/50 text-[10px] tracking-wider uppercase transition-colors"
                title="Select multiple clips to upload">
          Upload Many
        </button>
        <button id="to-capture-btn" type="button" class="w-5 h-5 flex items-center justify-center bg-red-600 hover:bg-red-500 text-white text-sm leading-none transition-colors" title="Close" style="font-family: 'VCR', monospace;">×</button>
      </div>

      <!-- Body — scrolls internally. Either the folder placeholder OR the file list. -->
      <div class="flex-1 min-h-0 overflow-y-auto" style="background:#0a0a0a;">
        <div id="library-folder-banner" class="hidden flex flex-col items-center justify-center text-center py-16 px-6">
          <span class="text-white/20 text-3xl mb-3">▒</span>
          <p class="text-white/80 text-sm mb-2">Pick your local drive folder to view your clips</p>
          <p class="text-white/40 text-xs mb-5 max-w-sm">VHS Garage doesn't know where your recordings are saved until you point it at the folder. Read access only.</p>
          <button id="library-pick-dir" class="px-4 py-2 border border-white/30 text-white/80 hover:text-white hover:border-white text-xs transition-colors">Choose folder…</button>
        </div>

        <!-- Resync banner — only shown when checkLibraryResyncBanner finds
             clips on disk (with a .json sidecar) that aren't in the catalog.
             One click rebuilds the missing entries from the sidecars. Hidden
             when catalog and disk agree. -->
        <div id="library-resync-banner" class="hidden flex items-center gap-2 px-3 py-2 border-b border-yellow-500/30" style="background: rgba(202, 138, 4, 0.12);">
          <span class="text-yellow-300/85 text-[11px] flex-1">
            Found <span id="library-resync-count" class="font-bold">0</span> clip(s) on disk not in your library.
          </span>
          <button id="library-resync-btn" class="px-2 py-1 bg-yellow-600 hover:bg-yellow-500 text-white text-[10px] uppercase tracking-wider transition-colors">Resync</button>
        </div>

        <div id="library-grid" class="grid grid-cols-3 sm:grid-cols-4 gap-2 p-3"></div>
        <p id="library-empty" class="text-gray-400 text-xs text-center py-12">No clips captured yet.</p>
      </div>

      <!-- Footer — small action strip -->
      <div class="flex items-center justify-end gap-3 px-3 py-1.5 border-t border-white/15 bg-white/5">
        <button id="export-catalog-btn" class="text-[10px] text-white/40 hover:text-white/70 transition-colors uppercase tracking-wider">Export catalog.json</button>
      </div>
    </div>
  </div>


  <!-- Settings popover (hidden, triggered by gear icon) -->
  <div id="settings-popover" class="hidden fixed bottom-10 right-4 z-30 bg-black/95 border border-white/20 p-3 w-56 text-xs">
    <div class="space-y-3">
      <div>
        <label class="text-gray-400 block mb-1">Recording Quality</label>
        <select id="setting-quality" class="w-full bg-black border border-white/20 text-white text-xs p-1">
          <option value="8000000">Archival (8 Mbps)</option>
          <option value="5000000" selected>High (5 Mbps)</option>
          <option value="2500000">Standard (2.5 Mbps)</option>
        </select>
      </div>
      <div>
        <label class="text-gray-400 block mb-1">Video Format</label>
        <select id="setting-format" class="w-full bg-black border border-white/20 text-white text-xs p-1">
          <option value="mp4" selected>MP4 (H.264)</option>
          <option value="webm">WebM (VP9)</option>
        </select>
      </div>
      <div>
        <label class="text-gray-400 block mb-1">File naming</label>
        <select id="setting-name-format" class="w-full bg-black border border-white/20 text-white text-xs p-1">
          <option value="title">Title + timestamp</option>
          <option value="timestamp">Timestamp only</option>
        </select>
      </div>
      <div>
        <button id="setting-pick-dir" class="w-full py-1 border border-white/20 text-white/60 hover:text-white text-left px-2">
          <span id="setting-dir-name">Choose save folder...</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Welcome / Quick-start modal. Shown on first visit (before permissions
       are requested) and again whenever the Help button in the status bar
       is clicked. Five slides: three ASCII intros, a layout/shortcut tour,
       and a device setup form that mirrors the Device Settings modal. -->
  <div id="welcome-modal" class="hidden fixed inset-0 z-40 flex items-center justify-center bg-black p-4">
    <!-- VHS static backdrop — runs only while the modal is visible.
         Low-res buffer stretched to the viewport with pixelated rendering
         so the pixels read as chunky analog noise, not fine grain. -->
    <canvas id="welcome-static" class="absolute inset-0 w-full h-full pointer-events-none" style="image-rendering: pixelated; opacity: 0.45;"></canvas>
    <div class="relative w-full max-w-2xl bg-black/95 border border-white/20 p-6 text-sm">
      <!-- Header -->
      <div class="flex items-center justify-between mb-4">
        <span class="text-white/80 text-base tracking-wider">░ Quick Start ░</span>
        <button id="welcome-close" class="text-white/40 hover:text-white/70 transition-colors text-sm">Close</button>
      </div>

      <!-- Slides (only one visible at a time; others hidden) -->
      <div id="welcome-slides" class="min-h-[320px] flex flex-col justify-center">

        <!-- Slide 1: What is this? -->
        <div class="welcome-slide" data-slide="0">
<pre class="font-mono text-white/80 text-center text-[11px] leading-[1.25] my-4 whitespace-pre">    ┌────────────────────────┐
    │                        │
    │  ╔═══╗        ╔═══╗    │
    │  ║ ◉ ║════════║ ◉ ║    │
    │  ╚═══╝        ╚═══╝    │
    │                        │
    │  ▓▓▓▓▓▓ V H S ▓▓▓▓▓▓   │
    └────────────────────────┘</pre>
          <h3 class="text-white/90 text-base mb-2">Welcome to VHS Garage</h3>
          <p class="text-white/60 text-[13px] leading-snug">A simple way to turn your old VHS tapes into digital videos on your computer. Let's get you started.</p>
        </div>

        <!-- Slide 2: What you need -->
        <div class="welcome-slide hidden" data-slide="1">
<pre class="font-mono text-white/80 text-center text-[11px] leading-[1.25] my-4 whitespace-pre">    ┌──────┐                ┌──────┐
    │ ▓▓▓▓ │                │ ▒▒▒▒ │
    │ VCR  │════════════════│ MAC  │
    │ ▓▓▓▓ │      USB       │ ▒▒▒▒ │
    └──────┘                └──────┘</pre>
          <h3 class="text-white/90 text-base mb-2">Works with your gear</h3>
          <p class="text-white/60 text-[13px] leading-snug">Plug in a USB capture card, HDMI grabber, or even point a webcam at a TV. If your computer can see the signal, VHS Garage can record it.</p>
        </div>

        <!-- Slide 3: Publish to YouTube -->
        <div class="welcome-slide hidden" data-slide="2">
<pre class="font-mono text-white/80 text-center text-[11px] leading-[1.25] my-4 whitespace-pre">      ┏━━━━━━━━━━━━━━━━━┓
      ┃                 ┃
      ┃       ▶         ┃
      ┃       ▶▶        ┃
      ┃       ▶▶▶       ┃
      ┃       ▶▶        ┃
      ┃       ▶         ┃
      ┃                 ┃
      ┗━━━━━━━━━━━━━━━━━┛
            YouTube</pre>
          <h3 class="text-white/90 text-base mb-2">Share straight to YouTube</h3>
          <p class="text-white/60 text-[13px] leading-snug">Once you've recorded a clip, sign in with Google and we'll write a title and description from the tape's cover for you — then upload straight to your own channel.</p>
        </div>

        <!-- Slide 4: Three panels / how it works -->
        <div class="welcome-slide hidden" data-slide="3">
<pre class="font-mono text-white/80 text-center text-[11px] leading-[1.25] my-4 whitespace-pre">    ╔═══════════╦═════════╦═════════╗
    ║           ║         ║         ║
    ║  PREVIEW  ║ SLEEVE  ║  INFO   ║
    ║           ║         ║         ║
    ║    ▶▶     ║   ▢▢    ║  ░░░░░  ║
    ║   [REC]   ║   ▢▢    ║  ░░░░░  ║
    ║           ║         ║  ░░     ║
    ╚═══════════╩═════════╩═════════╝
         [R]        [SPACE]</pre>
          <h3 class="text-white/90 text-base mb-2">Three panels, one job</h3>
          <p class="text-white/60 text-[13px] leading-snug mb-2">
            <strong class="text-white/80">Left — preview:</strong> live video from your capture card. Hit <kbd class="px-1.5 py-0.5 border border-white/25 text-white/80 bg-black/50 text-[10px]">REC</kbd> or press <kbd class="px-1.5 py-0.5 border border-white/25 text-white/80 bg-black/50 text-[10px]">R</kbd> to record.
          </p>
          <p class="text-white/60 text-[13px] leading-snug mb-2">
            <strong class="text-white/80">Middle — sleeve:</strong> hold the tape's front and back cover up to your webcam. They'll snap automatically, or press <kbd class="px-1.5 py-0.5 border border-white/25 text-white/80 bg-black/50 text-[10px]">Space</kbd>.
          </p>
          <p class="text-white/60 text-[13px] leading-snug">
            <strong class="text-white/80">Right — info:</strong> give your clip a title and any notes. AI can fill in the rest from the cover.
          </p>
        </div>

        <!-- Slide 5: Device setup -->
        <div class="welcome-slide hidden" data-slide="4">
          <h3 class="text-white/90 text-base mb-1">Set up your devices</h3>
          <p class="text-white/60 text-[13px] leading-snug mb-4">Tell VHS Garage what to read from and where to save. You can change any of this later from the bottom bar.</p>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="text-gray-400 block mb-1 text-sm">Video input</label>
              <select id="welcome-video" class="w-full bg-black border border-white/20 text-white text-sm p-2"></select>
              <span class="block mt-1 text-white/30 text-[11px]">usually your capture card</span>
            </div>
            <div>
              <label class="text-gray-400 block mb-1 text-sm">Audio input</label>
              <select id="welcome-audio" class="w-full bg-black border border-white/20 text-white text-sm p-2"></select>
              <span class="block mt-1 text-white/30 text-[11px]">usually the same capture card</span>
            </div>
            <div>
              <label class="text-gray-400 block mb-1 text-sm">Box capture device</label>
              <select id="welcome-webcam" class="w-full bg-black border border-white/20 text-white text-sm p-2"></select>
              <span class="block mt-1 text-white/30 text-[11px]">a webcam for the tape's cover</span>
            </div>
            <div>
              <label class="text-gray-400 block mb-1 text-sm">Save folder</label>
              <button id="welcome-pick-dir" class="w-full py-2 border border-white/20 text-white/60 hover:text-white text-left px-2 text-sm">
                <span id="welcome-dir-name">Choose folder...</span>
              </button>
              <span class="block mt-1 text-white/30 text-[11px]">where clips are saved on your computer</span>
            </div>
          </div>
        </div>

      </div>

      <!-- Footer: Back · dots · Skip + Next -->
      <div class="flex items-center justify-between mt-6 pt-4 border-t border-white/10">
        <button id="welcome-back" class="text-white/50 hover:text-white/80 transition-colors text-sm">← Back</button>
        <div id="welcome-dots" class="flex gap-2">
          <span class="welcome-dot inline-block w-2 h-2 bg-white/70"></span>
          <span class="welcome-dot inline-block w-2 h-2 bg-white/20"></span>
          <span class="welcome-dot inline-block w-2 h-2 bg-white/20"></span>
          <span class="welcome-dot inline-block w-2 h-2 bg-white/20"></span>
          <span class="welcome-dot inline-block w-2 h-2 bg-white/20"></span>
        </div>
        <div class="flex items-center gap-4">
          <button id="welcome-skip" class="hidden text-white/40 hover:text-white/70 transition-colors text-sm">Skip for now</button>
          <button id="welcome-next" class="text-white/80 hover:text-white transition-colors text-sm">Next →</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Hidden canvas for thumbnails and sleeve captures -->
  <canvas id="capture-canvas" class="hidden"></canvas>

  <script type="module" src={`/scripts/capture/app.js?v=${BUILD_ID}`}></script>

</Base>
