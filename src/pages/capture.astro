---
import Base from '../layouts/Base.astro';
---

<Base title="Capture" description="A browser-based VHS digitization station.">

  <style>
    .rec-btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 8px 18px;
      border: 2px solid #e53935;
      background: transparent;
      cursor: pointer;
      transition: background 0.2s;
    }
    .rec-btn:hover { background: rgba(229, 57, 53, 0.1); }

    /* Library button mirrors .rec-btn geometry (same padding, border weight,
       font size, letter-spacing) but in neutral white — gives the two primary
       deck buttons a matched pair. */
    .lib-btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 8px 18px;
      border: 2px solid rgba(255, 255, 255, 0.3);
      background: transparent;
      cursor: pointer;
      transition: background 0.2s, border-color 0.2s, color 0.2s;
      color: rgba(255, 255, 255, 0.6);
      font-family: monospace;
      font-size: 14px;
      font-weight: bold;
      letter-spacing: 0.08em;
    }
    .lib-btn:hover {
      color: rgba(255, 255, 255, 0.9);
      border-color: rgba(255, 255, 255, 0.6);
      background: rgba(255, 255, 255, 0.05);
    }
    .lib-btn svg {
      width: 24px;
      height: 24px;
      fill: currentColor;
    }

    /* Chunky pixel-corner treatment shared by outlined control buttons.
       A 2px step is clipped out of each corner so the outline reads as
       a slightly stair-stepped, VCR-ish silhouette rather than a sharp
       rectangle — the corner radius looks "pixelated" rather than smooth. */
    .pixel-btn {
      --p: 2px;
      clip-path: polygon(
        0 var(--p),
        var(--p) var(--p),
        var(--p) 0,
        calc(100% - var(--p)) 0,
        calc(100% - var(--p)) var(--p),
        100% var(--p),
        100% calc(100% - var(--p)),
        calc(100% - var(--p)) calc(100% - var(--p)),
        calc(100% - var(--p)) 100%,
        var(--p) 100%,
        var(--p) calc(100% - var(--p)),
        0 calc(100% - var(--p))
      );
    }
    .rec-btn .rec-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: #e53935;
    }
    .rec-btn .rec-label {
      font-family: monospace;
      font-size: 14px;
      font-weight: bold;
      color: #e53935;
      letter-spacing: 0.08em;
    }
    .rec-btn.recording .rec-dot {
      animation: rec-blink 0.8s steps(1) infinite;
    }
    @keyframes rec-blink {
      0%, 100% { opacity: 1; }
      50% { opacity: 0; }
    }
    .ai-loader::after {
      content: '░░░░░▒▓█░';
      animation: ai-scan 1.2s steps(1) infinite;
    }
    @keyframes ai-scan {
      0%   { content: '░░░░░▒▓█░'; }
      12%  { content: '█░░░░░▒▓█'; }
      25%  { content: '▓█░░░░░▒▓'; }
      37%  { content: '▒▓█░░░░░▒'; }
      50%  { content: '░▒▓█░░░░░'; }
      62%  { content: '░░▒▓█░░░░'; }
      75%  { content: '░░░▒▓█░░░'; }
      87%  { content: '░░░░▒▓█░░'; }
    }
    #preview-container.recording-active {
      border: 3px solid #e53935;
      box-shadow: inset 0 0 30px rgba(229, 57, 53, 0.15);
    }
    #rec-overlay-timer {
      font-size: 2rem;
      letter-spacing: 0.05em;
    }
    @keyframes scan-trace {
      0% { background-position: 0% 0%; }
      100% { background-position: 300% 0%; }
    }
    #sleeve-target .scan-border {
      transition: border-color 0.3s, box-shadow 0.3s;
    }
    #sleeve-target .scan-border.scanning {
      box-shadow: 0 0 12px rgba(34,197,94,0.3), inset 0 0 12px rgba(34,197,94,0.1);
      animation: scan-pulse 1.5s ease-in-out infinite;
    }
    @keyframes scan-pulse {
      0%, 100% { box-shadow: 0 0 8px rgba(34,197,94,0.2), inset 0 0 8px rgba(34,197,94,0.05); }
      50% { box-shadow: 0 0 18px rgba(34,197,94,0.5), inset 0 0 18px rgba(34,197,94,0.15); }
    }
    .scanlines {
      background: repeating-linear-gradient(
        0deg,
        transparent,
        transparent 2px,
        rgba(0, 0, 0, 0.08) 2px,
        rgba(0, 0, 0, 0.08) 4px
      );
      pointer-events: none;
    }
  </style>

  <!-- Browser check -->
  <div id="browser-check" class="hidden fixed inset-0 z-50 bg-black flex items-center justify-center p-8">
    <div class="max-w-md text-center">
      <p class="text-2xl mb-4">VHS Capture requires Chrome</p>
      <p class="text-gray-400 text-sm">This app uses the File System Access API to write recordings directly to disk. This API is only available in Chrome.</p>
    </div>
  </div>

  <!-- Three-column grid + bottom status bar. Status bar is a sibling of
       the padded content wrapper so it runs edge-to-edge across the viewport. -->
  <div id="capture-app" class="h-screen flex flex-col">
    <!-- Content area: padded + capped width, centered -->
    <div class="flex-1 min-h-0 w-full max-w-[1400px] mx-auto p-4 pb-5 flex flex-col">
    <div class="flex-1 grid md:grid-cols-[1fr_300px] lg:grid-cols-[1fr_280px_280px] gap-3 min-h-0">

      <!-- Left: Main Capture -->
      <div class="flex flex-col min-h-0">
        <fieldset class="flex-1 flex flex-col min-h-0 border border-white/20 p-3">
          <legend id="preview-legend" class="text-white/70 text-[11px] tracking-wider px-2 transition-colors">░ Live ░</legend>
          <!-- Preview -->
          <div id="preview-container" class="relative flex-1 bg-[#141214] border border-white/10 overflow-hidden cursor-pointer">
            <video id="preview" autoplay playsinline muted class="w-full h-full object-contain bg-black"></video>
            <video id="playback" controls class="hidden w-full h-full object-contain bg-black"></video>
            <div class="scanlines absolute inset-0"></div>
            <div id="rec-overlay-timer" class="hidden absolute top-3 right-4 text-red-500 tabular-nums z-10" style="text-shadow: 0 0 10px rgba(229,57,53,0.7), 0 0 20px rgba(229,57,53,0.4);">
              00:00:00
            </div>
            <!-- Shown when no device selected -->
            <div id="no-signal" class="absolute inset-0 flex items-center justify-center">
              <div class="text-center">
                <p class="text-white/50 text-sm mb-2">No capture device</p>
                <p class="text-white/70 text-xs">Click to select</p>
              </div>
            </div>
            <!-- Inline device selector (hidden by default) -->
            <div id="device-selector" class="hidden absolute inset-0 bg-black/90 flex items-center justify-center">
              <div class="w-64">
                <p class="text-sm mb-3">Select capture device</p>
                <select id="select-video" class="w-full bg-black border border-white/30 text-white text-xs p-2 mb-2"></select>
                <select id="select-audio" class="w-full bg-black border border-white/30 text-white text-xs p-2 mb-3"></select>
                <button id="select-video-ok" class="w-full py-2 border border-white/30 text-white/60 hover:text-white text-xs">Connect</button>
              </div>
            </div>
          </div>

          <!-- Audio spectrum meter -->
          <canvas id="audio-meter" class="w-full h-6 mt-0" style="image-rendering: pixelated;"></canvas>

          <!-- Controls below preview -->
          <div class="flex items-center gap-3 py-2">
            <button id="rec-btn" class="rec-btn pixel-btn shrink-0" title="Record">
              <span class="rec-dot"></span><span class="rec-label">REC</span>
            </button>
            <button id="mute-btn" class="shrink-0 text-white/40 hover:text-white/70 transition-colors" title="Toggle audio">
              <svg id="mute-icon-on" class="w-5 h-5 hidden" viewBox="0 0 24 24" fill="currentColor"><path d="M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"/></svg>
              <svg id="mute-icon-off" class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3L3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4L9.91 6.09 12 8.18V4z"/></svg>
            </button>
            <span id="rec-timer" class="text-lg tabular-nums">00:00:00</span>
            <span id="rec-size" class="text-xs text-white/40">0.0 MB</span>
            <div class="flex-1"></div>
            <button id="save-data-btn" class="hidden text-xs py-1.5 px-3 border-2 border-red-500 text-red-500 hover:bg-red-500 hover:text-black transition-colors">Save Data</button>
            <button id="publish-yt-btn" class="hidden text-xs py-1.5 px-3 border border-white/30 text-white/50 hover:text-white hover:border-white/60 transition-colors">▶ YouTube</button>
            <button id="delete-recording-btn" class="hidden text-red-500 hover:text-red-400 transition-colors text-xs">Delete</button>
            <button id="to-library-btn" class="lib-btn pixel-btn shrink-0" title="Library">
              <svg viewBox="0 0 1200 1200" aria-hidden="true">
                <path d="m626.62 262.9h81.336v81.332h-81.336z"/>
                <path d="m535.12 351.86h81.336v81.332h-81.336z"/>
                <path d="m809.62 351.86h81.332v81.332h-81.332z"/>
                <path d="m352.12 440.82h81.332v81.336h-81.332z"/>
                <path d="m443.62 440.82h81.332v81.336h-81.332z"/>
                <path d="m626.62 440.82h81.336v81.336h-81.336z"/>
                <path d="m718.12 440.82h81.332v81.336h-81.332z"/>
                <path d="m535.12 529.78h81.336v81.332h-81.336z"/>
                <path d="m626.62 529.78h81.336v81.332h-81.336z"/>
                <path d="m352.12 618.74h81.332v81.332h-81.332z"/>
                <path d="m443.62 618.74h81.332v81.332h-81.332z"/>
                <path d="m535.12 618.74h81.336v81.332h-81.336z"/>
                <path d="m626.62 618.74h81.336v81.332h-81.336z"/>
                <path d="m809.62 618.74h81.332v81.332h-81.332z"/>
                <path d="m443.62 707.7h81.332v81.336h-81.332z"/>
                <path d="m535.12 707.7h81.336v81.336h-81.336z"/>
                <path d="m718.12 707.7h81.332v81.336h-81.332z"/>
                <path d="m809.62 707.7h81.332v81.336h-81.332z"/>
                <path d="m352.12 796.66h81.332v81.332h-81.332z"/>
                <path d="m443.62 796.66h81.332v81.332h-81.332z"/>
                <path d="m535.12 796.66h81.336v81.332h-81.336z"/>
                <path d="m626.62 796.66h81.336v81.332h-81.336z"/>
                <path d="m718.12 796.66h81.332v81.332h-81.332z"/>
                <path d="m809.62 796.66h81.332v81.332h-81.332z"/>
                <path d="m352.12 885.62h81.332v81.332h-81.332z"/>
                <path d="m443.62 885.62h81.332v81.332h-81.332z"/>
                <path d="m535.12 885.62h81.336v81.332h-81.336z"/>
                <path d="m626.62 885.62h81.336v81.332h-81.336z"/>
                <path d="m718.12 885.62h81.332v81.332h-81.332z"/>
                <path d="m809.62 885.62h81.332v81.332h-81.332z"/>
              </svg>
              Library
            </button>
          </div>
        </fieldset>
      </div>

      <!-- Columns 2+3: stacked at md, side-by-side at lg -->
      <div class="md:flex md:flex-col md:gap-3 md:min-h-0 md:overflow-y-auto lg:contents">

        <!-- Column 2: Cover Snap -->
        <div class="flex flex-col min-h-0">
          <fieldset class="flex-1 min-h-0 flex flex-col border border-white/20 p-3">
            <legend class="text-white/70 text-[11px] tracking-wider px-2">░ VHS Sleeve ░</legend>
            <div class="flex-1 min-h-0 overflow-y-auto">

            <!-- Front capture/preview -->
            <div id="sleeve-front-section">
              <p class="text-white/40 text-[10px] uppercase tracking-widest mb-1">Front</p>
              <div id="sleeve-front-preview" class="hidden aspect-[4/3] bg-[#141214] border border-white/10 mb-2 overflow-hidden">
                <span class="flex items-center justify-center w-full h-full text-white/10 text-[10px]">--</span>
              </div>
            </div>

            <!-- Webcam + capture view -->
            <div id="sleeve-capture-view">
              <div id="webcam-container" class="relative bg-[#141214] border border-white/10 aspect-[4/3] overflow-hidden cursor-pointer mb-2">
                <video id="sleeve-webcam" autoplay playsinline muted class="w-full h-full object-contain bg-black"></video>
                <!-- Detection status -->
                <div id="detect-hud" class="absolute top-2 left-2 right-2 flex items-center gap-2 pointer-events-none z-10">
                  <span id="detect-dot" style="width:8px;height:8px;border-radius:50%;background:#555;flex-shrink:0;transition:background 0.2s;"></span>
                  <span id="detect-label" style="font-size:10px;color:rgba(255,255,255,0.3);transition:color 0.2s;">Waiting...</span>
                  <span style="flex:1;"></span>
                  <span id="detect-countdown" style="font-size:10px;color:rgba(255,255,255,0.2);font-variant-numeric:tabular-nums;"></span>
                </div>
                <!-- Snap progress bar -->
                <div style="position:absolute;bottom:0;left:0;right:0;height:3px;background:rgba(255,255,255,0.05);z-index:10;pointer-events:none;">
                  <div id="detect-progress" style="height:100%;width:0%;background:#4caf50;transition:width 0.12s;"></div>
                </div>
                <!-- Translucent VHS case target overlay -->
                <div id="sleeve-target" class="absolute inset-0 flex items-center justify-center pointer-events-none">
                  <div class="scan-border aspect-[17/30] h-[70%] border-2 border-white/25 rounded-lg flex flex-col items-center justify-end pb-2 gap-1">
                    <span id="scan-status" class="text-white/30 text-[10px]">Scanning</span>
                    <span class="text-white/15 text-[10px]">Position sleeve here</span>
                  </div>
                </div>
                <!-- No webcam placeholder -->
                <div id="no-webcam" class="absolute inset-0 flex items-center justify-center">
                  <div class="text-center">
                    <p class="text-white/50 text-xs mb-1">No webcam</p>
                    <p class="text-white/70 text-[10px]">Click to select</p>
                  </div>
                </div>
                <!-- Inline webcam selector -->
                <div id="webcam-selector" class="hidden absolute inset-0 bg-black/90 flex items-center justify-center">
                  <div class="w-48">
                    <p class="text-xs mb-2">Select webcam</p>
                    <select id="select-webcam" class="w-full bg-black border border-white/30 text-white text-xs p-2 mb-2"></select>
                    <button id="select-webcam-ok" class="w-full py-1 border border-white/30 text-white/60 hover:text-white text-xs">Connect</button>
                  </div>
                </div>
              </div>
              <button id="sleeve-capture-btn" class="w-full py-2 border border-white/30 text-white/60 hover:text-white hover:border-white/60 transition-colors text-xs">
                <span id="sleeve-capture-label">Capture Front</span>
              </button>
            </div>

            <!-- Back section: always visible. Shows a dim skeleton while waiting
                 for the front to be captured, the live webcam during back
                 capture (moved in by JS), then the captured back preview. -->
            <div id="sleeve-back-section" style="margin-top:0.5rem;">
              <p class="text-white/40 text-[10px] uppercase tracking-widest mb-1">Back</p>
              <div id="sleeve-back-preview" class="hidden aspect-[4/3] bg-[#141214] border border-white/10 mb-2 overflow-hidden">
                <span class="flex items-center justify-center w-full h-full text-white/10 text-[10px]">--</span>
              </div>
              <div id="sleeve-back-skeleton" class="aspect-[4/3] bg-[#0a0a0a] border border-dashed border-white/10 flex items-center justify-center mb-2">
                <span class="text-white/15 text-[10px] uppercase tracking-widest">Waits for front</span>
              </div>
            </div>

            <!-- Retake (shown when both captured) -->
            <div id="sleeve-review-view" class="hidden">
              <button id="sleeve-retake-btn" class="w-full py-2 border border-white/30 text-white/60 hover:text-white hover:border-white/60 transition-colors text-xs">Retake</button>
            </div>
            </div><!-- /scroll wrapper -->
            <button id="reset-sleeve-btn" class="shrink-0 flex items-center gap-1.5 mt-3 pt-2 border-t border-white/10 text-white/30 hover:text-white/70 text-[10px] text-left transition-colors">
              <span class="inline-flex items-center justify-center w-3 h-3 border border-current leading-none text-[9px]">×</span>
              Reset covers
            </button>
          </fieldset>
        </div>

        <!-- Column 3: Details -->
        <div class="flex flex-col min-h-0">
          <fieldset class="flex-1 min-h-0 flex flex-col border border-white/20 p-3">
            <legend class="text-white/70 text-[11px] tracking-wider px-2">░ Clip Info ░</legend>
            <div class="flex-1 min-h-0 overflow-y-auto">
            <div id="clip-info-fields" class="space-y-2 text-xs">
              <div>
                <label class="text-white/40 text-[10px] uppercase tracking-widest block mb-1">Clip Title</label>
                <input id="clip-title" type="text" placeholder="My Home Videos 1994"
                  class="w-full px-2 py-1.5 bg-black border border-white/20 text-white text-xs placeholder-white/25 focus:outline-none focus:border-white/40" />
              </div>
              <div>
                <label class="text-white/40 text-[10px] uppercase tracking-widest block mb-1">Description</label>
                <textarea id="clip-description" rows="2" placeholder="What's on this clip..."
                  class="w-full px-2 py-1.5 bg-black border border-white/20 text-white text-xs placeholder-white/25 focus:outline-none focus:border-white/40 resize-none"></textarea>
              </div>
              <div id="ai-fields" class="space-y-2">
                <div id="clip-info-loader" class="hidden py-4 text-center text-white/40 text-sm ai-loader"></div>
                <div>
                  <label class="text-white/40 text-[10px] uppercase tracking-widest block mb-1">Year</label>
                  <input id="clip-year" type="text" placeholder="1994"
                    class="w-full px-2 py-1.5 bg-black border border-white/20 text-white text-xs placeholder-white/25 focus:outline-none focus:border-white/40" />
                </div>
                <div>
                  <label class="text-white/40 text-[10px] uppercase tracking-widest block mb-1">Tags</label>
                  <input id="clip-tags" type="text" placeholder="home video, 90s, family"
                    class="w-full px-2 py-1.5 bg-black border border-white/20 text-white text-xs placeholder-white/25 focus:outline-none focus:border-white/40" />
                </div>
                <div>
                  <label class="text-white/40 text-[10px] uppercase tracking-widest block mb-1">VHS Tape</label>
                  <input id="clip-tape" type="text" placeholder="Which tape is this from?"
                    class="w-full px-2 py-1.5 bg-black border border-white/20 text-white text-xs placeholder-white/25 focus:outline-none focus:border-white/40" />
                </div>
                <div>
                  <label class="text-white/40 text-[10px] uppercase tracking-widest block mb-1">Distributor</label>
                  <input id="clip-distributor" type="text" placeholder="Warner, Paramount, Sony..."
                    class="w-full px-2 py-1.5 bg-black border border-white/20 text-white text-xs placeholder-white/25 focus:outline-none focus:border-white/40" />
                </div>
                <div class="grid grid-cols-3 gap-2">
                  <div>
                    <label class="text-white/40 text-[10px] uppercase tracking-widest block mb-1">Tape</label>
                    <input id="clip-tape-length" type="text" placeholder="T-120"
                      class="w-full px-2 py-1.5 bg-black border border-white/20 text-white text-xs placeholder-white/25 focus:outline-none focus:border-white/40" />
                  </div>
                  <div>
                    <label class="text-white/40 text-[10px] uppercase tracking-widest block mb-1">Speed</label>
                    <input id="clip-speed" type="text" placeholder="SP"
                      class="w-full px-2 py-1.5 bg-black border border-white/20 text-white text-xs placeholder-white/25 focus:outline-none focus:border-white/40" />
                  </div>
                  <div>
                    <label class="text-white/40 text-[10px] uppercase tracking-widest block mb-1">Condition</label>
                    <input id="clip-condition" type="text" placeholder="Good"
                      class="w-full px-2 py-1.5 bg-black border border-white/20 text-white text-xs placeholder-white/25 focus:outline-none focus:border-white/40" />
                  </div>
                </div>
                <div>
                  <label class="text-white/40 text-[10px] uppercase tracking-widest block mb-1">Cassette Notes</label>
                  <textarea id="clip-notes" rows="2" placeholder="Special edition, director's cut, other details..."
                    class="w-full px-2 py-1.5 bg-black border border-white/20 text-white text-xs placeholder-white/25 focus:outline-none focus:border-white/40 resize-none"></textarea>
                </div>
              </div>
            </div>
            </div><!-- /scroll wrapper -->
            <button id="reset-info-btn" class="shrink-0 flex items-center gap-1.5 mt-3 pt-2 border-t border-white/10 text-white/30 hover:text-white/70 text-[10px] text-left transition-colors">
              <span class="inline-flex items-center justify-center w-3 h-3 border border-current leading-none text-[9px]">×</span>
              Reset info
            </button>
          </fieldset>
        </div>

      </div>
    </div>

    </div><!-- /content area -->

    <!-- Bottom status bar — full viewport width, locked to the bottom, styled
         like a classic desktop-software status bar: thin top border, segment
         dividers, bold logo on the left, clickable device segments in the
         middle, help on the right. -->
    <div id="status-bar" class="flex items-stretch text-[10px] text-white/60 border-t border-white/20 bg-[#141214] shrink-0 select-none py-[5px]" style="box-shadow: inset 0 1px 0 rgba(255,255,255,0.04);">
      <!-- Logo (decorative) -->
      <div class="flex items-center gap-2 px-3 py-2 border-r border-white/15 shrink-0">
        <span class="inline-block w-1.5 h-1.5 bg-red-500" style="box-shadow: 0 0 6px rgba(229,57,53,0.6);"></span>
        <span class="text-white/80 font-bold tracking-[0.15em] uppercase">VHS Garage Recorder</span>
      </div>

