              <div>
                <label class="text-white/40 text-[10px] uppercase tracking-widest block mb-1">Description</label>
                <div class="relative">
                  <textarea id="clip-description" rows="2" placeholder="What's on this clip..." maxlength="5000"
                    data-char-counter="counter-clip-description" data-char-max="5000"
