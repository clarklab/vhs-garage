                  <button id="yt-pub-ai-desc" type="button"
                          class="absolute right-2 top-2 text-white/30 hover:text-red-400 transition-colors leading-none"
                          title="AI rewrite description">
                    <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 100 100" aria-hidden="true">
                      <path d="m71.293 57.371c-20.738-4.6836-23.953-7.8945-28.637-28.637-0.21484-0.94922-1.0586-1.6211-2.0352-1.6211-0.97656 0-1.8203 0.67578-2.0352 1.6211-4.6836 20.738-7.8945 23.953-28.637 28.637-0.94922 0.21484-1.625 1.0586-1.625 2.0352s0.67578 1.8164 1.625 2.0352c20.738 4.6836 23.949 7.8984 28.637 28.637 0.21484 0.94922 1.0586 1.6211 2.0352 1.6211 0.97656 0 1.8203-0.67578 2.0352-1.6211 4.6836-20.738 7.8945-23.949 28.637-28.637 0.94922-0.21484 1.6211-1.0586 1.6211-2.0352s-0.67578-1.8164-1.6211-2.0352z"/>
                      <path d="m90.043 25.082c-11.023-2.4883-12.574-4.0391-15.062-15.059-0.21484-0.94922-1.0586-1.6211-2.0352-1.6211-0.97656 0-1.8164 0.67188-2.0352 1.6211-2.4883 11.023-4.0391 12.57-15.059 15.059-0.94922 0.21484-1.6211 1.0586-1.6211 2.0352 0 0.97656 0.67188 1.8164 1.6211 2.0352 11.023 2.4883 12.57 4.0391 15.059 15.062 0.21484 0.94922 1.0586 1.6211 2.0352 1.6211 0.97656 0 1.8164-0.67578 2.0352-1.6211 2.4883-11.023 4.0391-12.574 15.062-15.062 0.94922-0.21484 1.6211-1.0586 1.6211-2.0352 0-0.97656-0.67578-1.8164-1.6211-2.0352z"/>
