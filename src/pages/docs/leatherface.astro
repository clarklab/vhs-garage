---
import Base from '../../layouts/Base.astro';
import { getSpec } from '../../data/specs.js';

const spec = getSpec('leatherface');

const totalUnits = spec.sizes.reduce((n, s) => n + s.qty, 0);
const total = spec.sizes.reduce((n, s) => n + s.qty * s.unit, 0);
const usd = (n) => `$${n.toFixed(2)}`;

// Money, all derived — change a quantity or the fee and every figure below
// follows. Nothing here is typed in twice.
const { printingFee, printer, sellPrice } = spec.money;
const totalCost = total + printingFee;
const costPerShirt = totalCost / totalUnits;
const revenue = sellPrice * totalUnits;
const profit = revenue - totalCost;
const profitPerShirt = profit / totalUnits;
---

<Base
  title={`${spec.docNo} — ${spec.title}`}
  description={`Screenprint spec for the VHS Garage "${spec.title}" tee.`}
>
  <meta slot="head" name="robots" content="noindex, nofollow" />

  <style>
    /* White drafting sheet. Light-only by design — this gets printed and
       emailed to a printer, so it should look the same everywhere. */
    .sheet {
      --ink: #14110f;
      --dim: #6f6a64;
      --rule: #d6d2cb;
      --accent: #dc2626;

      background: #fbfaf8;
      color: var(--ink);
      min-height: 100svh;
      font-size: 13px;
      line-height: 1.5;
      letter-spacing: 0.02em;
    }
    .frame { max-width: 760px; margin: 0 auto; padding: 24px 20px 60px; }

    .box {
      border: 1px solid var(--ink);
      background: #fff;
      position: relative;
    }
    .tick {
      position: absolute;
      width: 10px;
      height: 10px;
      border: 0 solid var(--accent);
    }
    .tick.tl { top: -1px; left: -1px; border-top-width: 2px; border-left-width: 2px; }
    .tick.br { bottom: -1px; right: -1px; border-bottom-width: 2px; border-right-width: 2px; }

    header { padding: 20px 22px 18px; border-bottom: 1px solid var(--ink); }
    .eyebrow {
      display: flex;
      flex-wrap: wrap;
      gap: 4px 16px;
      justify-content: space-between;
      font-size: 9px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--dim);
    }
    h1 {
      font-size: 38px;
      line-height: 1;
      text-transform: uppercase;
      margin: 12px 0 4px;
    }
    .sub { font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--dim); }

    /* --- the two files --- */
    .figs { display: grid; grid-template-columns: 1fr; }
    @media (min-width: 620px) { .figs { grid-template-columns: 1fr 1fr; } }
    /* The art is wide and short, the tee is tall — flex the figure so the
       shorter image centers in its cell instead of stranding whitespace. */
    .fig {
      padding: 18px;
      border-bottom: 1px solid var(--rule);
      display: flex;
      flex-direction: column;
    }
    .fig img { margin-block: auto; }
    /* The separation is white ink on transparent — invisible on white paper,
       so it sits on a black plate that stands in for the shirt. */
    .fig img.on-dark {
      background: #111;
      border-color: #111;
      padding: 10px;
      print-color-adjust: exact;
      -webkit-print-color-adjust: exact;
    }
    .fig + .fig { border-left: 0; }
    @media (min-width: 620px) { .fig + .fig { border-left: 1px solid var(--rule); } }
    .fig img {
      display: block;
      width: 100%;
      height: auto;
      border: 1px solid var(--rule);
      background: #fff;
    }
    .cap {
      display: flex;
      flex-wrap: wrap;
      gap: 2px 10px;
      justify-content: space-between;
      margin-top: 9px;
      font-size: 9px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--dim);
    }
    .cap b { color: var(--ink); font-weight: normal; }

    /* --- facts + pricing --- */
    .pad { padding: 18px 22px 20px; }
    .pad + .pad { border-top: 1px solid var(--rule); }

    table { width: 100%; border-collapse: collapse; }
    th {
      text-align: left;
      font-size: 8px;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--dim);
      font-weight: normal;
      padding: 0 8px 6px 0;
      border-bottom: 1px solid var(--ink);
    }
    td { padding: 7px 8px 7px 0; border-bottom: 1px dotted var(--rule); }
    tr:last-child td { border-bottom: 0; }
    th:last-child, td:last-child { text-align: right; padding-right: 0; }
    .k {
      font-size: 10px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--dim);
      width: 90px;
      white-space: nowrap;
    }
    .big { font-size: 15px; }
    .num { text-align: right; white-space: nowrap; }
    tr.rule td { border-top: 1px solid var(--rule); border-bottom: 0; padding-top: 8px; }
    tr.total td {
      border-top: 1px solid var(--ink);
      border-bottom: 0;
      padding-top: 9px;
      font-size: 15px;
    }
    /* Beats `tr.total td`, which would otherwise bump this to 15px and
       flatten the hierarchy of the profit line. */
    tr.total td.sub-note {
      font-size: 9px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--dim);
    }
    .note {
      margin-top: 10px;
      font-size: 10px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--dim);
      line-height: 1.6;
    }

    .foot {
      display: flex;
      flex-wrap: wrap;
      gap: 4px 16px;
      justify-content: space-between;
      border-top: 1px solid var(--ink);
      padding: 10px 22px;
      font-size: 9px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--dim);
    }

    @media print {
      .sheet { background: #fff; }
      .no-print { display: none !important; }
      .frame { max-width: none; padding: 0; }
      .figs, .box { break-inside: avoid; }
      @page { margin: 14mm; }
    }
  </style>

  <main class="sheet">
    <div class="frame">
      <nav class="no-print" style="display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-bottom:12px;font-size:10px;letter-spacing:.16em;text-transform:uppercase;">
        <a href="/docs" style="color:var(--accent);text-decoration:none;">&larr; Docs</a>
        <span style="color:var(--dim);">Print this page for a PDF</span>
      </nav>

      <div class="box">
        <span class="tick tl"></span><span class="tick br"></span>

        <header>
          <div class="eyebrow">
            <span>VHS Garage / Apparel</span>
            <span>{spec.docNo} &nbsp;Rev {spec.rev} &nbsp;·&nbsp; {spec.issued}</span>
          </div>
          <h1>{spec.title}</h1>
          <p class="sub">{spec.subtitle}</p>
        </header>

        <div class="figs">
          <figure class="fig">
            <img class={spec.art.dark ? 'on-dark' : ''} src={spec.art.href} alt="Leatherface art file" />
            <figcaption class="cap"><b>{spec.art.label}</b><span>{spec.art.note}</span></figcaption>
          </figure>
          <figure class="fig">
            <img src={spec.preview.href} alt="Leatherface tee mockup" />
            <figcaption class="cap"><b>{spec.preview.label}</b><span>{spec.preview.note}</span></figcaption>
          </figure>
        </div>

        <div class="pad">
          <table>
            <tbody>
              {spec.facts.map(([k, v]) => (
                <tr>
                  <td class="k">{k}</td>
                  <td class="big">{v}</td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="note">{spec.inkNote}</p>
        </div>

        <div class="pad">
          <table>
            <thead>
              <tr><th>Size</th><th>Qty</th><th>Each</th><th>Total</th></tr>
            </thead>
            <tbody>
              {spec.sizes.map((s) => (
                <tr>
                  <td>{s.size}</td>
                  <td>{s.qty}</td>
                  <td>{usd(s.unit)}</td>
                  <td>{usd(s.qty * s.unit)}</td>
                </tr>
              ))}
              <tr class="total">
                <td>Total</td>
                <td>{totalUnits}</td>
                <td></td>
                <td>{usd(total)}</td>
              </tr>
            </tbody>
          </table>
          <p class="note">Shirts only — printing not included</p>
        </div>

        <div class="pad">
          <table>
            <tbody>
              <tr>
                <td class="k">Shirts</td>
                <td>{totalUnits} blanks</td>
                <td class="num">{usd(total)}</td>
              </tr>
              <tr>
                <td class="k">Printing</td>
                <td>{printer}</td>
                <td class="num">{usd(printingFee)}</td>
              </tr>
              <tr class="rule">
                <td class="k">Total cost</td>
                <td></td>
                <td class="num">{usd(totalCost)}</td>
              </tr>
              <tr>
                <td class="k">Cost each</td>
                <td></td>
                <td class="num">{usd(costPerShirt)}</td>
              </tr>
              <tr>
                <td class="k">Sell at</td>
                <td></td>
                <td class="num">{usd(sellPrice)}</td>
              </tr>
              <tr class="total">
                <td class="k">Profit</td>
                <td class="sub-note">{usd(profitPerShirt)} each &nbsp;·&nbsp; all {totalUnits} sold</td>
                <td class="num">{usd(profit)}</td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="foot">
          <span>{spec.docNo} Rev {spec.rev}</span>
          <span>vhsgarage.com</span>
        </div>
      </div>
    </div>
  </main>
</Base>
