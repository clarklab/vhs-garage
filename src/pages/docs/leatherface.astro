---
import Base from '../../layouts/Base.astro';
import { getSpec } from '../../data/specs.js';

const spec = getSpec('leatherface');

// Anything still marked TBD gets flagged in red so a reader can't skim past
// an unconfirmed number. Values arrive as strings from src/data/specs.js.
const isTBD = (v) => typeof v === 'string' && /\bTBD\b/.test(v);

// Totals are derived from the line items rather than stored, so the sheet
// can never disagree with itself after someone edits a quantity.
const rows = spec.sizeRun.rows;
const totalUnits = rows.reduce((n, r) => n + r.qty, 0);
const blanksSubtotal = rows.reduce((n, r) => n + r.qty * r.unit, 0);
const avgPerUnit = blanksSubtotal / totalUnits;
const usd = (n) => `$${n.toFixed(2)}`;
---

<Base
  title={`${spec.docNo} — ${spec.title}`}
  description={`Screenprint production specification for the VHS Garage "${spec.title}" tee. Artwork, placement, ink, and size run.`}
>
  <meta slot="head" name="robots" content="noindex, nofollow" />

  <style>
    /* ---- Blueprint sheet -------------------------------------------------
       Dark drafting-table look on screen: engineering grid, hairline rules,
       everything on a 1px stroke. The print stylesheet at the bottom flips
       the whole thing to black-on-white so it survives a laser printer and
       a "Save as PDF" to the printer. */
    .sheet {
      --ink: #e8e6e0;
      /* --strong is the "brightest" ink — headings, key values. It's a
         variable rather than a literal #fff because the print stylesheet
         flips it to black; a hardcoded white heading prints invisible. */
      --strong: #ffffff;
      --ink-dim: #8a8781;
      --ink-faint: #55534f;
      --rule: rgba(232, 230, 224, 0.22);
      --rule-soft: rgba(232, 230, 224, 0.1);
      --accent: #dc2626;
      --dim: #6ea8c7;
      --paper: #07070a;

      background-color: var(--paper);
      background-image:
        linear-gradient(var(--rule-soft) 1px, transparent 1px),
        linear-gradient(90deg, var(--rule-soft) 1px, transparent 1px),
        linear-gradient(rgba(232, 230, 224, 0.04) 1px, transparent 1px),
        linear-gradient(90deg, rgba(232, 230, 224, 0.04) 1px, transparent 1px);
      background-size: 96px 96px, 96px 96px, 16px 16px, 16px 16px;
      color: var(--ink);
      min-height: 100svh;
      font-size: 12px;
      line-height: 1.5;
      letter-spacing: 0.02em;
    }

    .frame {
      max-width: 1080px;
      margin: 0 auto;
      padding: 28px 20px 64px;
    }

    /* The drawing border — a real one has a double rule and corner ticks. */
    .border-box {
      border: 1px solid var(--rule);
      box-shadow: 0 0 0 4px rgba(232, 230, 224, 0.05);
      position: relative;
      background: rgba(7, 7, 10, 0.72);
    }
    .tick {
      position: absolute;
      width: 14px;
      height: 14px;
      border: 0 solid var(--accent);
      pointer-events: none;
    }
    .tick.tl { top: -1px; left: -1px; border-top-width: 2px; border-left-width: 2px; }
    .tick.tr { top: -1px; right: -1px; border-top-width: 2px; border-right-width: 2px; }
    .tick.bl { bottom: -1px; left: -1px; border-bottom-width: 2px; border-left-width: 2px; }
    .tick.br { bottom: -1px; right: -1px; border-bottom-width: 2px; border-right-width: 2px; }

    /* ---- Title block ---------------------------------------------------- */
    .titleblock {
      display: grid;
      grid-template-columns: 1fr;
      border-bottom: 1px solid var(--rule);
    }
    @media (min-width: 760px) {
      .titleblock { grid-template-columns: 1fr 300px; }
    }
    .titleblock-main { padding: 22px 24px 20px; }
    .titleblock-meta {
      border-top: 1px solid var(--rule);
      display: grid;
      grid-template-columns: repeat(2, 1fr);
    }
    @media (min-width: 760px) {
      .titleblock-meta {
        border-top: 0;
        border-left: 1px solid var(--rule);
        grid-template-columns: repeat(2, 1fr);
      }
    }
    .cell {
      padding: 8px 12px 9px;
      border-right: 1px solid var(--rule-soft);
      border-bottom: 1px solid var(--rule-soft);
      min-width: 0;
    }
    .cell:nth-child(2n) { border-right: 0; }
    .cell-k {
      font-size: 8px;
      letter-spacing: 0.16em;
      color: var(--ink-faint);
      text-transform: uppercase;
      display: block;
      margin-bottom: 3px;
    }
    .cell-v { font-size: 12px; color: var(--ink); word-break: break-word; }

    .eyebrow {
      font-size: 9px;
      letter-spacing: 0.24em;
      color: var(--ink-dim);
      text-transform: uppercase;
    }
    .doc-title {
      font-size: 40px;
      line-height: 0.95;
      margin: 12px 0 6px;
      color: var(--strong);
      text-transform: uppercase;
      letter-spacing: 0.01em;
    }
    @media (min-width: 760px) { .doc-title { font-size: 58px; } }

    .stamp {
      display: inline-block;
      border: 2px solid var(--accent);
      color: var(--accent);
      font-size: 10px;
      letter-spacing: 0.18em;
      padding: 4px 10px;
      text-transform: uppercase;
      transform: rotate(-1.5deg);
    }

    /* ---- Sections -------------------------------------------------------- */
    .section { border-bottom: 1px solid var(--rule); }
    .section:last-child { border-bottom: 0; }
    .section-head {
      display: flex;
      align-items: baseline;
      gap: 12px;
      padding: 14px 24px 12px;
      border-bottom: 1px solid var(--rule-soft);
      background: rgba(232, 230, 224, 0.03);
    }
    .section-no {
      color: var(--accent);
      font-size: 11px;
      letter-spacing: 0.1em;
      flex: none;
    }
    .section-title {
      font-size: 13px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--strong);
    }
    .section-note {
      margin-left: auto;
      font-size: 9px;
      letter-spacing: 0.12em;
      color: var(--ink-faint);
      text-transform: uppercase;
    }
    .section-body { padding: 18px 24px 22px; }

    /* ---- Spec tables ----------------------------------------------------- */
    .spec-table { width: 100%; border-collapse: collapse; }
    .spec-table th {
      text-align: left;
      font-size: 8px;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--ink-faint);
      font-weight: normal;
      padding: 0 10px 7px 0;
      border-bottom: 1px solid var(--rule);
    }
    .spec-table td {
      padding: 7px 10px 7px 0;
      border-bottom: 1px dotted var(--rule-soft);
      vertical-align: top;
      font-size: 12px;
    }
    .spec-table td.k {
      color: var(--ink-dim);
      width: 40%;
      white-space: nowrap;
      font-size: 10px;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      padding-top: 8px;
    }
    .spec-table tr:last-child td { border-bottom: 0; }
    .spec-table tr.total-row td {
      border-top: 1px solid var(--rule);
      border-bottom: 0;
      padding-top: 9px;
    }
    .tbd { color: var(--accent); }

    .cols { display: grid; gap: 0; }
    @media (min-width: 860px) {
      .cols { grid-template-columns: 1fr 1fr; gap: 0 40px; }
      .cols > * { min-width: 0; }
    }

    /* ---- Asset plates ---------------------------------------------------- */
    .plate {
      border: 1px solid var(--rule);
      background:
        repeating-linear-gradient(45deg, rgba(232, 230, 224, 0.03) 0 8px, transparent 8px 16px);
      position: relative;
    }
    .plate-img {
      display: block;
      width: 100%;
      height: auto;
      background: #101014;
    }
    .plate-missing {
      display: none;
      padding: 46px 20px;
      text-align: center;
      color: var(--ink-faint);
      font-size: 10px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      line-height: 2;
    }
    .plate.is-missing .plate-img { display: none; }
    .plate.is-missing .plate-missing { display: block; }
    .plate-missing code {
      color: var(--accent);
      letter-spacing: 0.04em;
      text-transform: none;
      font-size: 11px;
    }
    .plate-cap {
      display: flex;
      flex-wrap: wrap;
      gap: 4px 12px;
      justify-content: space-between;
      border-top: 1px solid var(--rule);
      padding: 7px 10px;
      font-size: 9px;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--ink-dim);
    }

    /* ---- Technical drawing ----------------------------------------------- */
    .drawing { width: 100%; height: auto; display: block; }
    .dwg-outline { fill: rgba(232, 230, 224, 0.04); stroke: var(--ink); stroke-width: 1.6; }
    .dwg-detail { fill: none; stroke: var(--ink-dim); stroke-width: 1; }
    .dwg-center { stroke: var(--accent); stroke-width: 0.8; stroke-dasharray: 10 4 2 4; opacity: 0.8; }
    .dwg-print { fill: rgba(220, 38, 38, 0.1); stroke: var(--accent); stroke-width: 1.2; stroke-dasharray: 5 3; }
    .dwg-dim { stroke: var(--dim); stroke-width: 0.9; }
    .dwg-ext { stroke: var(--dim); stroke-width: 0.6; stroke-dasharray: 3 3; }
    .dwg-label { fill: var(--dim); font-size: 11px; letter-spacing: 0.06em; }
    .dwg-note { fill: var(--ink-dim); font-size: 10px; letter-spacing: 0.1em; }

    /* ---- Ink chips -------------------------------------------------------- */
    .chip-row { display: flex; align-items: stretch; gap: 14px; border: 1px solid var(--rule); }
    .chip { width: 84px; flex: none; border-right: 1px solid var(--rule); }
    .chip-body { padding: 10px 12px 12px; flex: 1; min-width: 0; }

    .callout {
      border-left: 2px solid var(--accent);
      padding: 8px 0 8px 12px;
      color: var(--ink-dim);
      font-size: 11px;
      margin-top: 16px;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      border: 1px solid var(--rule);
      padding: 9px 14px;
      color: var(--ink);
      text-decoration: none;
      font-size: 10px;
      letter-spacing: 0.16em;
      text-transform: uppercase;
    }
    .btn:hover { border-color: var(--accent); color: #fff; background: rgba(220, 38, 38, 0.12); }

    .sig {
      border: 1px solid var(--rule);
      padding: 12px 14px 10px;
    }
    .sig-line {
      border-bottom: 1px solid var(--rule);
      height: 30px;
      margin-top: 14px;
    }
    .sig-grid { display: grid; gap: 12px; }
    @media (min-width: 700px) { .sig-grid { grid-template-columns: repeat(2, 1fr); } }

    .footer-strip {
      display: flex;
      flex-wrap: wrap;
      gap: 6px 20px;
      justify-content: space-between;
      padding: 12px 24px;
      font-size: 9px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--ink-faint);
      border-top: 1px solid var(--rule);
    }

    /* ---- Print / PDF ------------------------------------------------------
       Black on white, no grid, no fills. This is the version that goes to
       the printer as a PDF, so keep sections from splitting across pages. */
    @media print {
      .sheet {
        --ink: #000;
        --strong: #000;
        --ink-dim: #333;
        --ink-faint: #666;
        --rule: #000;
        --rule-soft: #bbb;
        --dim: #444;
        background: #fff !important;
        color: #000;
      }
      .border-box { background: #fff; box-shadow: none; }
      .section-head { background: transparent; }
      .plate { background: #fff; }
      .dwg-outline { fill: none; stroke: #000; }
      .dwg-print { fill: none; stroke: #000; }
      .no-print { display: none !important; }
      .section, .plate, .chip-row, .sig { break-inside: avoid; }
      .frame { max-width: none; padding: 0; }
      @page { margin: 12mm; }
    }
  </style>

  <main class="sheet">
    <div class="frame">

      <nav class="no-print" style="display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;margin-bottom:14px;">
        <a href="/docs" style="color:var(--accent);text-decoration:none;font-size:10px;letter-spacing:.16em;text-transform:uppercase;">&larr; Docs Index</a>
        <span style="font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:var(--ink-faint);">
          Sheet 1 of 1 &nbsp;·&nbsp; Print this page for a PDF proof
        </span>
      </nav>

      <div class="border-box">
        <span class="tick tl"></span><span class="tick tr"></span>
        <span class="tick bl"></span><span class="tick br"></span>

        <!-- ============ TITLE BLOCK ============ -->
        <header class="titleblock">
          <div class="titleblock-main">
            <p class="eyebrow">{spec.program}</p>
            <h1 class="doc-title">{spec.title}</h1>
            <p style="color:var(--ink-dim);font-size:12px;letter-spacing:.14em;text-transform:uppercase;">{spec.subtitle}</p>
            <p style="margin-top:16px;"><span class="stamp">{spec.status}</span></p>
            <p style="margin-top:18px;max-width:52ch;color:var(--ink-dim);font-size:12px;line-height:1.7;">{spec.summary}</p>
          </div>

          <div class="titleblock-meta">
            <div class="cell"><span class="cell-k">Doc No.</span><span class="cell-v">{spec.docNo}</span></div>
            <div class="cell"><span class="cell-k">Revision</span><span class="cell-v">{spec.rev}</span></div>
            <div class="cell"><span class="cell-k">Issued</span><span class="cell-v">{spec.issued}</span></div>
            <div class="cell"><span class="cell-k">Sheet</span><span class="cell-v">1 of 1</span></div>
            <div class="cell"><span class="cell-k">Prepared By</span><span class="cell-v">{spec.preparedBy}</span></div>
            <div class="cell"><span class="cell-k">Units</span><span class="cell-v">Inches</span></div>
            <div class="cell" style="grid-column:1 / -1;border-right:0;border-bottom:0;">
              <span class="cell-k">Classification</span><span class="cell-v">{spec.classification}</span>
            </div>
          </div>
        </header>

        <!-- ============ 010 ARTWORK ============ -->
        <section class="section">
          <div class="section-head">
            <span class="section-no">010</span>
            <h2 class="section-title">Artwork</h2>
            <span class="section-note">Press-ready file</span>
          </div>
          <div class="section-body">
            <div class="cols">
              <div>
                <div class="plate" id="plate-print">
                  <img
                    class="plate-img"
                    src={spec.assets.printFile.href}
                    alt="Leatherface press-ready artwork"
                    onerror="this.closest('.plate').classList.add('is-missing')"
                  />
                  <div class="plate-missing">
                    Awaiting asset<br />
                    <code>{spec.assets.printFile.href}</code><br />
                    Drop the file at that path to populate this plate
                  </div>
                  <div class="plate-cap">
                    <span>Fig. 010-A &nbsp;·&nbsp; {spec.assets.printFile.label}</span>
                    <span>{spec.assets.printFile.note}</span>
                  </div>
                </div>
                <p class="no-print" style="margin-top:12px;">
                  <a class="btn" href={spec.assets.printFile.href} download>&darr; Download art file</a>
                </p>
              </div>

              <div>
                <table class="spec-table">
                  <tbody>
                    {spec.artwork.map(([k, v]) => (
                      <tr>
                        <td class="k">{k}</td>
                        <td class={isTBD(v) ? 'tbd' : ''}>{v}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
                {spec.artworkNotes.map((n) => <p class="callout">{n}</p>)}
                <p class="callout">
                  If the art needs to change to run on press, send it back to us
                  before separating.
                </p>
              </div>
            </div>
          </div>
        </section>

        <!-- ============ 020 GARMENT ============ -->
        <section class="section">
          <div class="section-head">
            <span class="section-no">020</span>
            <h2 class="section-title">Garment</h2>
            <span class="section-note">Blank + colorway</span>
          </div>
          <div class="section-body">
            <div class="cols">
              <div>
                <div class="plate">
                  <img
                    class="plate-img"
                    src={spec.assets.preview.href}
                    alt="Leatherface tee preview mockup"
                    onerror="this.closest('.plate').classList.add('is-missing')"
                  />
                  <div class="plate-missing">
                    Awaiting asset<br />
                    <code>{spec.assets.preview.href}</code><br />
                    Drop the mockup at that path to populate this plate
                  </div>
                  <div class="plate-cap">
                    <span>Fig. 020-A &nbsp;·&nbsp; {spec.assets.preview.label}</span>
                    <span>{spec.assets.preview.note}</span>
                  </div>
                </div>
              </div>
              <div>
                <table class="spec-table">
                  <tbody>
                    {spec.garment.map(([k, v]) => (
                      <tr>
                        <td class="k">{k}</td>
                        <td class={isTBD(v) ? 'tbd' : ''}>{v}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
                <p class="callout">
                  <strong style="color:var(--ink);">Fig. 020-A is illustrative.</strong>
                  Its garment proportions do not match the real 1717 and the print
                  on it reads larger than spec. Do not scale anything off the
                  mockup — section 030 governs print size and placement.
                </p>
                {spec.garmentNotes.map((n) => <p class="callout">{n}</p>)}
              </div>
            </div>
          </div>
        </section>

        <!-- ============ 030 PLACEMENT ============ -->
        <section class="section">
          <div class="section-head">
            <span class="section-no">030</span>
            <h2 class="section-title">Print Placement</h2>
            <span class="section-note">Dimensions in inches — size L reference</span>
          </div>
          <div class="section-body">
            <div class="cols">
              <div>
                <!-- Drawn to scale: 7.5 user units = 1.0 in, so the garment
                     and the print box are in true proportion to each other.
                     Body = 22.0 in chest × 30.0 in length (size L). -->
                <svg class="drawing" viewBox="0 0 420 340" role="img" aria-label="Technical drawing: front view of tee with print placement dimensions">
                  <defs>
                    <marker id="arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                      <path d="M 0 0 L 10 5 L 0 10 z" fill="var(--dim)" />
                    </marker>
                  </defs>

                  <!-- Garment outline: front view, laid flat -->
                  <path
                    class="dwg-outline"
                    d="M 165,52 L 102,74 L 56,126 L 100,166 L 128,140 L 128,272 L 293,272 L 293,140 L 321,166 L 365,126 L 319,74 L 256,52 Q 210,90 165,52 Z"
                  />
                  <!-- Collar rib + hem + sleeve hems -->
                  <path class="dwg-detail" d="M 172,56 Q 210,84 249,56" />
                  <path class="dwg-detail" d="M 128,262 L 293,262" />
                  <path class="dwg-detail" d="M 104,159 L 130,134" />
                  <path class="dwg-detail" d="M 317,159 L 291,134" />

                  <!-- Center line (CB) -->
                  <line class="dwg-center" x1="210.5" y1="28" x2="210.5" y2="296" />

                  <!-- Print area: 5.5 × 2.98 in -->
                  <rect class="dwg-print" x="190" y="94" width="41" height="22" />

                  <!-- Vertical dim: collar seam to top of print (3.0 in) -->
                  <line class="dwg-ext" x1="210.5" y1="71" x2="304" y2="71" />
                  <line class="dwg-ext" x1="231" y1="94" x2="304" y2="94" />
                  <line class="dwg-dim" x1="292" y1="71" x2="292" y2="94" marker-start="url(#arrow)" marker-end="url(#arrow)" />
                  <text class="dwg-label" x="300" y="87">3.0</text>

                  <!-- Vertical dim: print height (2.98 in) -->
                  <line class="dwg-ext" x1="190" y1="94" x2="162" y2="94" />
                  <line class="dwg-ext" x1="190" y1="116" x2="162" y2="116" />
                  <line class="dwg-dim" x1="170" y1="94" x2="170" y2="116" marker-start="url(#arrow)" marker-end="url(#arrow)" />
                  <text class="dwg-label" x="164" y="108" text-anchor="end">2.98</text>

                  <!-- Horizontal dim: print width (5.5 in) -->
                  <line class="dwg-ext" x1="190" y1="116" x2="190" y2="142" />
                  <line class="dwg-ext" x1="231" y1="116" x2="231" y2="142" />
                  <line class="dwg-dim" x1="190" y1="134" x2="231" y2="134" marker-start="url(#arrow)" marker-end="url(#arrow)" />
                  <text class="dwg-label" x="210.5" y="152" text-anchor="middle">5.5</text>
                  <text class="dwg-note" x="210.5" y="168" text-anchor="middle">PRINT AREA</text>

                  <!-- Horizontal dim: chest width (22.0 in) -->
                  <line class="dwg-ext" x1="128" y1="272" x2="128" y2="300" />
                  <line class="dwg-ext" x1="293" y1="272" x2="293" y2="300" />
                  <line class="dwg-dim" x1="128" y1="292" x2="293" y2="292" marker-start="url(#arrow)" marker-end="url(#arrow)" />
                  <text class="dwg-label" x="210.5" y="312" text-anchor="middle">22.0 CHEST (SIZE L)</text>

                  <!-- Callouts -->
                  <text class="dwg-note" x="210.5" y="22" text-anchor="middle">BODY CENTER LINE</text>
                  <text class="dwg-note" x="14" y="20">FRONT VIEW</text>
                  <text class="dwg-note" x="14" y="34">SCALE 7.5:1</text>
                  <text class="dwg-note" x="14" y="250">TUBULAR BODY —</text>
                  <text class="dwg-note" x="14" y="264">NO SIDE SEAMS</text>
                </svg>
              </div>

              <div>
                <table class="spec-table">
                  <tbody>
                    {spec.placement.map(([k, v]) => (
                      <tr>
                        <td class="k">{k}</td>
                        <td class={isTBD(v) ? 'tbd' : ''}>{v}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
                <p class="callout">
                  Placement is measured from the <strong style="color:var(--ink);">back collar seam</strong>,
                  not from the front neck rib. Hold the 3.0 in drop on every size —
                  do not scale placement with the garment.
                </p>
                <p class="callout">
                  The 1717 has a <strong style="color:var(--ink);">tubular body with no side seams</strong>,
                  so there is nothing to square the platen against. Center on the
                  neck and the folded body, and check the first piece of each size
                  before running the stack.
                </p>
              </div>
            </div>
          </div>
        </section>

        <!-- ============ 040 INK ============ -->
        <section class="section">
          <div class="section-head">
            <span class="section-no">040</span>
            <h2 class="section-title">Ink &amp; Press</h2>
            <span class="section-note">{spec.ink.length} color{spec.ink.length === 1 ? '' : 's'}</span>
          </div>
          <div class="section-body">
            <div class="cols">
              <div>
                {spec.ink.map((c, i) => (
                  <div class="chip-row" style={i > 0 ? 'margin-top:12px;' : ''}>
                    <div class="chip" style={`background:${c.swatch};`}></div>
                    <div class="chip-body">
                      <p style="font-size:14px;color:var(--strong);text-transform:uppercase;letter-spacing:.1em;">{c.name}</p>
                      <p style="margin-top:6px;font-size:10px;letter-spacing:.1em;color:var(--ink-dim);text-transform:uppercase;">
                        Pantone <span class={isTBD(c.pantone) ? 'tbd' : ''}>{c.pantone}</span>
                        &nbsp;·&nbsp; {c.type} &nbsp;·&nbsp; Mesh {c.mesh}
                      </p>
                      <p style="margin-top:6px;font-size:11px;color:var(--ink-dim);">{c.note}</p>
                    </div>
                  </div>
                ))}
                <p class="callout">{spec.pressNote}</p>
                <p class="callout">
                  Ink color is approved off the physical strike-off, not off this
                  screen. Screen values are a reference only.
                </p>
              </div>
              <div>
                <table class="spec-table">
                  <tbody>
                    {spec.press.map(([k, v]) => (
                      <tr>
                        <td class="k">{k}</td>
                        <td class={isTBD(v) ? 'tbd' : ''}>{v}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </section>

        <!-- ============ 050 SIZE RUN ============ -->
        <section class="section">
          <div class="section-head">
            <span class="section-no">050</span>
            <h2 class="section-title">Size Run &amp; Costing</h2>
            <span class="section-note">{totalUnits} pieces &nbsp;·&nbsp; garment laid flat, inches</span>
          </div>
          <div class="section-body">
            <div style="overflow-x:auto;">
              <table class="spec-table">
                <thead>
                  <tr>
                    <th>Size</th>
                    <th>Body Length</th>
                    <th>Chest Width</th>
                    <th>Qty</th>
                    <th>Blank Ea.</th>
                    <th>Extended</th>
                  </tr>
                </thead>
                <tbody>
                  {rows.map((r) => (
                    <tr>
                      <td style="color:var(--strong);letter-spacing:.12em;">{r.size}</td>
                      <td>{r.length}</td>
                      <td>{r.chest}</td>
                      <td>{r.qty}</td>
                      <td>{usd(r.unit)}</td>
                      <td>{usd(r.qty * r.unit)}</td>
                    </tr>
                  ))}
                  <tr class="total-row">
                    <td style="color:var(--strong);letter-spacing:.12em;">TOTAL</td>
                    <td></td>
                    <td></td>
                    <td style="color:var(--strong);">{totalUnits}</td>
                    <td style="color:var(--ink-dim);">avg {usd(avgPerUnit)}</td>
                    <td style="color:var(--strong);">{usd(blanksSubtotal)}</td>
                  </tr>
                </tbody>
              </table>
            </div>

            <div class="cols" style="margin-top:20px;">
              <div>
                <table class="spec-table">
                  <tbody>
                    <tr>
                      <td class="k">Blanks subtotal</td>
                      <td>{usd(blanksSubtotal)} &nbsp;/&nbsp; {totalUnits} pieces</td>
                    </tr>
                    <tr>
                      <td class="k">Blank cost per unit</td>
                      <td>{usd(avgPerUnit)} average</td>
                    </tr>
                    <tr>
                      <td class="k">Screen charge</td>
                      <td class="tbd">{spec.costing.screenCharge}</td>
                    </tr>
                    <tr>
                      <td class="k">Print per unit</td>
                      <td class="tbd">{spec.costing.printCost}</td>
                    </tr>
                    <tr>
                      <td class="k">Landed cost per unit</td>
                      <td class="tbd">TBD — blanks + print + screens</td>
                    </tr>
                    <tr>
                      <td class="k">Blank pricing source</td>
                      <td style="color:var(--ink-dim);">{spec.costing.source}</td>
                    </tr>
                  </tbody>
                </table>
              </div>
              <div>
                <p class="callout" style="margin-top:0;">{spec.sizeRun.note}</p>
                <p class="callout">{spec.costing.note}</p>
              </div>
            </div>
          </div>
        </section>

        <!-- ============ 060 FINISHING ============ -->
        <section class="section">
          <div class="section-head">
            <span class="section-no">060</span>
            <h2 class="section-title">Finishing &amp; Packout</h2>
            <span class="section-note">Post-cure</span>
          </div>
          <div class="section-body">
            <table class="spec-table">
              <tbody>
                {spec.finishing.map(([k, v]) => (
                  <tr>
                    <td class="k">{k}</td>
                    <td class={isTBD(v) ? 'tbd' : ''}>{v}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        <!-- ============ 070 APPROVALS ============ -->
        <section class="section">
          <div class="section-head">
            <span class="section-no">070</span>
            <h2 class="section-title">Approvals</h2>
            <span class="section-note">Sign before production</span>
          </div>
          <div class="section-body">
            <table class="spec-table" style="margin-bottom:20px;">
              <thead>
                <tr><th>Gate</th><th>Owner</th><th>Status</th></tr>
              </thead>
              <tbody>
                {spec.approvals.map((a) => (
                  <tr>
                    <td>{a.item}</td>
                    <td style="color:var(--ink-dim);">{a.by}</td>
                    <td class="tbd">{a.state}</td>
                  </tr>
                ))}
              </tbody>
            </table>

            <div class="sig-grid">
              <div class="sig">
                <span class="cell-k">VHS Garage — Approved By</span>
                <div class="sig-line"></div>
                <span class="cell-k" style="margin-top:6px;">Signature / Date</span>
              </div>
              <div class="sig">
                <span class="cell-k">Printer — Accepted By</span>
                <div class="sig-line"></div>
                <span class="cell-k" style="margin-top:6px;">Signature / Date</span>
              </div>
            </div>
          </div>
        </section>

        <!-- ============ 080 REVISIONS ============ -->
        <section class="section">
          <div class="section-head">
            <span class="section-no">080</span>
            <h2 class="section-title">Revision History</h2>
          </div>
          <div class="section-body">
            <table class="spec-table">
              <thead>
                <tr><th>Rev</th><th>Date</th><th>By</th><th>Description</th></tr>
              </thead>
              <tbody>
                {spec.revisions.map((r) => (
                  <tr>
                    <td style="color:var(--strong);">{r.rev}</td>
                    <td>{r.date}</td>
                    <td style="color:var(--ink-dim);">{r.by}</td>
                    <td>{r.note}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>

        <div class="footer-strip">
          <span>{spec.docNo} REV {spec.rev}</span>
          <span>{spec.classification}</span>
          <span>VHSGARAGE.COM</span>
        </div>
      </div>

      <p class="no-print" style="margin-top:16px;font-size:9px;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-faint);">
        Values shown in <span class="tbd">red</span> are unconfirmed. Do not quote or cut against them.
      </p>
    </div>
  </main>
</Base>
