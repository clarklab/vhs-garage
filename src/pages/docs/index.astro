---
import Base from '../../layouts/Base.astro';
import { SPECS } from '../../data/specs.js';
---

<Base
  title="Docs"
  description="Internal spec sheets and production documents for VHS Garage drops."
>
  <meta slot="head" name="robots" content="noindex, nofollow" />

  <style>
    .sheet {
      --ink: #e8e6e0;
      --ink-dim: #8a8781;
      --ink-faint: #55534f;
      --rule: rgba(232, 230, 224, 0.22);
      --rule-soft: rgba(232, 230, 224, 0.1);
      --accent: #dc2626;

      background-color: #07070a;
      background-image:
        linear-gradient(var(--rule-soft) 1px, transparent 1px),
        linear-gradient(90deg, var(--rule-soft) 1px, transparent 1px);
      background-size: 96px 96px, 96px 96px;
      color: var(--ink);
      min-height: 100svh;
      font-size: 12px;
      letter-spacing: 0.02em;
    }
    .frame { max-width: 900px; margin: 0 auto; padding: 28px 20px 80px; }
    .eyebrow { font-size: 9px; letter-spacing: 0.24em; color: var(--ink-dim); text-transform: uppercase; }
    h1 {
      font-size: 44px;
      line-height: 1;
      color: #fff;
      text-transform: uppercase;
      margin: 12px 0 10px;
    }
    .lede { color: var(--ink-dim); font-size: 13px; line-height: 1.8; max-width: 56ch; }

    .row {
      display: grid;
      gap: 4px 20px;
      grid-template-columns: 1fr;
      border: 1px solid var(--rule);
      border-top: 0;
      padding: 16px 18px;
      text-decoration: none;
      color: inherit;
    }
    @media (min-width: 720px) {
      .row { grid-template-columns: 165px 1fr 190px; align-items: center; }
    }
    .row:first-of-type { border-top: 1px solid var(--rule); }
    .row:hover { background: rgba(220, 38, 38, 0.08); }
    .row:hover .row-title { color: var(--accent); }
    .row-no { font-size: 10px; letter-spacing: 0.14em; color: var(--ink-faint); white-space: nowrap; }
    .row-title { font-size: 18px; color: #fff; text-transform: uppercase; letter-spacing: 0.04em; }
    .row-sub { font-size: 11px; color: var(--ink-dim); margin-top: 2px; }
    .row-status {
      font-size: 9px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--accent);
      border: 1px solid var(--accent);
      padding: 3px 8px;
      justify-self: start;
    }
    @media (min-width: 720px) { .row-status { justify-self: end; } }

    .empty {
      border: 1px dashed var(--rule);
      padding: 40px 20px;
      text-align: center;
      color: var(--ink-faint);
      font-size: 10px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }

    /* Printed on white paper, white headings would come out invisible. */
    @media print {
      .sheet {
        --ink: #000;
        --ink-dim: #333;
        --ink-faint: #666;
        --rule: #000;
        --rule-soft: #bbb;
        background: #fff !important;
        color: #000;
      }
      h1, .row-title { color: #000; }
      @page { margin: 12mm; }
    }
  </style>

  <main class="sheet">
    <div class="frame">
      <a href="/" style="color:var(--accent);text-decoration:none;font-size:10px;letter-spacing:.16em;text-transform:uppercase;">&larr; VHS Garage</a>

      <p class="eyebrow" style="margin-top:26px;">VHS Garage / Document Control</p>
      <h1>Docs</h1>
      <p class="lede">
        Spec sheets and production documents. These go out to printers, vendors,
        and partners — every sheet is versioned, and anything unconfirmed is
        flagged in red on the sheet itself.
      </p>

      <div style="margin-top:34px;">
        {SPECS.length === 0 ? (
          <div class="empty">No documents on file</div>
        ) : (
          SPECS.map((s) => (
            <a class="row" href={`/docs/${s.id}`}>
              <span class="row-no">{s.docNo} &nbsp;REV {s.rev}</span>
              <span>
                <span class="row-title">{s.title}</span>
                <span class="row-sub" style="display:block;">{s.subtitle}</span>
              </span>
              <span class="row-status">{s.status}</span>
            </a>
          ))
        )}
      </div>
    </div>
  </main>
</Base>
