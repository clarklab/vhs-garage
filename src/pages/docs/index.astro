---
import Base from '../../layouts/Base.astro';
import { SPECS } from '../../data/specs.js';
---

<Base title="Docs" description="Spec sheets for VHS Garage drops.">
  <meta slot="head" name="robots" content="noindex, nofollow" />

  <style>
    .sheet {
      --ink: #14110f;
      --dim: #6f6a64;
      --rule: #d6d2cb;
      --accent: #dc2626;

      background: #fbfaf8;
      color: var(--ink);
      min-height: 100svh;
      font-size: 13px;
      letter-spacing: 0.02em;
    }
    .frame { max-width: 760px; margin: 0 auto; padding: 24px 20px 60px; }
    .eyebrow { font-size: 9px; letter-spacing: 0.2em; text-transform: uppercase; color: var(--dim); }
    h1 { font-size: 38px; line-height: 1; text-transform: uppercase; margin: 12px 0 8px; }
    .lede { color: var(--dim); font-size: 12px; line-height: 1.7; max-width: 48ch; }

    .row {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 4px 14px;
      border: 1px solid var(--ink);
      border-top: 0;
      background: #fff;
      padding: 14px 16px;
      text-decoration: none;
      color: inherit;
    }
    .row:first-of-type { border-top: 1px solid var(--ink); }
    .row:hover { background: #fff6f6; }
    .row:hover .t { color: var(--accent); }
    .t { font-size: 17px; text-transform: uppercase; letter-spacing: 0.04em; }
    .m { font-size: 9px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--dim); margin-left: auto; }
    .s { font-size: 11px; color: var(--dim); }

    @media print { .sheet { background: #fff; } @page { margin: 14mm; } }
  </style>

  <main class="sheet">
    <div class="frame">
      <a href="/" style="color:var(--accent);text-decoration:none;font-size:10px;letter-spacing:.16em;text-transform:uppercase;">&larr; VHS Garage</a>

      <p class="eyebrow" style="margin-top:22px;">VHS Garage / Apparel</p>
      <h1>Docs</h1>
      <p class="lede">Spec sheets for our drops. These go out to printers and partners.</p>

      <div style="margin-top:28px;">
        {SPECS.map((s) => (
          <a class="row" href={`/docs/${s.id}`}>
            <span class="t">{s.title}</span>
            <span class="s">{s.subtitle}</span>
            <span class="m">{s.docNo} Rev {s.rev}</span>
          </a>
        ))}
      </div>
    </div>
  </main>
</Base>
