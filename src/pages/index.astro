---
import Base from '../layouts/Base.astro';
import Flicker from '../components/Flicker.astro';
import { GARAGES } from '../data/garages.js';
import { getCollection } from 'astro:content';
const g = GARAGES[0];

const latestPosts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
const postSlug = (id) => id.replace(/\.(md|mdx)$/, '');
---

<Base
  title="VHS Garage"
  description="Two dudes on a mission to rewind the clock and bring analog vibes back to a digital world. VHS swap meets, found footage, and IRL events."
>
  <style>
    #video-loader::after {
      content: '░░░';
      animation: vhs-dots 0.9s steps(1) infinite;
    }

    /* Hosts pair — Matt + Clark side-by-side avatars, looking at each
       other (Matt's portrait faces right, Clark's faces left). Each card
       fades up on load with a small stagger; on hover the avatar rocks
       back and forth like a head bob.

       Two transforms in play:
         1. .host-card runs the entry fade/translate (one-shot, forwards)
         2. .host-avatar runs the hover head-rock (infinite while hovered)
       Splitting onto two elements keeps the transforms from clobbering
       each other. */
    .host-card {
      opacity: 0;
      animation: host-fade-in 0.7s ease-out forwards;
    }
    .host-card:nth-of-type(1) { animation-delay: 0.15s; }
    .host-card:nth-of-type(2) { animation-delay: 0.35s; }

    .host-avatar {
      transition: transform 0.3s ease, border-color 0.3s ease;
      transform-origin: center bottom;
    }
    .host-card:hover .host-avatar {
      animation: head-rock 0.7s ease-in-out infinite;
    }

    @keyframes host-fade-in {
      from { opacity: 0; transform: translateY(14px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    @keyframes head-rock {
      0%, 100% { transform: rotate(-5deg); }
      50%      { transform: rotate(5deg); }
    }

    /* Honor users with reduced-motion preferences — drop the head-rock,
       just keep the entry fade. */
    @media (prefers-reduced-motion: reduce) {
      .host-card { animation: none; opacity: 1; }
      .host-card:hover .host-avatar { animation: none; }
    }
  </style>

  <!-- Top bar -->
  <a id="top-bar" href="/join" class="block bg-[#dc2626] text-white text-center text-xs py-2 px-4 hover:bg-[#ef4444] transition-colors">
    CLICK HERE TO SIGN UP. <span id="top-bar-count">JOIN OTHERS.</span> WE'RE COOL.
  </a>

  <!-- Hero -->
  <section class="relative overflow-hidden cursor-pointer" style="height:100svh;">
    <Flicker dark={g.images.dark} light={g.images.light}>
      <div id="video-loader" class="absolute z-0 aspect-[4/3] flex items-center justify-center text-white/40 text-sm opacity-0"></div>
      <video
        id="hero-video"
        src="/video/vhs-garage-loop.mp4"
        autoplay
        loop
        muted
        playsinline
        class="absolute z-0 opacity-0 transition-opacity duration-500"
      ></video>
    </Flicker>

    <p id="sound-hint" class="absolute top-4 right-4 text-white text-xs z-20 opacity-60">Sound On</p>

    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce z-20">
      <svg class="w-8 h-8 text-white/60" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
      </svg>
    </div>
  </section>

  <!-- Content -->
  <section class="max-w-5xl mx-auto px-6 py-24 text-left">
    <!-- Intro lockup: centered "Welcome to the Garage" headline above a
         two-column row. Left column (2/3 width) is the intro paragraph;
         right column (1/3 width) is "Hosted by" + the two host avatars.
         items-center vertically centers the paragraph against the taller
         hosts column so the lockup reads as a balanced unit. Stacks
         vertically on mobile (single-column grid by default). -->
    <h2 class="text-7xl mb-10 tracking-tight text-center">Welcome to the Garage</h2>
    <div class="grid md:grid-cols-[2fr_1fr] gap-8 md:gap-12 mb-14 items-center">
      <p class="text-lg text-gray-300 leading-relaxed">
        VHS Garage is a lo-fi love letter to the golden age of video. Two dudes on a mission to rewind the clock and bring analog vibes back to a digital world.
      </p>
      <div class="text-center">
        <p class="text-white/40 text-[10px] uppercase tracking-widest mb-3">Hosted by</p>
        <div class="flex justify-center items-end gap-4 sm:gap-6">
          <a href="https://x.com/oracrest" target="_blank" rel="noopener" class="host-card flex flex-col items-center text-center">
            <img src="/images/avatar-matt.webp" alt="Matt Manchester"
              class="host-avatar w-36 h-36 sm:w-44 sm:h-44 object-cover bg-[#141214]" />
            <p class="text-white text-sm mt-3">Matt Manchester</p>
          </a>
          <a href="https://x.com/clarklab" target="_blank" rel="noopener" class="host-card flex flex-col items-center text-center">
            <img src="/images/avatar-clark.webp" alt="Clark Wimberly"
              class="host-avatar w-36 h-36 sm:w-44 sm:h-44 object-cover bg-[#141214]" />
            <p class="text-white text-sm mt-3">Clark Wimberly</p>
          </a>
        </div>
      </div>
    </div>

    <!-- What We're Into.
         Cards now lead with a pixel icon (from @hackernoon/pixel-icon-library),
         end with a button CTA, and the VHS Recorder card sits first since
         it's the active product / what new visitors are most likely to care
         about. Each card is a flex column so the buttons line up at the
         bottom regardless of description length. -->
    <div class="mb-16">
      <h3 class="text-2xl mb-6">#What We're Into</h3>
      <div class="grid md:grid-cols-3 gap-4 text-sm text-gray-300">

        <!-- VHS Recorder — primary product, first slot -->
        <div class="flex flex-col border border-white/20 hover:border-white/40 transition-colors p-5">
          <div class="flex items-center gap-2 mb-3">
            <svg class="w-5 h-5 text-[#dc2626] fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M22,5V4H2V5H1V19H2v1H4V19H5V17H6V16H7V15H17v1h1v1h1v2h1v1h2V19h1V5ZM7,11H6v1H4V11H3V9H4V8H6V9H7Zm8-2H14v2h1v1H9V11h1V9H9V8h6Zm6,2H20v1H18V11H17V9h1V8h2V9h1Z"/>
              <polygon points="17 19 18 19 18 20 6 20 6 19 7 19 7 17 8 17 8 16 16 16 16 17 17 17 17 19"/>
            </svg>
            <p class="text-white text-xs uppercase tracking-[0.18em]">VHS Recorder</p>
          </div>
          <p class="mb-5 flex-1">Capture your tapes with any USB capture card. AI writes the titles, you make the call, uploads go straight to your own YouTube channel.</p>
          <a href="/capture" class="self-start inline-block px-4 py-2 bg-[#dc2626] text-white text-xs uppercase tracking-wider hover:bg-[#ef4444] transition-colors">
            Start recording →
          </a>
        </div>

        <!-- Found Footage -->
        <div class="flex flex-col border border-white/20 hover:border-white/40 transition-colors p-5">
          <div class="flex items-center gap-2 mb-3">
            <svg class="w-5 h-5 text-[#dc2626] fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <polygon points="22 11 22 13 21 13 21 14 20 14 20 15 18 15 18 16 16 16 16 17 15 17 15 18 13 18 13 19 11 19 11 20 10 20 10 21 8 21 8 22 6 22 6 23 3 23 3 22 2 22 2 2 3 2 3 1 6 1 6 2 8 2 8 3 10 3 10 4 11 4 11 5 13 5 13 6 15 6 15 7 16 7 16 8 18 8 18 9 20 9 20 10 21 10 21 11 22 11"/>
            </svg>
            <p class="text-white text-xs uppercase tracking-[0.18em]">Found Footage</p>
          </div>
          <p class="mb-5 flex-1">Random clips from old tapes. Stuff nobody was supposed to keep.</p>
          <div class="flex flex-wrap gap-2">
            <a href="/watch" class="inline-block px-3 py-2 border border-white/30 text-white text-xs uppercase tracking-wider hover:border-white hover:bg-white/5 transition-colors">
              Watch in Garage
            </a>
            <a href="https://www.youtube.com/user/oracrest" target="_blank" class="inline-block px-3 py-2 border border-white/15 text-white/60 text-xs uppercase tracking-wider hover:border-white/40 hover:text-white transition-colors">
              YouTube ↗
            </a>
          </div>
        </div>

        <!-- VHS Swap Meets -->
        <div class="flex flex-col border border-white/20 hover:border-white/40 transition-colors p-5">
          <div class="flex items-center gap-2 mb-3">
            <svg class="w-5 h-5 text-[#dc2626] fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <polygon points="6 12 7 12 7 13 12 13 12 12 14 12 14 13 15 13 15 14 16 14 16 15 17 15 17 16 18 16 18 19 17 19 17 18 16 18 16 17 15 17 15 16 14 16 14 15 13 15 13 16 14 16 14 17 15 17 15 18 16 18 16 19 17 19 17 20 16 20 16 21 15 21 15 20 14 20 14 19 13 19 13 18 12 18 12 17 11 17 11 16 10 16 10 17 11 17 11 18 12 18 12 19 13 19 13 20 14 20 14 21 11 21 11 20 10 20 10 19 9 19 9 18 8 18 8 19 9 19 9 20 10 20 10 21 7 21 7 20 6 20 6 19 5 19 5 18 4 18 4 17 3 17 3 16 2 16 2 15 1 15 1 4 2 4 2 5 4 5 4 6 6 6 6 5 9 5 9 7 8 7 8 8 7 8 7 9 6 9 6 12"/>
              <polygon points="23 4 23 15 22 15 22 16 21 16 21 17 20 17 20 16 19 16 19 15 18 15 18 14 17 14 17 13 16 13 16 12 15 12 15 11 14 11 14 10 12 10 12 11 11 11 11 12 7 12 7 10 8 10 8 9 9 9 9 8 10 8 10 7 11 7 11 6 12 6 12 5 17 5 17 6 20 6 20 5 22 5 22 4 23 4"/>
            </svg>
            <p class="text-white text-xs uppercase tracking-[0.18em]">Swap Meets</p>
          </div>
          <p class="mb-5 flex-1">We buy, sell, and trade tapes in person. Bring your doubles.</p>
          <a href="#local-events" class="self-start inline-block px-4 py-2 border border-white/30 text-white text-xs uppercase tracking-wider hover:border-white hover:bg-white/5 transition-colors">
            Find us IRL →
          </a>
        </div>

        <!-- Daily Play -->
        <div class="flex flex-col border border-white/20 hover:border-white/40 transition-colors p-5">
          <div class="flex items-center gap-2 mb-3">
            <svg class="w-5 h-5 text-[#dc2626] fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <polygon points="10 14 11 14 11 22 10 22 10 23 2 23 2 22 1 22 1 14 2 14 2 13 10 13 10 14"/>
              <polygon points="10 2 11 2 11 10 10 10 10 11 2 11 2 10 1 10 1 2 2 2 2 1 10 1 10 2"/>
              <polygon points="22 14 23 14 23 22 22 22 22 23 14 23 14 22 13 22 13 14 14 14 14 13 22 13 22 14"/>
              <polygon points="23 2 23 10 22 10 22 11 14 11 14 10 13 10 13 2 14 2 14 1 22 1 22 2 23 2"/>
            </svg>
            <p class="text-white text-xs uppercase tracking-[0.18em]">Daily Play</p>
          </div>
          <p class="mb-5 flex-1">A little daily game — stock the shelves of a '90s video store one tape at a time. New puzzle every day.</p>
          <a href="https://game.vhsgarage.com" target="_blank" class="self-start inline-block px-4 py-2 border border-white/30 text-white text-xs uppercase tracking-wider hover:border-white hover:bg-white/5 transition-colors">
            Play today's shelf ↗
          </a>
        </div>

        <!-- Limited Drops -->
        <div class="flex flex-col border border-white/20 hover:border-white/40 transition-colors p-5">
          <div class="flex items-center gap-2 mb-3">
            <svg class="w-5 h-5 text-[#dc2626] fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="m19,13v-3h-1v-1h-1v-3h-1v-2h-1v-1h-1v-1h-1v-1h-2v1h1v2h-1v2h-1v1h-1v1h-1v1h-1v1h-1v3h1v2h-1v-1h-1v-2h-1v2h-1v3h1v2h1v1h1v1h1v1h1v1h8v-1h1v-1h1v-1h1v-2h1v-5h-1Zm-2,7h-1v1h-2v1h-4v-1h-1v-4h1v-1h1v-1h1v-1h1v-3h-1v-1h-1v-1h1v1h2v2h1v5h-1v2h1v-1h1v-1h1v3Z"/>
            </svg>
            <p class="text-white text-xs uppercase tracking-[0.18em]">Limited Drops</p>
          </div>
          <p class="mb-5 flex-1">Small-batch merch and curated tape packs. When they're gone, they're gone.</p>
          <a href="#signup" class="self-start inline-block px-4 py-2 border border-white/15 text-white/50 text-xs uppercase tracking-wider hover:border-white/40 hover:text-white transition-colors">
            Get notified →
          </a>
        </div>

        <!-- Submit Your Garage -->
        <div class="flex flex-col border border-white/20 hover:border-white/40 transition-colors p-5">
          <div class="flex items-center gap-2 mb-3">
            <svg class="w-5 h-5 text-[#dc2626] fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <polygon points="23 11 23 12 20 12 20 22 19 22 19 23 15 23 15 16 9 16 9 23 5 23 5 22 4 22 4 12 1 12 1 11 2 11 2 10 3 10 3 9 4 9 4 8 5 8 5 7 6 7 6 6 7 6 7 5 8 5 8 4 9 4 9 3 10 3 10 2 11 2 11 1 13 1 13 2 14 2 14 3 15 3 15 4 16 4 16 5 17 5 17 6 18 6 18 7 19 7 19 8 20 8 20 9 21 9 21 10 22 10 22 11 23 11"/>
            </svg>
            <p class="text-white text-xs uppercase tracking-[0.18em]">Your Garage</p>
          </div>
          <p class="mb-5 flex-1">Got a VHS setup worth showing off? Send us a photo of your space — we'll feature it on the site.</p>
          <a href="/submit" class="self-start inline-block px-4 py-2 border border-white/30 text-white text-xs uppercase tracking-wider hover:border-white hover:bg-white/5 transition-colors">
            Submit yours →
          </a>
        </div>
      </div>
    </div>

    <!-- Local Events -->
    <div id="local-events" class="mb-12">
      <h3 class="text-2xl mb-6">#Local Events</h3>

      <!-- Next up: placeholder card for whatever we're planning -->
      <div class="border border-dashed border-white/20 p-5 mb-6">
        <p class="text-white/40 text-[10px] uppercase tracking-widest mb-2">Next up</p>
        <p class="text-white/60 text-lg mb-1">Something in the works</p>
        <p class="text-gray-500 text-sm mb-3">We're lining up the next one. Follow along on Twitter to hear about it first.</p>
        <a href="https://x.com/oracrest" target="_blank" class="text-[#dc2626] text-xs hover:underline">Get announcements →</a>
      </div>

      <!-- Past events (collapsed by default) -->
      <button
        type="button"
        id="past-events-toggle"
        aria-expanded="false"
        aria-controls="past-events"
        class="text-white/50 hover:text-white/80 text-xs transition-colors mb-4"
      >
        <span id="past-events-toggle-label">See past events →</span>
      </button>
      <div id="past-events" class="hidden mb-6">
        <div class="border border-white/10 p-5 opacity-70">
          <p class="text-white/70 text-lg mb-1">ABW Sunday Funday</p>
          <p class="text-gray-500 text-sm mb-3">Sunday, April 19 — 4:30pm · Sprinkle Valley at Austin Beerworks · Austin, TX</p>
          <p class="text-gray-400 text-sm mb-3">Vintage and retro vendors, VHS swap, video screenings, and good hangs.</p>
          <a href="https://www.instagram.com/p/DWeZWoICXg8/" target="_blank" class="text-[#dc2626] text-xs hover:underline">See the post on Instagram →</a>
        </div>
      </div>

      <p class="text-gray-400">Follow <a href="https://x.com/oracrest" target="_blank" class="text-white underline hover:text-gray-300">Matt on Twitter</a> for more event announcements, or send us an invite to your event. We'll probably show up!</p>
    </div>

    <!-- Garage Dispatches (blog) — latest 3 non-draft posts. Cleaner row
         layout: one post per row with date pill + title + description in a
         single visual line, then a single "Read the blog →" CTA at the
         bottom of the section. -->
    <div id="blog" class="mb-16">
      <div class="flex items-end justify-between gap-3 mb-6">
        <div>
          <h3 class="text-2xl mb-2">#Garage Dispatches</h3>
          <p class="text-gray-400 text-sm">Capture guides, gear notes, event updates, and other signals from the Garage.</p>
        </div>
      </div>

      <!-- Image-led card grid. Each card: 16:9 hero image on top, info
           block (date, title, description) underneath. Posts without an
           image render a hatched placeholder block in the same slot so
           the grid stays uniform. -->
      <div class="grid md:grid-cols-3 gap-4">
        {latestPosts.map((post) => (
          <a href={`/blog/${postSlug(post.id)}`} class="group flex flex-col border border-white/15 hover:border-white/40 transition-colors overflow-hidden">
            <div class="aspect-video bg-[#141214] overflow-hidden">
              {post.data.image ? (
                <img src={post.data.image} alt="" loading="lazy"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
              ) : (
                <div class="w-full h-full flex items-center justify-center text-white/15 text-2xl tracking-widest">░ ▓ ░</div>
              )}
            </div>
            <div class="p-4 flex-1 flex flex-col">
              <p class="text-white/35 text-[10px] uppercase tracking-widest tabular-nums mb-1">
                {post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
              </p>
              <p class="text-white text-base leading-snug group-hover:text-[#dc2626] transition-colors mb-1">{post.data.title}</p>
              <p class="text-gray-500 text-sm leading-6 flex-1">{post.data.description}</p>
            </div>
          </a>
        ))}
      </div>

      <div class="mt-6">
        <a href="/blog" class="inline-block px-4 py-2 border border-white/30 text-white text-xs uppercase tracking-wider hover:border-white hover:bg-white/5 transition-colors">
          Read all dispatches →
        </a>
      </div>
    </div>

    <!-- Signup — VHS static backdrop spans the FULL viewport width, with
         the white card centered inside. The classic "full-bleed inside a
         constrained parent" trick: width: 100vw + margin-left of
         calc(-50vw + 50%) makes the section span the viewport regardless
         of the max-w-5xl wrapper, while staying horizontally centered.
         The static canvas auto-inits via /public/scripts/vhs-static.js. -->
    <section id="signup" class="relative my-16 overflow-hidden border-y border-white/10"
             style="width: 100vw; margin-left: calc(-50vw + 50%);">
      <canvas data-vhs-static
              class="absolute inset-0 w-full h-full pointer-events-none"
              style="image-rendering: pixelated; opacity: 0.45;"
              aria-hidden="true"></canvas>
      <div class="relative z-10 px-6 py-20 md:py-28">
        <div class="max-w-xl mx-auto bg-white text-black p-8 md:p-10 shadow-[6px_6px_0_0_rgba(0,0,0,0.6)] border border-black">
          <h3 class="text-2xl mb-2 text-black">#Join us in the Garage</h3>
          <p class="text-black/70 mb-2">Drop your email or phone and we'll give you a <strong class="text-black">free mystery VHS</strong> at an upcoming event. No spam. Just tapes.</p>
          <p class="text-black/50 text-xs mb-5">Either one works — we only need one. Drop both if you're feeling extra.</p>
          <form id="garage-form" name="garage-signup" method="POST" data-netlify="true" class="flex flex-col gap-3">
            <input type="hidden" name="form-name" value="garage-signup" />
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <input
                id="garage-email"
                type="email"
                name="email"
                placeholder="your@email.com"
                autocomplete="email"
                inputmode="email"
                class="w-full px-4 py-3 bg-white border border-black/30 text-black placeholder-black/40 focus:outline-none focus:border-black"
              />
              <input
                id="garage-phone"
                type="tel"
                name="phone"
                placeholder="(555) 123-4567"
                autocomplete="tel"
                inputmode="tel"
                class="w-full px-4 py-3 bg-white border border-black/30 text-black placeholder-black/40 focus:outline-none focus:border-black"
              />
            </div>
            <button id="garage-submit-btn" type="submit" class="px-6 py-3 bg-black text-white hover:bg-gray-800 transition-colors min-w-[100px]">
              Sign Up
            </button>
          </form>
          <p id="garage-confirm" class="hidden text-lg mt-4 text-black"></p>
          <p id="signup-count" class="text-black/40 text-xs mt-4"></p>
        </div>
      </div>
    </section>

    <!-- (Submit Your Garage moved up into the #What We're Into card grid.) -->
  </section>

  <footer class="text-left text-gray-600 text-sm pb-8 max-w-2xl mx-auto px-6 flex flex-wrap items-center gap-x-4 gap-y-2">
    <span>&copy; 2026 VHS Garage</span>
    <a href="/terms" class="hover:text-white/70">Terms</a>
    <a href="/privacy" class="hover:text-white/70">Privacy</a>
  </footer>

  <script is:inline define:vars={{ heroScreen: JSON.stringify(g.screen) }}>
    (() => {
      const screenCfg = JSON.parse(heroScreen);

      // Position hero video + loader using cover math from Flicker
      document.addEventListener('scene-sized', (e) => {
        const { scale, offX, offY, imgW, imgH } = e.detail;
        const x = offX + (screenCfg.left / 100) * imgW * scale;
        const y = offY + (screenCfg.top / 100) * imgH * scale;
        const w = (screenCfg.width / 100) * imgW * scale;

        ['video-loader', 'hero-video'].forEach(id => {
          const el = document.getElementById(id);
          el.style.left = x + 'px';
          el.style.top = y + 'px';
          el.style.width = w + 'px';
          el.style.transform = screenCfg.transform || '';
        });
        document.getElementById('video-loader').style.opacity = '1';
      });

      const vid = document.getElementById('hero-video');
      const loader = document.getElementById('video-loader');
      vid.addEventListener('canplaythrough', () => {
        vid.classList.remove('opacity-0');
        loader.classList.add('hidden');
      }, { once: true });
    })();
  </script>

  <script is:inline>
    (() => {
      const section = document.querySelector('section');
      const vid = document.getElementById('hero-video');
      const hint = document.getElementById('sound-hint');

      section.addEventListener('click', () => {
        vid.muted = !vid.muted;
        hint.textContent = vid.muted ? 'Sound On' : 'Sound Off';
      });
    })();
  </script>

  <script is:inline>
    (() => {
      const form = document.getElementById('garage-form');
      const btn = document.getElementById('garage-submit-btn');
      const email = document.getElementById('garage-email');
      const phone = document.getElementById('garage-phone');
      const confirm = document.getElementById('garage-confirm');
      const frames = ['░░░', '▒░░', '▓▒░', '▓▓▒', '▓▓▓', '▓▓▒', '▓▒░', '▒░░'];
      let tick;

      function startLoader() {
        let i = 0;
        btn.disabled = true;
        btn.textContent = frames[0];
        tick = setInterval(() => {
          i = (i + 1) % frames.length;
          btn.textContent = frames[i];
        }, 120);
      }

      function stopLoader() {
        clearInterval(tick);
        btn.disabled = false;
        btn.textContent = 'Sign Up';
      }

      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        // At least one contact method is required — Netlify collects both.
        if (!email.value.trim() && !phone.value.trim()) {
          confirm.classList.remove('hidden', 'text-white');
          confirm.classList.add('text-red-400');
          confirm.textContent = '░ Enter an email or phone number.';
          return;
        }
        // Clear any stale error before submitting
        confirm.classList.add('hidden');
        confirm.classList.remove('text-red-400');

        startLoader();
        try {
          const res = await fetch('/', {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: new URLSearchParams(new FormData(form)).toString()
          });
          stopLoader();
          if (res.ok) {
            form.classList.add('hidden');
            confirm.classList.remove('hidden');
            confirm.textContent = '▓ You\'re in. See you at the next event.';
          } else {
            confirm.classList.remove('hidden');
            confirm.textContent = '░ Something went wrong. Try again.';
            confirm.classList.add('text-red-400');
          }
        } catch {
          stopLoader();
          confirm.classList.remove('hidden');
          confirm.textContent = '░ Network error. Try again.';
          confirm.classList.add('text-red-400');
        }
      });
    })();
  </script>

  <script is:inline>
    (() => {
      const btn = document.getElementById('past-events-toggle');
      const panel = document.getElementById('past-events');
      const label = document.getElementById('past-events-toggle-label');
      if (!btn || !panel || !label) return;
      btn.addEventListener('click', () => {
        const open = !panel.classList.contains('hidden');
        panel.classList.toggle('hidden');
        btn.setAttribute('aria-expanded', String(!open));
        label.textContent = open ? 'See past events →' : 'Hide past events ↑';
      });
    })();
  </script>

  <!-- VHS static effect — auto-inits any <canvas data-vhs-static> on the
       page. Lives at /public/scripts/vhs-static.js so any other page can
       drop in the same canvas + script tag pattern. -->
  <script is:inline src="/scripts/vhs-static.js" defer></script>

  <script is:inline>
    fetch('/.netlify/functions/signup-count')
      .then(r => r.json())
      .then(d => {
        if (d.count > 0) {
          document.getElementById('signup-count').textContent = d.count + ' people have joined the garage';
          document.getElementById('top-bar-count').textContent = 'JOIN ' + d.count + ' OTHERS.';
        }
      })
      .catch(() => {});
  </script>
</Base>
