---
import { findGear } from '../data/gear.js';

interface Props {
  url?: string;
  asin?: string;
  title?: string;
  eyebrow?: string;
  description?: string;
  cta?: string;
  image?: string;
  certified?: boolean;
  // Free-text "what we've seen this go for" range (e.g. "$10–20").
  // Rendered as a small pill so it doesn't get mistaken for the
  // current-now-on-Amazon price (which we don't track and which
  // changes constantly).
  priceRange?: string;
}

// Pull defaults from src/data/gear.js when an ASIN matches an entry there.
// Inline props always override the gear.js values, so you can override a
// single field per usage if you want (e.g. eyebrow="Our top pick"). Cards
// without a matching gear.js entry still work — they just won't appear on
// the /gear page.
const inlineAsin = Astro.props.asin
  || (Astro.props.url ? extractAsinFromUrl(Astro.props.url) : '');
const gear = findGear(inlineAsin);

const {
  url       = gear?.url,
  asin      = gear?.asin,
  title     = gear?.title || 'Amazon product',
  eyebrow   = gear?.eyebrow || 'Recommended gear',
  description = gear?.description,
  cta       = 'View on Amazon',
  image     = gear?.image,
  certified = gear?.certified ?? false,
  priceRange = gear?.priceRange,
} = Astro.props;

function extractAsinFromUrl(rawUrl: string): string {
  const match = rawUrl.match(/\/(?:dp|gp\/product)\/([A-Z0-9]{10})(?:[/?#]|$)/i);
  return match?.[1]?.toUpperCase() || '';
}

function extractAsin(rawUrl?: string, rawAsin?: string) {
  if (rawAsin) return rawAsin.trim().toUpperCase();
  if (!rawUrl) return '';
  return extractAsinFromUrl(rawUrl);
}

function normalizeAmazonUrl(rawUrl: string) {
  try {
    const parsed = new URL(rawUrl);
    return parsed.toString();
  } catch {
    return rawUrl;
  }
}

function titleFromUrl(rawUrl?: string) {
  if (!rawUrl) return '';
  try {
    const parsed = new URL(rawUrl);
    const parts = parsed.pathname.split('/').filter(Boolean);
    const dpIndex = parts.findIndex((part) => part === 'dp' || part === 'product');
    const slug = dpIndex > 0 ? parts[dpIndex - 1] : '';
    if (!slug || /^[A-Z0-9]{10}$/i.test(slug)) return '';
    return slug
      .split('-')
      .filter(Boolean)
      .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
      .join(' ');
  } catch {
    return '';
  }
}

const cleanAsin = extractAsin(url, asin);
const baseHref = url || (cleanAsin ? `https://www.amazon.com/dp/${encodeURIComponent(cleanAsin)}` : 'https://www.amazon.com');
const href = normalizeAmazonUrl(baseHref);
const displayTitle = title === 'Amazon product'
  ? titleFromUrl(url) || (cleanAsin ? `Amazon product ${cleanAsin}` : title)
  : title;
const cardId = `amazon-card-${cleanAsin || Math.random().toString(36).slice(2)}`;
---

<aside
  id={cardId}
  class="amazon-card relative my-8 border border-white/15 bg-black p-4 sm:p-5"
  data-asin={cleanAsin}
  data-url={href}
  data-certified={certified ? 'true' : 'false'}
>
  {certified && (
    // Floats top-right of the card. Red pill matches our accent palette;
    // the checkmark + "GARAGE CERTIFIED" reads at a glance even at small
    // sizes. The card content uses pr-32 on the right column so the
    // badge doesn't overlap the title text on narrow widths.
    <span class="absolute top-2 right-2 inline-flex items-center gap-1 px-2 py-1 bg-[#dc2626] text-white text-[9px] font-bold uppercase tracking-widest">
      ✓ Garage Certified
    </span>
  )}

  <div class="flex gap-4">
    <div class="shrink-0">
      {image ? (
        <img src={image} alt={displayTitle} loading="lazy"
          class="size-24 sm:size-28 object-cover border border-white/10 bg-white/5" />
      ) : (
        <div aria-hidden="true" class="flex size-24 sm:size-28 items-center justify-center border border-white/10 bg-white/5 text-white/35 text-2xl">
          ▣
        </div>
      )}
    </div>

    <div class:list={["min-w-0", certified && "pr-28 sm:pr-32"]}>
      <div class="flex items-center gap-2 mb-2 flex-wrap">
        <p class="text-white/40 text-xs uppercase tracking-widest">{eyebrow}</p>
        {priceRange && (
          // Historical / typical price band — NOT the current Amazon price.
          // Rendered as a low-saturation outlined pill so it reads as
          // "we've seen this go for" rather than a hard quote.
          <span class="inline-flex items-center px-1.5 py-0.5 border border-white/20 text-white/60 text-[9px] uppercase tracking-widest">
            Usually {priceRange}
          </span>
        )}
      </div>
      <h3 class="text-white text-xl leading-7 mb-2">{displayTitle}</h3>
      {description && <p class="text-gray-400 text-base sm:text-sm leading-7 mb-4">{description}</p>}

      <div class="flex flex-wrap items-center gap-3">
        <a href={href} target="_blank" rel="nofollow sponsored noopener" class="amazon-card-cta inline-flex h-11 items-center justify-center bg-[#dc2626] px-4 text-white text-sm font-medium no-underline hover:bg-[#ef4444] transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#dc2626]">
          {cta}
        </a>
        <span class="text-white/30 text-xs">Amazon link</span>
      </div>
      <p class="mt-3 text-white/30 text-xs">Product details may change on Amazon.</p>
    </div>
  </div>
</aside>

<style>
  .amazon-card-cta,
  .amazon-card-cta:hover {
    color: #fff;
    text-decoration: none;
  }
</style>
