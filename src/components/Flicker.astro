---
interface Props {
  dark?: string;
  light?: string;
}
const { dark = '/images/bg-manchester-01-dark.webp', light = '/images/bg-manchester-01.webp' } = Astro.props;
---

<div id="flicker-wrap" class="absolute inset-0 overflow-hidden">
  <img id="bg-dark" src={dark} alt="" class="w-full h-full block relative z-10 object-cover" />
  <img id="bg-light" src={light} alt="" class="absolute inset-0 w-full h-full block z-10 object-cover transition-opacity duration-150" />
  <img id="bg-dark-fade" src="" alt="" class="absolute inset-0 w-full h-full block z-10 object-cover pointer-events-none opacity-0" style="transition: opacity 500ms ease;" />
  <img id="bg-light-fade" src="" alt="" class="absolute inset-0 w-full h-full block z-10 object-cover pointer-events-none opacity-0" style="transition: opacity 500ms ease;" />
  <slot />
</div>

<script>
  const wrap = document.getElementById('flicker-wrap');
  const dark = document.getElementById('bg-dark');
  const light = document.getElementById('bg-light');

  // --- Compute where image pixels land on screen (cover math) ---
  function positionOverlays() {
    const vw = wrap.clientWidth;
    const vh = wrap.clientHeight;
    const nw = dark.naturalWidth;
    const nh = dark.naturalHeight;
    if (!nw || !nh || !vw || !vh) return;

    const scale = Math.max(vw / nw, vh / nh);
    const offX = (vw - nw * scale) / 2;
    const offY = (vh - nh * scale) / 2;

    wrap.dispatchEvent(new CustomEvent('scene-sized', {
      detail: { scale, offX, offY, imgW: nw, imgH: nh },
      bubbles: true
    }));
  }

  // --- Flicker animation ---
  let ready = 0;
  function startFlicker() {
    let t = 0;
    function tick() {
      t += 0.002 + Math.random() * 0.003;
      const v = 0.5
        + 0.35 * Math.sin(t * 1.0)
        + 0.25 * Math.sin(t * 2.7 + 1.3)
        + 0.15 * Math.sin(t * 5.1 + 0.7);
      light.style.opacity = String(Math.max(0, Math.min(1, v)));
      requestAnimationFrame(tick);
    }
    tick();
  }

  function onImageReady() {
    ready++;
    if (ready >= 2) {
      startFlicker();
      positionOverlays();
    }
  }

  [dark, light].forEach(img => {
    if (img.complete && img.naturalWidth) onImageReady();
    else img.addEventListener('load', onImageReady, { once: true });
  });

  // ResizeObserver catches ALL size changes: viewport, fullscreen, orientation, browser bar
  new ResizeObserver(positionOverlays).observe(wrap);

  // Re-position on dark image load (for garage switching)
  dark.addEventListener('load', positionOverlays);
</script>
