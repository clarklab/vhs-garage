---
import { findPlace, buildMapsUrl } from '../data/places.js';

interface Props {
  slug?: string;
  name?: string;
  eyebrow?: string;
  description?: string;
  image?: string;
  certified?: boolean;
  address?: string;
  city?: string;
  mapsUrl?: string;   // explicit override; otherwise auto-built from name+address
  website?: string;   // optional secondary CTA
}

// Like AmazonCard, lookup by `slug` against src/data/places.js when the
// slug matches — title / description / image / certified / address /
// website all flow from the data file. Inline props always override.
const lookup = findPlace(Astro.props.slug);

const {
  slug      = lookup?.slug,
  name      = lookup?.name || 'Place',
  eyebrow   = lookup?.eyebrow || 'Place',
  description = lookup?.description,
  image     = lookup?.image,
  certified = lookup?.certified ?? false,
  address   = lookup?.address,
  city      = lookup?.city,
  mapsUrl,                                    // resolved below
  website   = lookup?.website,
} = Astro.props;

// Resolve maps URL: prefer explicit, then the lookup's, then auto-build.
const resolvedMapsUrl = mapsUrl
  || lookup?.mapsUrl
  || buildMapsUrl({ name, address, city });

const cardId = `place-card-${slug || Math.random().toString(36).slice(2)}`;
---

<aside
  id={cardId}
  class="place-card my-8 border border-white/15 bg-black p-4 sm:p-5"
  data-slug={slug}
>
  <div class="flex gap-4 items-stretch">
    <div class="shrink-0 self-stretch">
      {image ? (
        <img src={image} alt={name} loading="lazy"
          class="place-card-img w-32 sm:w-36 h-full object-cover border border-white/10 bg-white/5" />
      ) : (
        <div aria-hidden="true" class="flex w-32 sm:w-36 h-full items-center justify-center border border-white/10 bg-white/5 text-white/35 text-2xl">
          ▣
        </div>
      )}
    </div>

    <div class="min-w-0 flex-1 flex flex-col justify-center">
      {certified && (
        <span class="place-card-pill inline-flex items-center self-start gap-1 px-2 py-0.5 bg-[#dc2626] text-white text-[9px] font-bold uppercase tracking-widest">
          ✓ Garage Certified
        </span>
      )}
      <h3 class="place-card-name text-white text-xl">{name}</h3>

      {(address || city) && (
        <p class="place-card-addr text-white/40 text-xs">
          {address}{address && city && ' · '}{city}
        </p>
      )}

      <div class="place-card-actions flex flex-wrap items-center gap-2">
        <a href={resolvedMapsUrl} target="_blank" rel="noopener" class="place-card-cta inline-flex h-10 items-center justify-center gap-1.5 bg-[#dc2626] px-3 text-white text-sm font-medium no-underline hover:bg-[#ef4444] transition-colors">
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
            <path d="m19,6v-2h-1v-1h-1v-1h-2v-1h-6v1h-2v1h-1v1h-1v2h-1v6h1v2h1v1h1v2h1v1h1v2h1v1h1v2h2v-2h1v-1h1v-2h1v-1h1v-2h1v-1h1v-2h1v-6h-1Zm-5,5h-1v1h-2v-1h-1v-1h-1v-2h1v-1h1v-1h2v1h1v1h1v2h-1v1Z"/>
          </svg>
          Find on Maps
        </a>
        {website && (
          <a href={website} target="_blank" rel="noopener" class="place-card-cta-secondary inline-flex h-10 items-center justify-center gap-1.5 border border-white/30 bg-transparent px-3 text-white text-sm font-medium no-underline hover:border-white hover:bg-white/5 transition-colors">
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <rect x="9" y="1" width="1" height="1"/>
              <polygon points="9 2 9 3 8 3 8 5 7 5 7 8 2 8 2 7 3 7 3 5 4 5 4 4 5 4 5 3 7 3 7 2 9 2"/>
              <polygon points="13 2 14 2 14 4 15 4 15 6 16 6 16 8 8 8 8 6 9 6 9 4 10 4 10 2 11 2 11 1 13 1 13 2"/>
              <rect x="14" y="1" width="1" height="1"/>
              <polygon points="22 7 22 8 17 8 17 5 16 5 16 3 15 3 15 2 17 2 17 3 19 3 19 4 20 4 20 5 21 5 21 7 22 7"/>
              <polygon points="17 10 17 14 16 14 16 15 8 15 8 14 7 14 7 10 8 10 8 9 16 9 16 10 17 10"/>
              <polygon points="1 9 7 9 7 10 6 10 6 14 7 14 7 15 1 15 1 9"/>
              <polygon points="23 9 23 15 17 15 17 14 18 14 18 10 17 10 17 9 23 9"/>
              <polygon points="22 16 22 17 21 17 21 19 20 19 20 20 19 20 19 21 17 21 17 22 15 22 15 21 16 21 16 19 17 19 17 16 22 16"/>
              <rect x="9" y="22" width="1" height="1"/>
              <polygon points="9 21 9 22 7 22 7 21 5 21 5 20 4 20 4 19 3 19 3 17 2 17 2 16 7 16 7 19 8 19 8 21 9 21"/>
              <rect x="14" y="22" width="1" height="1"/>
              <polygon points="14 22 13 22 13 23 11 23 11 22 10 22 10 20 9 20 9 18 8 18 8 16 16 16 16 18 15 18 15 20 14 20 14 22"/>
            </svg>
            Website
          </a>
        )}
      </div>
    </div>
  </div>
</aside>

<style is:global>
  /* The PlaceCard often appears INSIDE .vhs-prose (blog post bodies),
     where rules like `.vhs-prose h3 { margin-top: 2rem }` and
     `.vhs-prose > * + * { margin-top: 1.25rem }` injected huge gaps
     between elements inside the card. Reset every margin inside a
     .place-card here so the layout is consistent on /places (no prose
     wrapper) and inside posts (prose wrapper). is:global so the
     selectors aren't Astro-scoped (the prose rules they're fighting
     are global too — same specificity battle, last-rule-wins). */
  .place-card,
  .place-card * {
    margin: 0;
  }
  /* Per-element spacing — explicit so prose can't override it. */
  .place-card-pill {
    margin-bottom: 0.5rem;
  }
  .place-card-name {
    line-height: 1.2;
    margin-bottom: 0.25rem;
  }
  .place-card-addr {
    margin-bottom: 0.875rem;
  }
  /* Image fills the height of the content column so the card has no
     dead space above or below the photo regardless of how much text
     sits to its right. */
  .place-card-img {
    display: block;
    min-height: 100%;
  }

  /* Bumped from .place-card-cta to a.place-card-cta so the selector
     specificity (0,1,1) ties or beats `.vhs-prose a` (0,1,1) and wins
     on cascade order — Astro injects component styles after global.css.
     Without this, prose's `.vhs-prose a { color: #dc2626 }` made the
     button text + the fill-current icon red-on-red (invisible against
     the red bg) and the underline rule snuck back in. */
  a.place-card-cta,
  a.place-card-cta:hover,
  a.place-card-cta-secondary,
  a.place-card-cta-secondary:hover {
    color: #fff;
    text-decoration: none;
  }
</style>
