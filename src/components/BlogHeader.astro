---
// Fixed top-bar header for the blog. Mirrors the capture page's
// "old OS" toolbar feel: brand on the left, drop-down menus
// (Open / Categories), live search on the right. Mobile collapses
// to a hamburger that reveals everything in a panel underneath.
//
// Behavior wiring lives in /public/scripts/blog-header.js (search,
// mobile drawer toggle); the dropdowns themselves use the shared
// /public/scripts/toolbar-menu.js (also used by the capture page's
// per-segment menus). Toolbar-menu CSS lives in src/styles/global.css.
//
// Pages that mount this header should add `pt-10` to their first
// content section so the page body doesn't slide under the fixed bar.
---

<header
  id="blog-header"
  class="fixed top-0 left-0 right-0 z-50 flex items-stretch text-[10px] text-white/60 border-b border-white/20 bg-[#141214] select-none"
  style="font-family: 'VCR', monospace; box-shadow: 0 1px 0 rgba(255,255,255,0.04);"
>
  <!-- Brand — also a link back to /blog -->
  <a href="/blog" class="flex items-center gap-2 px-3 py-2 border-r border-white/15 shrink-0 hover:text-white/80 transition-colors">
    <span class="inline-block w-1.5 h-1.5 bg-red-500" style="box-shadow: 0 0 6px rgba(229,57,53,0.6);"></span>
    <span class="text-white/85 font-bold tracking-[0.15em] uppercase">VHS Garage Blog</span>
  </a>

  <!-- Desktop menu items -->
  <button id="bh-open-trigger"   data-toolbar-trigger
          class="toolbar-trigger hidden md:flex items-center gap-1.5 px-3 py-2 border-r border-white/10 hover:text-white/80 transition-colors">
    <span class="uppercase tracking-wider">Open</span>
    <span class="text-white/30 text-[8px]" aria-hidden="true">▾</span>
  </button>
  <button id="bh-cat-trigger"    data-toolbar-trigger
          class="toolbar-trigger hidden md:flex items-center gap-1.5 px-3 py-2 border-r border-white/10 hover:text-white/80 transition-colors">
    <span class="uppercase tracking-wider">Categories</span>
    <span class="text-white/30 text-[8px]" aria-hidden="true">▾</span>
  </button>

  <span class="flex-1"></span>

  <!-- Search input — desktop. Magnifying-glass prefix, ⌘K hint suffix.
       The dropdown of results is rendered into #bh-search-results
       (a sibling absolute element) by blog-header.js. -->
  <div class="relative hidden md:flex items-center px-2 border-l border-white/10">
    <svg class="w-3 h-3 text-white/30 mr-1.5 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M15.5 14h-.79l-.28-.27A6.5 6.5 0 105.5 16.5a6.47 6.47 0 004.23-1.57l.27.28v.79l5 5L16.5 19l-5-5zm-6 0A4.5 4.5 0 119.5 5a4.5 4.5 0 010 9z"/>
    </svg>
    <input
      id="bh-search-input"
      type="text"
      placeholder="Search the blog…"
      autocomplete="off"
      spellcheck="false"
      class="w-56 bg-transparent border-0 text-white/85 text-[11px] placeholder-white/30 focus:outline-none py-2"
    />
    <kbd class="ml-2 text-[8px] text-white/30 border border-white/15 px-1 py-0.5 uppercase tracking-wider hidden lg:inline-block">⌘K</kbd>
  </div>

  <!-- Mobile hamburger — opens the inline drawer below the bar -->
  <button id="bh-mobile-toggle"
          class="md:hidden flex items-center justify-center px-3 py-2 text-white/70 hover:text-white border-l border-white/15"
          aria-label="Open menu" aria-expanded="false">
    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M3 6h18v2H3zm0 5h18v2H3zm0 5h18v2H3z"/>
    </svg>
  </button>
</header>

<!-- Mobile drawer — appears under the fixed bar when hamburger is tapped.
     Stacks Open + Categories (as plain links since dropdowns inside a
     mobile drawer feel weird) and a full-width search input. -->
<div id="bh-mobile-drawer"
     class="hidden md:hidden fixed top-10 left-0 right-0 z-40 bg-[#141214] border-b border-white/20 px-3 py-3 space-y-2"
     style="font-family: 'VCR', monospace;">
  <!-- Search input — mobile -->
  <div class="flex items-center gap-2 px-2 py-2 border border-white/15">
    <svg class="w-3 h-3 text-white/40 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M15.5 14h-.79l-.28-.27A6.5 6.5 0 105.5 16.5a6.47 6.47 0 004.23-1.57l.27.28v.79l5 5L16.5 19l-5-5zm-6 0A4.5 4.5 0 119.5 5a4.5 4.5 0 010 9z"/>
    </svg>
    <input
      id="bh-search-input-mobile"
      type="text"
      placeholder="Search the blog…"
      autocomplete="off"
      spellcheck="false"
      class="flex-1 bg-transparent border-0 text-white/85 text-xs placeholder-white/30 focus:outline-none"
    />
  </div>

  <!-- "Open" group — flat list since we don't want nested dropdowns -->
  <div class="border border-white/15 divide-y divide-white/10">
    <p class="px-3 py-1.5 text-[9px] uppercase tracking-widest text-white/30">Open</p>
    <a href="/blog"        class="block px-3 py-2 text-white/80 hover:bg-red-600 hover:text-white text-xs uppercase tracking-wider transition-colors">All Posts</a>
    <a href="/gear"        class="block px-3 py-2 text-white/80 hover:bg-red-600 hover:text-white text-xs uppercase tracking-wider transition-colors">VHS Garage Gear</a>
    <a href="/blog/videos" class="block px-3 py-2 text-white/80 hover:bg-red-600 hover:text-white text-xs uppercase tracking-wider transition-colors">Videos</a>
  </div>

  <div class="border border-white/15 divide-y divide-white/10">
    <p class="px-3 py-1.5 text-[9px] uppercase tracking-widest text-white/30">Categories</p>
    <a href="/blog/category/tapes"       class="block px-3 py-2 text-white/80 hover:bg-red-600 hover:text-white text-xs uppercase tracking-wider transition-colors">Tapes</a>
    <a href="/blog/category/hardware"    class="block px-3 py-2 text-white/80 hover:bg-red-600 hover:text-white text-xs uppercase tracking-wider transition-colors">Hardware</a>
    <a href="/blog/category/guides"      class="block px-3 py-2 text-white/80 hover:bg-red-600 hover:text-white text-xs uppercase tracking-wider transition-colors">Guides</a>
    <a href="/blog/category/collections" class="block px-3 py-2 text-white/80 hover:bg-red-600 hover:text-white text-xs uppercase tracking-wider transition-colors">Collections</a>
  </div>
</div>

<!-- Search results dropdown — fixed, anchored under the desktop search
     input. Populated by blog-header.js as the user types. Hidden when
     query is empty or no input is focused. -->
<div id="bh-search-results"
     class="hidden fixed z-[60] bg-[#1a181a] border border-white/25 max-h-[60vh] overflow-y-auto"
     style="font-family: 'VCR', monospace; min-width: 320px; box-shadow: 4px 4px 0 0 rgba(0,0,0,0.6);">
</div>

<!-- Shared toolbar menu host (created automatically by toolbar-menu.js
     if absent, but we drop one here so styling never has a moment
     without it). -->
<div id="toolbar-menu" class="toolbar-menu hidden"></div>

<style>
  /* Spacer for fixed-header pages: any page mounting BlogHeader gets
     a body padding so content doesn't slide under the 40px-tall bar.
     We do this from the component (not the consumer page) so adding
     the header to a new page is a one-liner. */
  body { padding-top: 40px; }
</style>

<script src="/scripts/toolbar-menu.js" is:inline></script>
<script type="module" src="/scripts/blog-header.js"></script>
